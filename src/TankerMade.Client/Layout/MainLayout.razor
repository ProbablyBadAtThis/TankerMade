@inherits LayoutComponentBase
@inject AuthSession AuthSession
@inject ClientModuleState ModuleState
@inject CoreRecentModule CoreRecentModule
@inject NavigationManager Navigation
@implements IDisposable

<MudLayout Class="@GetLayoutClass()">
    <MudMainContent Class="notebook-main-content">
        <div class="notebook-page">
            @Body
        </div>
    </MudMainContent>

    @if (AuthSession.IsSignedIn && _showBottomNav)
    {
        <AppBottomNav />
    }
</MudLayout>

@code {
    private bool _showBottomNav;

    protected override async Task OnInitializedAsync()
    {
        AuthSession.Changed += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await AuthSession.InitializeAsync();

        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
            await RecordModuleVisitFromUriAsync(Navigation.Uri);
        }

        RefreshBottomNavVisibility();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        RefreshBottomNavVisibility();
        _ = RecordModuleVisitFromUriAsync(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void RefreshBottomNavVisibility()
    {
        var scope = AppNavigation.GetScope(Navigation.ToBaseRelativePath(Navigation.Uri));
        _showBottomNav = scope is AppNavigationScope.Core or AppNavigationScope.Knitting;
    }

    private string GetLayoutClass()
        => _showBottomNav ? "notebook-layout has-bottom-nav" : "notebook-layout";

    private async Task RecordModuleVisitFromUriAsync(string uri)
    {
        if (!AuthSession.IsSignedIn)
        {
            return;
        }

        var relativePath = Navigation.ToBaseRelativePath(uri).TrimEnd('/');
        if (!relativePath.StartsWith("modules/", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var segments = relativePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length < 2)
        {
            return;
        }

        await CoreRecentModule.RecordModuleVisitAsync(segments[1]);
    }

    public void Dispose()
    {
        AuthSession.Changed -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
