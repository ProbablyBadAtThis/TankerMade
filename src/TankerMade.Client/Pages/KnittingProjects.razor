@page "/modules/knitting/projects"
@using TankerMade.Contracts.DTOs.ModulePatterns
@using TankerMade.Contracts.DTOs.ModuleProjects
@using TankerMade.Contracts.DTOs.Reference
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession
@inject TankerMade.Client.Services.TankerMadeApiClient ApiClient
@inject TankerMade.Client.Services.KnittingCardAssetCache CardAssets
@inject TankerMade.Client.Services.KnittingRecentActivity RecentActivity

<PageTitle>Knitting Projects</PageTitle>

<KnittingModuleGate Loading="loading" LoadingMessage="Loading projects...">
    <MudStack Spacing="3">
        <KnittingPageHeader Title="Projects"
                            Subtitle="Module-owned knitting projects via core extension-point APIs." />

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/knitting/projects/new">
            New Project Wizard
        </MudButton>

        <MudPaper Class="pa-4 knitting-panel-mud" Elevation="1">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1">Quick Create</MudText>
                <EditForm Model="form" OnValidSubmit="CreateProjectAsync">
                    <DataAnnotationsValidator />
                    <MudStack Spacing="2">
                        <div class="knitting-list-toolbar-mud">
                            <MudTextField @bind-Value="form.Name" Label="Name" Variant="Variant.Outlined" Required="true" />
                            <MudTextField @bind-Value="form.Description" Label="Description" Variant="Variant.Outlined" />
                            <MudSelect T="int" @bind-Value="form.Difficulty" Label="Difficulty" Variant="Variant.Outlined">
                                <MudSelectItem T="int" Value="0">Unspecified</MudSelectItem>
                                <MudSelectItem T="int" Value="1">Beginner</MudSelectItem>
                                <MudSelectItem T="int" Value="2">Beginner+</MudSelectItem>
                                <MudSelectItem T="int" Value="3">Intermediate</MudSelectItem>
                                <MudSelectItem T="int" Value="4">Intermediate+</MudSelectItem>
                                <MudSelectItem T="int" Value="5">Advanced</MudSelectItem>
                                <MudSelectItem T="int" Value="6">Advanced+</MudSelectItem>
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="form.PatternIdText" Label="Pattern" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@string.Empty">No pattern linked</MudSelectItem>
                                @foreach (var pattern in patterns)
                                {
                                    <MudSelectItem T="string" Value="@pattern.Id.ToString()">@pattern.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="form.ColorIdText" Label="Main color" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@string.Empty">None</MudSelectItem>
                                @foreach (var color in colors)
                                {
                                    <MudSelectItem T="string" Value="@color.Id.ToString()">@color.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="busy">
                            Create Project
                        </MudButton>
                    </MudStack>
                </EditForm>
            </MudStack>
        </MudPaper>

        <div class="knitting-list-toolbar-mud">
            <MudTextField @bind-Value="search"
                          @bind-Value:after="ApplyFiltersAsync"
                          Label="Search"
                          Variant="Variant.Outlined"
                          Placeholder="Filter as you type"
                          Immediate="true" />
            <MudSelect T="string" @bind-Value="sortBy" @bind-Value:after="ApplyFiltersAsync" Label="Sort" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@("recent")">Most recent</MudSelectItem>
                <MudSelectItem T="string" Value="@("lastopened")">Last opened</MudSelectItem>
                <MudSelectItem T="string" Value="@("name")">Name</MudSelectItem>
                <MudSelectItem T="string" Value="@("progress")">Progress</MudSelectItem>
                <MudSelectItem T="string" Value="@("difficulty")">Difficulty</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" @bind-Value="filterThemeId" @bind-Value:after="ApplyFiltersAsync" Label="Theme" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@string.Empty">All themes</MudSelectItem>
                @foreach (var theme in themes)
                {
                    <MudSelectItem T="string" Value="@theme.Id.ToString()">@theme.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="filterColorId" @bind-Value:after="ApplyFiltersAsync" Label="Color" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@string.Empty">All colors</MudSelectItem>
                @foreach (var color in colors)
                {
                    <MudSelectItem T="string" Value="@color.Id.ToString()">@color.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="filterDifficulty" @bind-Value:after="ApplyFiltersAsync" Label="Difficulty" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@string.Empty">All</MudSelectItem>
                <MudSelectItem T="string" Value="@("1")">Beginner</MudSelectItem>
                <MudSelectItem T="string" Value="@("2")">Beginner+</MudSelectItem>
                <MudSelectItem T="string" Value="@("3")">Intermediate</MudSelectItem>
                <MudSelectItem T="string" Value="@("4")">Intermediate+</MudSelectItem>
                <MudSelectItem T="string" Value="@("5")">Advanced</MudSelectItem>
                <MudSelectItem T="string" Value="@("6")">Advanced+</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" @bind-Value="filterCompletion" @bind-Value:after="ApplyFiltersAsync" Label="Completion" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@string.Empty">All</MudSelectItem>
                <MudSelectItem T="string" Value="@("active")">In progress</MudSelectItem>
                <MudSelectItem T="string" Value="@("complete")">100% complete</MudSelectItem>
            </MudSelect>
            <MudCheckBox T="bool" Value="showArchived" ValueChanged="@(async (bool v) => await OnShowArchivedChanged(v))" Label="Show archived" Color="Color.Primary" />
        </div>

        @if (pagedProjects.Count == 0 && filteredProjects.Count == 0)
        {
            <MudPaper Class="pa-6 knitting-panel-mud" Elevation="1">
                <MudStack Spacing="1" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">No Projects Yet</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Create your first knitting project to start tracking work.</MudText>
                </MudStack>
            </MudPaper>
        }
        else
        {
            <div class="knitting-card-grid-mud">
                @foreach (var project in pagedProjects)
                {
                    var assetId = projectAssetIds.GetValueOrDefault(project.Id);
                    <MudPaper Class="knitting-card-mud project-card-with-image" Elevation="1">
                        <AssetThumbnailImage AssetId="assetId" AltText="@project.Name" />
                        <div class="pa-3 knitting-card-mud-body">
                            <MudText Typo="Typo.h6">@project.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@project.Description</MudText>
                            @if (project.IsArchived)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">Archived</MudChip>
                            }
                            <div class="pattern-card-stats">
                                <KnittingDifficultyBadge Difficulty="project.Difficulty" />
                                <span>@project.Progress%</span>
                                <span>@(project.TotalStitchCount > 0 ? $"{project.CompletedStitchCount}/{project.TotalStitchCount} stitches" : $"{project.CompletedStepCount}/{project.TotalStepCount} steps")</span>
                                <span>@(string.IsNullOrWhiteSpace(project.ThemeName) ? "No theme" : project.ThemeName)</span>
                                <span>@(string.IsNullOrWhiteSpace(project.ColorName) ? "No color" : project.ColorName)</span>
                                <span>@(string.IsNullOrWhiteSpace(project.PatternName) ? "No pattern" : project.PatternName)</span>
                            </div>
                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="knitting-card-mud-actions">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Href="@($"/modules/knitting/projects/{project.Id}")">Open</MudButton>
                                @if (project.IsArchived)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Disabled="busy" OnClick="@(() => ReopenProjectAsync(project.Id))">Reopen</MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="busy" OnClick="@(() => ArchiveProjectAsync(project.Id))">Archive</MudButton>
                                }
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="busy" OnClick="@(() => DeleteProjectAsync(project.Id))">Delete</MudButton>
                            </MudStack>
                        </div>
                    </MudPaper>
                }
            </div>
            @if (filteredProjects.Count > projectPageSize)
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudButton Variant="Variant.Outlined" Disabled="@(projectPage <= 1 || busy)" OnClick="PreviousProjectPage">Previous</MudButton>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Page @projectPage of @ProjectPageCount</MudText>
                    <MudButton Variant="Variant.Outlined" Disabled="@(projectPage >= ProjectPageCount || busy)" OnClick="NextProjectPage">Next</MudButton>
                </MudStack>
            }
        }
    </MudStack>
</KnittingModuleGate>

@code {
    private const string ModuleKey = "knitting";
    private const int projectPageSize = 12;
    private const string ProjectsShowArchivedByDefaultKey = "projects.showArchivedByDefault";
    private const string WorkspaceDefaultProjectDifficultyKey = "workspace.defaultProjectDifficulty";
    private readonly List<ModuleProjectDto> projects = [];
    private readonly List<ModuleProjectDto> filteredProjects = [];
    private readonly List<ModuleProjectDto> pagedProjects = [];
    private readonly Dictionary<Guid, Guid?> projectAssetIds = [];
    private readonly List<ModulePatternDto> patterns = [];
    private readonly List<CoreReferenceItemDto> themes = [];
    private readonly List<CoreReferenceItemDto> colors = [];
    private string search = string.Empty;
    private string sortBy = "recent";
    private string filterThemeId = string.Empty;
    private string filterColorId = string.Empty;
    private string filterDifficulty = string.Empty;
    private string filterCompletion = string.Empty;
    private int projectPage = 1;
    private Guid? lastOpenedProjectId;
    private DateTime? lastOpenedAt;
    private ProjectFormModel form = new();
    private bool showArchived;
    private bool loading = true;
    private bool settingsInitialized;
    private bool busy;
    private string errorMessage = string.Empty;

    [SupplyParameterFromQuery(Name = "archived")]
    public bool? ArchivedQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.InitializeAsync();
        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
        }

        if (ArchivedQuery == true)
        {
            showArchived = true;
        }

        await LoadProjectsAsync();
    }

    private async Task OnShowArchivedChanged(bool value)
    {
        showArchived = value;
        await LoadProjectsAsync();
    }

    private async Task LoadProjectsAsync()
    {
        loading = true;
        errorMessage = string.Empty;

        try
        {
            if (!AuthSession.IsSignedIn || !ModuleState.IsActive(ModuleKey))
            {
                return;
            }

            if (!settingsInitialized)
            {
                var settings = await ApiClient.GetModuleSettingsAsync(ModuleKey);
                showArchived = GetBoolSetting(settings, ProjectsShowArchivedByDefaultKey, showArchived);
                form.Difficulty = GetIntSetting(settings, WorkspaceDefaultProjectDifficultyKey, form.Difficulty);
                settingsInitialized = true;
            }

            themes.Clear();
            themes.AddRange(await ApiClient.GetCoreReferenceItemsAsync("themes"));
            colors.Clear();
            colors.AddRange(await ApiClient.GetCoreReferenceItemsAsync("colors"));
            patterns.Clear();
            patterns.AddRange(await ApiClient.GetModulePatternsAsync(ModuleKey));
            lastOpenedProjectId = await RecentActivity.GetRecentProjectIdAsync();
            lastOpenedAt = await RecentActivity.GetRecentProjectOpenedAtAsync();
            projects.Clear();
            var source = await ApiClient.GetModuleProjectsAsync(ModuleKey, showArchived);
            if (!showArchived)
            {
                source = source.Where(project => !project.IsArchived).ToList();
            }

            projects.AddRange(source);
            CardAssets.InvalidateAll();
            projectAssetIds.Clear();
            var assets = await CardAssets.GetAssetsAsync(ModuleKey, "project");
            foreach (var project in projects)
            {
                projectAssetIds[project.Id] = assets.FirstOrDefault(asset => asset.RecordId == project.Id)?.Id;
            }

            ApplyFilters();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private Task ApplyFiltersAsync()
    {
        ApplyFilters();
        return Task.CompletedTask;
    }

    private int ProjectPageCount => filteredProjects.Count == 0
        ? 1
        : (int)Math.Ceiling(filteredProjects.Count / (double)projectPageSize);

    private void ApplyPaging()
    {
        pagedProjects.Clear();
        var skip = (projectPage - 1) * projectPageSize;
        pagedProjects.AddRange(filteredProjects.Skip(skip).Take(projectPageSize));
    }

    private void PreviousProjectPage()
    {
        if (projectPage > 1)
        {
            projectPage--;
            ApplyPaging();
        }
    }

    private void NextProjectPage()
    {
        if (projectPage < ProjectPageCount)
        {
            projectPage++;
            ApplyPaging();
        }
    }

    private void ApplyFilters()
    {
        projectPage = 1;
        filteredProjects.Clear();
        IEnumerable<ModuleProjectDto> query = projects;

        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(project =>
                project.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                || project.Description.Contains(search, StringComparison.OrdinalIgnoreCase)
                || project.PatternName.Contains(search, StringComparison.OrdinalIgnoreCase)
                || project.ThemeName.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        if (Guid.TryParse(filterThemeId, out var themeId))
        {
            query = query.Where(project => project.ThemeId == themeId);
        }

        if (Guid.TryParse(filterColorId, out var colorId))
        {
            query = query.Where(project => project.ColorId == colorId);
        }

        if (int.TryParse(filterDifficulty, out var difficulty) && difficulty > 0)
        {
            query = query.Where(project => project.Difficulty == difficulty);
        }

        query = filterCompletion switch
        {
            "active" => query.Where(project => project.Progress < 100),
            "complete" => query.Where(project => project.Progress >= 100),
            _ => query
        };

        query = sortBy switch
        {
            "name" => query.OrderBy(project => project.Name),
            "progress" => query.OrderByDescending(project => project.Progress),
            "difficulty" => query.OrderByDescending(project => project.Difficulty),
            "lastopened" => query
                .OrderByDescending(project => lastOpenedProjectId.HasValue && project.Id == lastOpenedProjectId.Value)
                .ThenByDescending(project => lastOpenedProjectId.HasValue && project.Id == lastOpenedProjectId.Value
                    ? lastOpenedAt ?? project.UpdatedAt
                    : project.UpdatedAt),
            _ => query.OrderByDescending(project => project.UpdatedAt)
        };

        filteredProjects.AddRange(query);
        ApplyPaging();
    }

    private async Task CreateProjectAsync()
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.CreateModuleProjectAsync(ModuleKey, new CreateModuleProjectRequest
            {
                Name = form.Name,
                Description = form.Description,
                Difficulty = form.Difficulty,
                PatternId = Guid.TryParse(form.PatternIdText, out var patternId) ? patternId : null,
                ColorId = Guid.TryParse(form.ColorIdText, out var colorId) ? colorId : null,
                StartedAt = DateTime.UtcNow
            });

            form = new ProjectFormModel();
            await LoadProjectsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ArchiveProjectAsync(Guid id)
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.ArchiveModuleProjectAsync(ModuleKey, id);
            await LoadProjectsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ReopenProjectAsync(Guid id)
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.ReopenModuleProjectAsync(ModuleKey, id);
            await LoadProjectsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteProjectAsync(Guid id)
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.DeleteModuleProjectAsync(ModuleKey, id);
            await LoadProjectsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static bool GetBoolSetting(IReadOnlyList<TankerMade.Contracts.DTOs.ModuleSettings.ModuleSettingItemDto> settings, string key, bool fallback)
    {
        var value = settings.FirstOrDefault(setting => setting.Key.Equals(key, StringComparison.OrdinalIgnoreCase))?.Value;
        return bool.TryParse(value, out var parsed) ? parsed : fallback;
    }

    private static int GetIntSetting(IReadOnlyList<TankerMade.Contracts.DTOs.ModuleSettings.ModuleSettingItemDto> settings, string key, int fallback)
    {
        var value = settings.FirstOrDefault(setting => setting.Key.Equals(key, StringComparison.OrdinalIgnoreCase))?.Value;
        if (!int.TryParse(value, out var parsed))
        {
            return fallback;
        }

        return Math.Clamp(parsed, 0, 6);
    }

    private class ProjectFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Name is required")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Name cannot exceed 200 characters")]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(1000, ErrorMessage = "Description cannot exceed 1000 characters")]
        public string Description { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Range(0, 6, ErrorMessage = "Choose a valid difficulty")]
        public int Difficulty { get; set; }
        public string PatternIdText { get; set; } = string.Empty;
        public string ColorIdText { get; set; } = string.Empty;
    }
}
