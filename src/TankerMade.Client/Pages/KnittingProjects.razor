@page "/modules/knitting/projects"
@using TankerMade.Contracts.DTOs.ModulePatterns
@using TankerMade.Contracts.DTOs.ModuleProjects
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession
@inject TankerMade.Client.Services.TankerMadeApiClient ApiClient

<PageTitle>Knitting Projects</PageTitle>

@if (!sessionReady)
{
    <div class="page-heading">
        <div>
            <a class="pattern-back-link" href="/modules/knitting">Knitting</a>
            <h1>Projects</h1>
            <p>Loading...</p>
        </div>
    </div>
}
else if (!AuthSession.IsSignedIn)
{
    <h1>Knitting Projects</h1>
    <p>Sign in to use this module section.</p>
    <a class="btn btn-primary" href="/login">Sign in</a>
}
else if (!ModuleState.IsActive("knitting"))
{
    <h1>Knitting Projects</h1>
    <p>Activate Knitting from Home to continue.</p>
    <a class="btn btn-outline-primary" href="/">Go to Home</a>
}
else
{
    <div class="page-heading">
        <div>
            <a class="pattern-back-link" href="/modules/knitting">Knitting</a>
            <h1>Projects</h1>
            <p>@(loading ? "Loading..." : "Module-owned knitting projects via core extension-point APIs.")</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <section class="project-panel">
        <h2>New Project</h2>
        <EditForm Model="form" OnValidSubmit="CreateProjectAsync" class="project-edit-form">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                <label>
                    <span>Name</span>
                    <InputText class="form-control" @bind-Value="form.Name" />
                </label>
                <label>
                    <span>Description</span>
                    <InputText class="form-control" @bind-Value="form.Description" />
                </label>
                <label>
                    <span>Difficulty</span>
                    <InputSelect class="form-control" @bind-Value="form.Difficulty">
                        <option value="0">Unspecified</option>
                        <option value="1">Beginner</option>
                        <option value="2">Beginner+</option>
                        <option value="3">Intermediate</option>
                        <option value="4">Intermediate+</option>
                        <option value="5">Advanced</option>
                        <option value="6">Advanced+</option>
                    </InputSelect>
                </label>
                <label>
                    <span>Pattern</span>
                    <InputSelect class="form-control" @bind-Value="form.PatternIdText">
                        <option value="">No pattern linked</option>
                        @foreach (var pattern in patterns)
                        {
                            <option value="@pattern.Id">@pattern.Name</option>
                        }
                    </InputSelect>
                </label>
            </div>
            <button class="btn btn-primary" disabled="@busy" type="submit">Create Project</button>
        </EditForm>
    </section>

    <label class="archive-toggle">
        <input type="checkbox" @bind="showArchived" @bind:after="LoadProjectsAsync" />
        Show archived
    </label>

    @if (projects.Count == 0)
    {
        <div class="empty-state">
            <h2>No Projects Yet</h2>
            <p>Create your first knitting project to start tracking work.</p>
        </div>
    }
    else
    {
        <div class="project-card-grid">
            @foreach (var project in projects)
            {
                <article class="project-card">
                    <div>
                        <h2>@project.Name</h2>
                        <p>@project.Description</p>
                        @if (project.IsArchived)
                        {
                            <span class="archive-badge">Archived</span>
                        }
                    </div>
                    <div class="pattern-card-stats">
                        <span>Difficulty @project.Difficulty</span>
                        <span>@project.Progress%</span>
                        <span>@project.CompletedStepCount/@project.TotalStepCount steps</span>
                        <span>@(string.IsNullOrWhiteSpace(project.PatternName) ? "No pattern" : project.PatternName)</span>
                    </div>
                    <div class="auth-actions">
                        <a class="btn btn-primary btn-sm" href="@($"/modules/knitting/projects/{project.Id}")">Open</a>
                        @if (project.IsArchived)
                        {
                            <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => ReopenProjectAsync(project.Id)">Reopen</button>
                        }
                        else
                        {
                            <button class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => ArchiveProjectAsync(project.Id)">Archive</button>
                        }
                        <button class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => DeleteProjectAsync(project.Id)">Delete</button>
                    </div>
                </article>
            }
        </div>
    }
}

@code {
    private const string ModuleKey = "knitting";
    private const string ProjectsShowArchivedByDefaultKey = "projects.showArchivedByDefault";
    private const string WorkspaceDefaultProjectDifficultyKey = "workspace.defaultProjectDifficulty";
    private readonly List<ModuleProjectDto> projects = [];
    private readonly List<ModulePatternDto> patterns = [];
    private ProjectFormModel form = new();
    private bool showArchived;
    private bool loading = true;
    private bool sessionReady;
    private bool settingsInitialized;
    private bool busy;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.InitializeAsync();
        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
        }

        sessionReady = true;
        await LoadProjectsAsync();
    }

    private async Task LoadProjectsAsync()
    {
        loading = true;
        errorMessage = string.Empty;

        try
        {
            if (!AuthSession.IsSignedIn || !ModuleState.IsActive(ModuleKey))
            {
                return;
            }

            if (!settingsInitialized)
            {
                var settings = await ApiClient.GetModuleSettingsAsync(ModuleKey);
                showArchived = GetBoolSetting(settings, ProjectsShowArchivedByDefaultKey, showArchived);
                form.Difficulty = GetIntSetting(settings, WorkspaceDefaultProjectDifficultyKey, form.Difficulty);
                settingsInitialized = true;
            }

            patterns.Clear();
            patterns.AddRange(await ApiClient.GetModulePatternsAsync(ModuleKey));
            projects.Clear();
            projects.AddRange(await ApiClient.GetModuleProjectsAsync(ModuleKey, showArchived));
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CreateProjectAsync()
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.CreateModuleProjectAsync(ModuleKey, new CreateModuleProjectRequest
            {
                Name = form.Name,
                Description = form.Description,
                Difficulty = form.Difficulty,
                PatternId = Guid.TryParse(form.PatternIdText, out var patternId) ? patternId : null
            });

            form = new ProjectFormModel();
            await LoadProjectsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ArchiveProjectAsync(Guid id)
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.ArchiveModuleProjectAsync(ModuleKey, id);
            await LoadProjectsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ReopenProjectAsync(Guid id)
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.ReopenModuleProjectAsync(ModuleKey, id);
            await LoadProjectsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteProjectAsync(Guid id)
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.DeleteModuleProjectAsync(ModuleKey, id);
            await LoadProjectsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static bool GetBoolSetting(IReadOnlyList<TankerMade.Contracts.DTOs.ModuleSettings.ModuleSettingItemDto> settings, string key, bool fallback)
    {
        var value = settings.FirstOrDefault(setting => setting.Key.Equals(key, StringComparison.OrdinalIgnoreCase))?.Value;
        return bool.TryParse(value, out var parsed) ? parsed : fallback;
    }

    private static int GetIntSetting(IReadOnlyList<TankerMade.Contracts.DTOs.ModuleSettings.ModuleSettingItemDto> settings, string key, int fallback)
    {
        var value = settings.FirstOrDefault(setting => setting.Key.Equals(key, StringComparison.OrdinalIgnoreCase))?.Value;
        if (!int.TryParse(value, out var parsed))
        {
            return fallback;
        }

        return Math.Clamp(parsed, 0, 6);
    }

    private class ProjectFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Name is required")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Name cannot exceed 200 characters")]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(1000, ErrorMessage = "Description cannot exceed 1000 characters")]
        public string Description { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Range(0, 6, ErrorMessage = "Choose a valid difficulty")]
        public int Difficulty { get; set; }
        public string PatternIdText { get; set; } = string.Empty;
    }
}
