@page "/modules/printing-3d/inventory"
@using TankerMade.Contracts.DTOs.ModuleInventory
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession
@inject TankerMade.Client.Services.TankerMadeApiClient ApiClient

<PageTitle>3D Printing Inventory</PageTitle>

@if (!AuthSession.IsSignedIn)
{
    <h1>3D Printing Inventory</h1>
    <p>Sign in to load 3D Printing inventory.</p>
    <a class="btn btn-primary" href="login">Sign in</a>
}
else if (!ModuleState.IsActive("printing-3d"))
{
    <h1>3D Printing Inventory</h1>
    <p>Activate the 3D Printing module from Home to load its inventory.</p>
}
else if (loading)
{
    <h1>3D Printing Inventory</h1>
    <p>Loading...</p>
}
else
{
    <div class="page-heading">
        <div>
            <h1>3D Printing Inventory</h1>
            <p>Module-owned materials workspace via neutral capability APIs.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="printing-search-row">
        <input class="form-control" placeholder="Search materials" @bind="search" @bind:event="oninput" />
        <input class="form-control" placeholder="Material type filter" @bind="category" @bind:event="oninput" />
        <button class="btn btn-outline-secondary" disabled="@busy" @onclick="LoadSuppliesAsync">Search</button>
    </div>

    <div class="printing-layout">
        <section class="printing-panel">
            <h2>Add Material</h2>

            <div class="printing-form-grid">
                <label>
                    <span>Material type</span>
                    <input class="form-control" @bind="form.Category" />
                </label>
                <label>
                    <span>Name</span>
                    <input class="form-control" @bind="form.Name" />
                </label>
                <label>
                    <span>Brand</span>
                    <input class="form-control" @bind="form.Brand" />
                </label>
                <label>
                    <span>Color</span>
                    <input class="form-control" @bind="form.Color" />
                </label>
                <label>
                    <span>Diameter</span>
                    <input class="form-control" @bind="form.Size" />
                </label>
                <label>
                    <span>Remaining grams</span>
                    <input class="form-control" type="number" step="0.01" @bind="form.Quantity" />
                </label>
            </div>

            <label>
                <span>Storage/notes</span>
                <InputTextArea class="form-control" @bind-Value="form.Notes" />
            </label>

            <button class="btn btn-primary" disabled="@busy" @onclick="SaveSupplyAsync">Add / Merge</button>
        </section>

        <section class="printing-panel">
            <h2>Materials</h2>
            @if (supplies.Count == 0)
            {
                <p class="muted-copy">No materials yet.</p>
            }
            else
            {
                <div class="printing-card-grid">
                    @foreach (var item in supplies)
                    {
                        <article class="printing-material-card @(selectedMaterialId == item.Id ? "printing-material-card-active" : string.Empty)">
                            <header>
                                <h3>@item.Category</h3>
                                <p>@item.Brand - @item.Name</p>
                            </header>
                            <div class="pattern-card-stats">
                                <span>@item.Quantity @item.Unit</span>
                                <span>@(string.IsNullOrWhiteSpace(item.Size) ? "No diameter" : item.Size)</span>
                                <span>@(string.IsNullOrWhiteSpace(item.Notes) ? "No storage notes" : item.Notes)</span>
                            </div>
                            <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => SelectMaterialForAssetsAsync(item.Id)">
                                Manage Assets
                            </button>
                        </article>
                    }
                </div>
            }
        </section>
    </div>

    @if (selectedMaterialId.HasValue)
    {
        <section class="printing-panel printing-assets-panel">
            <h2>Material Assets</h2>
            <InputFile OnChange="UploadMaterialAssetAsync" disabled="@busy" />
            <p class="muted-copy">Upload stores the file in 3D Printing assets. Attach to the selected material with one click.</p>

            @if (selectedMaterialAssets.Count == 0)
            {
                <p class="muted-copy">No assets found for the selected material yet.</p>
            }
            else
            {
                <ul class="project-supply-list">
                    @foreach (var asset in selectedMaterialAssets)
                    {
                        <li>
                            <div>
                                <strong>@asset.OriginalFileName</strong>
                                <span>@AssetMeta(asset)</span>
                            </div>
                            @if (asset.RecordId == selectedMaterialId)
                            {
                                <button class="btn btn-outline-danger btn-sm"
                                        disabled="@busy"
                                        @onclick="() => UnassignMaterialAssetAsync(asset.Id)">
                                    Unlink
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-primary btn-sm"
                                        disabled="@busy"
                                        @onclick="() => AssignMaterialAssetAsync(asset.Id)">
                                    Attach
                                </button>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    }
}

@code {
    private const string MaterialRecordType = "material";
    private readonly List<ModuleSupplyItemDto> supplies = [];
    private ModuleSupplyFormModel form = new();
    private string search = string.Empty;
    private string category = string.Empty;
    private string errorMessage = string.Empty;
    private Guid? selectedMaterialId;
    private readonly List<TankerMade.Contracts.DTOs.Assets.AssetRecordDto> selectedMaterialAssets = [];
    private bool loading = true;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.InitializeAsync();
        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
        }

        await LoadSuppliesAsync();
    }

    private async Task LoadSuppliesAsync()
    {
        loading = true;
        errorMessage = string.Empty;

        try
        {
            if (!AuthSession.IsSignedIn || !ModuleState.IsActive("printing-3d"))
            {
                return;
            }

            supplies.Clear();
            supplies.AddRange(await ApiClient.GetModuleSuppliesAsync("printing-3d", search, category));
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveSupplyAsync()
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.CreateModuleSupplyAsync("printing-3d", new CreateModuleSupplyItemRequest
            {
                Category = form.Category,
                Name = form.Name,
                Brand = form.Brand,
                Color = form.Color,
                Size = form.Size,
                Quantity = form.Quantity,
                Unit = "g",
                Notes = form.Notes
            });

            form = new();
            await LoadSuppliesAsync();
            selectedMaterialId = null;
            selectedMaterialAssets.Clear();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SelectMaterialForAssetsAsync(Guid materialId)
    {
        selectedMaterialId = materialId;
        await LoadSelectedMaterialAssetsAsync();
    }

    private async Task LoadSelectedMaterialAssetsAsync()
    {
        if (!selectedMaterialId.HasValue)
        {
            selectedMaterialAssets.Clear();
            return;
        }

        selectedMaterialAssets.Clear();
        selectedMaterialAssets.AddRange(await ApiClient.GetAssetsForPickerAsync(
            "printing-3d",
            MaterialRecordType,
            selectedMaterialId.Value,
            includeUnassigned: true));
    }

    private async Task UploadMaterialAssetAsync(InputFileChangeEventArgs args)
    {
        if (!selectedMaterialId.HasValue || args.FileCount == 0)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;
        try
        {
            await ApiClient.UploadAssetAsync("printing-3d", args.File);
            await LoadSelectedMaterialAssetsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task AssignMaterialAssetAsync(Guid assetId)
    {
        if (!selectedMaterialId.HasValue)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;
        try
        {
            await ApiClient.AssignAssetAsync(assetId, new TankerMade.Contracts.DTOs.Assets.AssetAssignmentRequest
            {
                ModuleKey = "printing-3d",
                RecordType = MaterialRecordType,
                RecordId = selectedMaterialId.Value
            });
            await LoadSelectedMaterialAssetsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task UnassignMaterialAssetAsync(Guid assetId)
    {
        if (!selectedMaterialId.HasValue)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;
        try
        {
            await ApiClient.UnassignAssetAsync(assetId);
            await LoadSelectedMaterialAssetsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static string AssetMeta(TankerMade.Contracts.DTOs.Assets.AssetRecordDto asset)
    {
        var assignment = asset.RecordId.HasValue ? "Attached" : "Unassigned";
        var sizeMb = asset.FileSizeBytes / 1024d / 1024d;
        return $"{assignment} - {asset.ContentType} - {sizeMb:0.##} MB";
    }

    private class ModuleSupplyFormModel
    {
        public string Category { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Brand { get; set; } = string.Empty;
        public string Color { get; set; } = string.Empty;
        public string Size { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
        public string Notes { get; set; } = string.Empty;
    }
}
