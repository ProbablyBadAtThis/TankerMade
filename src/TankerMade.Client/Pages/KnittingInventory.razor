@page "/modules/knitting/inventory"
@using System.Linq
@using TankerMade.Contracts.DTOs.Assets
@using TankerMade.Contracts.DTOs.ModuleInventory
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession
@inject TankerMade.Client.Services.TankerMadeApiClient ApiClient
@inject TankerMade.Client.Services.KnittingCardAssetCache CardAssets
@inject NavigationManager Navigation

<PageTitle>Knitting Inventory</PageTitle>

@if (!AuthSession.IsSignedIn)
{
    <h1>Knitting Inventory</h1>
    <p>Sign in to use this module section.</p>
    <a class="btn btn-primary" href="/login">Sign in</a>
}
else if (!ModuleState.IsActive("knitting"))
{
    <h1>Knitting Inventory</h1>
    <p>Activate Knitting from Home to continue.</p>
    <a class="btn btn-outline-primary" href="/">Go to Home</a>
}
else if (initialLoading)
{
    <h1>Knitting Inventory</h1>
    <p>Loading...</p>
}
else
{
    <div class="knitting-inventory-page page-heading">
        <div>
            <a class="pattern-back-link" href="/modules/knitting">Knitting</a>
            <h1>Inventory</h1>
            <p>Yarn, tools, and notions with lots, purchases, and merge rules.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="d-flex gap-2 flex-wrap mb-3">
        <button class="@TabButtonClass("yarn")" @onclick='() => SetTab("yarn")'>Yarn</button>
        <button class="@TabButtonClass("tools")" @onclick='() => SetTab("tools")'>Tools</button>
        <button class="@TabButtonClass("notions")" @onclick='() => SetTab("notions")'>Notions</button>
    </div>

    <label class="knitting-inventory-search d-block mb-3">
        <span class="form-label">Search</span>
        <input class="form-control"
               placeholder="Filter as you type"
               @bind="search"
               @bind:event="oninput"
               @bind:after="ApplyInventorySearch" />
    </label>

    <div class="list-toolbar mb-3">
        <label>
            <span>Sort</span>
            <select class="form-control" @bind="inventorySortBy" @bind:after="ApplyInventorySearch">
                @if (activeTab == "yarn")
                {
                    <option value="brand">Brand</option>
                    <option value="color">Color</option>
                    <option value="weight">Weight</option>
                    <option value="skeins">Skeins</option>
                }
                else if (activeTab == "tools")
                {
                    <option value="brand">Brand</option>
                    <option value="type">Type</option>
                    <option value="size">Size</option>
                    <option value="quantity">Quantity</option>
                }
                else
                {
                    <option value="brand">Brand</option>
                    <option value="type">Type</option>
                    <option value="size">Size</option>
                    <option value="color">Color</option>
                }
            </select>
        </label>
        <label>
            <span>Brand</span>
            <select class="form-control" @bind="filterBrand" @bind:after="ApplyInventorySearch">
                <option value="">All brands</option>
                @foreach (var brand in brandFilterOptions)
                {
                    <option value="@brand">@brand</option>
                }
            </select>
        </label>
        @if (activeTab == "yarn")
        {
            <label>
                <span>Weight</span>
                <select class="form-control" @bind="filterWeight" @bind:after="ApplyInventorySearch">
                    <option value="">All weights</option>
                    @foreach (var weight in weightFilterOptions)
                    {
                        <option value="@weight">@weight</option>
                    }
                </select>
            </label>
        }
        @if (activeTab == "tools" || activeTab == "notions")
        {
            <label>
                <span>Type</span>
                <select class="form-control" @bind="filterType" @bind:after="ApplyInventorySearch">
                    <option value="">All types</option>
                    @foreach (var type in typeFilterOptions)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </label>
        }
        @if (activeTab == "notions")
        {
            <label>
                <span>Size</span>
                <select class="form-control" @bind="filterSize" @bind:after="ApplyInventorySearch">
                    <option value="">All sizes</option>
                    @foreach (var size in sizeFilterOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </label>
            <label>
                <span>Color</span>
                <select class="form-control" @bind="filterColor" @bind:after="ApplyInventorySearch">
                    <option value="">All colors</option>
                    @foreach (var color in colorFilterOptions)
                    {
                        <option value="@color">@color</option>
                    }
                </select>
            </label>
        }
    </div>

    @if (activeTab == "yarn")
    {
        <div class="d-flex gap-2 flex-wrap mb-3">
            <button class="@FiberFilterButtonClass(string.Empty)" disabled="@busy" @onclick='() => SetFiberFilterAsync(string.Empty)'>All</button>
            <button class="@FiberFilterButtonClass("Synthetic")" disabled="@busy" @onclick='() => SetFiberFilterAsync("Synthetic")'>Synthetic</button>
            <button class="@FiberFilterButtonClass("Natural")" disabled="@busy" @onclick='() => SetFiberFilterAsync("Natural")'>Natural</button>
            <button class="@FiberFilterButtonClass("Blended")" disabled="@busy" @onclick='() => SetFiberFilterAsync("Blended")'>Blended</button>
        </div>

        <div class="row g-4 knitting-inventory-layout">
            <div class="col-12 col-lg-5 col-xl-4">
                <section class="project-panel knitting-inventory-form-panel">
                    <h2>Add Yarn</h2>
                    <p class="muted-copy mb-0">Merge adds to an existing brand + color match.</p>

                    <div class="knitting-inventory-form-section">
                        <h3>Basics</h3>
                        <div class="knitting-inventory-field-grid">
                            <label class="knitting-inventory-field">
                                <span class="form-label">Brand</span>
                                <input class="form-control" @bind="yarnForm.BrandName" />
                            </label>
                            <label class="knitting-inventory-field">
                                <span class="form-label">Color name</span>
                                <input class="form-control" @bind="yarnForm.ColorName" />
                            </label>
                            <label class="knitting-inventory-field knitting-inventory-field-full">
                                <span class="form-label">Main color</span>
                                <input class="form-control" @bind="yarnForm.MainColor" />
                            </label>
                        </div>
                    </div>

                    <div class="knitting-inventory-form-section">
                        <h3>Yarn details</h3>
                        <div class="knitting-inventory-field-grid">
                            <label class="knitting-inventory-field">
                                <span class="form-label">Weight</span>
                                <select class="form-select" @bind="yarnForm.WeightName">
                                    <option value="">Select weight</option>
                                    @foreach (var option in yarnWeightOptions)
                                    {
                                        <option value="@option">@option</option>
                                    }
                                </select>
                            </label>
                            <label class="knitting-inventory-field">
                                <span class="form-label">Fiber tag</span>
                                <select class="form-select" @bind="yarnForm.FiberTag">
                                    <option value="">Select fiber tag</option>
                                    @foreach (var option in fiberTagOptions)
                                    {
                                        <option value="@option">@option</option>
                                    }
                                </select>
                            </label>
                            <div class="knitting-inventory-inline-add">
                                <span class="form-label">New weight option</span>
                                <div class="input-group">
                                    <input class="form-control" placeholder="Add new weight" @bind="newYarnWeightName" />
                                    <button class="btn btn-outline-secondary" disabled="@busy" @onclick="AddYarnWeightOptionAsync">Add</button>
                                </div>
                            </div>
                            <div class="knitting-inventory-inline-add">
                                <span class="form-label">New fiber tag</span>
                                <div class="input-group">
                                    <input class="form-control" placeholder="Add new fiber tag" @bind="newFiberTagName" />
                                    <button class="btn btn-outline-secondary" disabled="@busy" @onclick="AddFiberTagOptionAsync">Add</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="knitting-inventory-form-section">
                        <h3>Purchase</h3>
                        <div class="knitting-inventory-field-grid">
                            <label class="knitting-inventory-field">
                                <span class="form-label">Skeins</span>
                                <input class="form-control" type="number" step="0.01" @bind="yarnForm.Skeins" />
                            </label>
                            <label class="knitting-inventory-field">
                                <span class="form-label">Lot number</span>
                                <input class="form-control" @bind="yarnForm.LotNumber" />
                            </label>
                            <label class="knitting-inventory-field">
                                <span class="form-label">Source</span>
                                <input class="form-control" @bind="yarnForm.SourceName" />
                            </label>
                            <label class="knitting-inventory-field">
                                <span class="form-label">Price</span>
                                <input class="form-control" type="number" step="0.01" @bind="yarnForm.Price" />
                            </label>
                            <label class="knitting-inventory-field knitting-inventory-field-full form-check">
                                <input class="form-check-input" type="checkbox" @bind="yarnForm.IsSalePrice" />
                                <span class="form-check-label">Sale price</span>
                            </label>
                        </div>
                    </div>

                    <div class="knitting-inventory-form-actions">
                        <button class="btn btn-primary" disabled="@busy" @onclick="SaveYarnAsync">Add / Merge</button>
                        <a class="btn btn-outline-secondary" href="/modules/knitting/inventory?tab=yarn">Finish</a>
                    </div>
                </section>
            </div>
            <div class="col-12 col-lg-7 col-xl-8">
                <div class="knitting-inventory-list-panel inventory-list-panel @(listBusy ? "is-refreshing" : string.Empty)">
                @if (listBusy)
                {
                    <p class="inventory-list-status muted-copy">Updating list…</p>
                }
                <div class="pattern-card-grid knitting-inventory-card-grid">
                    @foreach (var yarn in pagedYarns)
                    {
                        var assetId = yarnAssetIds.GetValueOrDefault(yarn.Id);
                        <div class="pattern-card pattern-card-with-image @(selectedItemId == yarn.Id ? "printing-material-card-active" : string.Empty)">
                            <AssetThumbnailImage AssetId="assetId" AltText="@($"{yarn.BrandName} {yarn.ColorName}")" />
                            <div>
                            <a class="pattern-card-link" href="/modules/knitting/inventory/yarn/@yarn.Id">
                                <h2>@yarn.BrandName</h2>
                                <p>@yarn.ColorName</p>
                                <div class="pattern-card-stats">
                                    <span>@yarn.TotalSkeins skeins</span>
                                    <span>@yarn.WeightName</span>
                                    <span>@yarn.FiberTag</span>
                                </div>
                                <p>@PurchaseSummary(yarn.Purchases)</p>
                            </a>
                            <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => SelectItemForAssetsAsync(yarn.Id, YarnRecordType)">
                                Manage Assets
                            </button>
                            </div>
                        </div>
                    }
                </div>
                @if (yarns.Count > inventoryPageSize)
                {
                    <div class="auth-actions mt-3">
                        <button class="btn btn-outline-secondary btn-sm" disabled="@(inventoryPage <= 1 || busy)" @onclick="PreviousInventoryPage">Previous</button>
                        <span class="muted-copy align-self-center">Page @inventoryPage of @InventoryPageCount</span>
                        <button class="btn btn-outline-secondary btn-sm" disabled="@(inventoryPage >= InventoryPageCount || busy)" @onclick="NextInventoryPage">Next</button>
                    </div>
                }
                </div>
            </div>
        </div>
    }
    else if (activeTab == "tools")
    {
        <div class="row g-4 knitting-inventory-layout">
            <div class="col-12 col-lg-5 col-xl-4">
                <section class="project-panel knitting-inventory-form-panel">
                    <h2>Add Tool</h2>
                    <p class="muted-copy mb-0">Merge adds to an existing brand + type match.</p>

                    <div class="knitting-inventory-form-section">
                        <h3>Basics</h3>
                        <div class="knitting-inventory-field-grid">
                            <label class="knitting-inventory-field">
                                <span class="form-label">Brand</span>
                                <input class="form-control" @bind="toolForm.BrandName" />
                            </label>
                            <label class="knitting-inventory-field">
                                <span class="form-label">Size</span>
                                <input class="form-control" @bind="toolForm.Size" />
                            </label>
                            <label class="knitting-inventory-field knitting-inventory-field-full">
                                <span class="form-label">Type</span>
                                <select class="form-select" @bind="toolForm.TypeName">
                                    <option value="">Select type</option>
                                    @foreach (var option in toolTypeOptions)
                                    {
                                        <option value="@option">@option</option>
                                    }
                                </select>
                            </label>
                            <div class="knitting-inventory-inline-add">
                                <span class="form-label">New tool type</span>
                                <div class="input-group">
                                    <input class="form-control" placeholder="Add new tool type" @bind="newToolTypeName" />
                                    <button class="btn btn-outline-secondary" disabled="@busy" @onclick="AddToolTypeOptionAsync">Add</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="knitting-inventory-form-section">
                        <h3>Purchase</h3>
                        <div class="knitting-inventory-field-grid">
                            <label class="knitting-inventory-field">
                                <span class="form-label">Quantity</span>
                                <input class="form-control" type="number" @bind="toolForm.Quantity" />
                            </label>
                            <label class="knitting-inventory-field">
                                <span class="form-label">Price</span>
                                <input class="form-control" type="number" step="0.01" @bind="toolForm.Price" />
                            </label>
                            <label class="knitting-inventory-field knitting-inventory-field-full">
                                <span class="form-label">Source</span>
                                <input class="form-control" @bind="toolForm.SourceName" />
                            </label>
                            <label class="knitting-inventory-field knitting-inventory-field-full form-check">
                                <input class="form-check-input" type="checkbox" @bind="toolForm.IsSalePrice" />
                                <span class="form-check-label">Sale price</span>
                            </label>
                        </div>
                    </div>

                    <div class="knitting-inventory-form-actions">
                        <button class="btn btn-primary" disabled="@busy" @onclick="SaveToolAsync">Add / Merge</button>
                        <a class="btn btn-outline-secondary" href="/modules/knitting/inventory?tab=tools">Finish</a>
                    </div>
                </section>
            </div>
            <div class="col-12 col-lg-7 col-xl-8">
                <div class="knitting-inventory-list-panel inventory-list-panel @(listBusy ? "is-refreshing" : string.Empty)">
                @if (listBusy)
                {
                    <p class="inventory-list-status muted-copy">Updating list…</p>
                }
                <div class="pattern-card-grid knitting-inventory-card-grid">
                    @foreach (var tool in pagedTools)
                    {
                        var assetId = toolAssetIds.GetValueOrDefault(tool.Id);
                        <div class="pattern-card pattern-card-with-image @(selectedItemId == tool.Id ? "printing-material-card-active" : string.Empty)">
                            <AssetThumbnailImage AssetId="assetId" AltText="@($"{tool.BrandName} {tool.TypeName}")" />
                            <div>
                            <a class="pattern-card-link" href="/modules/knitting/inventory/tool/@tool.Id">
                                <h2>@tool.TypeName</h2>
                                <p>@tool.BrandName</p>
                                <div class="pattern-card-stats">
                                    <span>@tool.Quantity owned</span>
                                    <span>@tool.Size</span>
                                </div>
                                <p>@PurchaseSummary(tool.Purchases)</p>
                            </a>
                            <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => SelectItemForAssetsAsync(tool.Id, ToolRecordType)">
                                Manage Assets
                            </button>
                            </div>
                        </div>
                    }
                </div>
                @if (tools.Count > inventoryPageSize)
                {
                    <div class="auth-actions mt-3">
                        <button class="btn btn-outline-secondary btn-sm" disabled="@(inventoryPage <= 1 || busy)" @onclick="PreviousInventoryPage">Previous</button>
                        <span class="muted-copy align-self-center">Page @inventoryPage of @InventoryPageCount</span>
                        <button class="btn btn-outline-secondary btn-sm" disabled="@(inventoryPage >= InventoryPageCount || busy)" @onclick="NextInventoryPage">Next</button>
                    </div>
                }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 knitting-inventory-layout">
            <div class="col-12 col-lg-5 col-xl-4">
                <section class="project-panel knitting-inventory-form-panel">
                    <h2>Add Notion</h2>
                    <p class="muted-copy mb-0">Merge adds to an existing brand + type match.</p>

                    <div class="knitting-inventory-form-section">
                        <h3>Basics</h3>
                        <div class="knitting-inventory-field-grid">
                            <label class="knitting-inventory-field">
                                <span class="form-label">Brand</span>
                                <input class="form-control" @bind="notionForm.BrandName" />
                            </label>
                            <label class="knitting-inventory-field">
                                <span class="form-label">Color</span>
                                <input class="form-control" @bind="notionForm.ColorName" />
                            </label>
                            <label class="knitting-inventory-field">
                                <span class="form-label">Size</span>
                                <input class="form-control" @bind="notionForm.Size" />
                            </label>
                            <label class="knitting-inventory-field knitting-inventory-field-full">
                                <span class="form-label">Type</span>
                                <select class="form-select" @bind="notionForm.TypeName">
                                    <option value="">Select type</option>
                                    @foreach (var option in notionTypeOptions)
                                    {
                                        <option value="@option">@option</option>
                                    }
                                </select>
                            </label>
                            <div class="knitting-inventory-inline-add">
                                <span class="form-label">New notion type</span>
                                <div class="input-group">
                                    <input class="form-control" placeholder="Add new notion type" @bind="newNotionTypeName" />
                                    <button class="btn btn-outline-secondary" disabled="@busy" @onclick="AddNotionTypeOptionAsync">Add</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="knitting-inventory-form-section">
                        <h3>Purchase</h3>
                        <div class="knitting-inventory-field-grid">
                            <label class="knitting-inventory-field">
                                <span class="form-label">Quantity</span>
                                <input class="form-control" type="number" @bind="notionForm.Quantity" />
                            </label>
                            <label class="knitting-inventory-field">
                                <span class="form-label">Price</span>
                                <input class="form-control" type="number" step="0.01" @bind="notionForm.Price" />
                            </label>
                            <label class="knitting-inventory-field knitting-inventory-field-full">
                                <span class="form-label">Source</span>
                                <input class="form-control" @bind="notionForm.SourceName" />
                            </label>
                            <label class="knitting-inventory-field knitting-inventory-field-full form-check">
                                <input class="form-check-input" type="checkbox" @bind="notionForm.IsSalePrice" />
                                <span class="form-check-label">Sale price</span>
                            </label>
                        </div>
                    </div>

                    @if (notionSplitPreview.Count > 0)
                    {
                        <div class="knitting-inventory-form-section">
                            <h3>Split preview</h3>
                            <p class="muted-copy">Multiple size/color values will create separate listings.</p>
                            <ul class="project-supply-list">
                                @foreach (var entry in notionSplitPreview)
                                {
                                    <li>
                                        <div>
                                            <strong>@entry.TypeName</strong>
                                            <span>@entry.BrandName</span>
                                            <span>Size: @entry.Size</span>
                                            <span>Color: @entry.ColorName</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                            <div class="auth-actions">
                                <button class="btn btn-primary" disabled="@busy" @onclick="ConfirmNotionSplitAsync">Create @notionSplitPreview.Count listings</button>
                                <button class="btn btn-outline-secondary" disabled="@busy" @onclick="CancelNotionSplit">Cancel</button>
                            </div>
                        </div>
                    }

                    <div class="knitting-inventory-form-actions">
                        <button class="btn btn-primary" disabled="@busy" @onclick="SaveNotionAsync">Add / Merge</button>
                        <a class="btn btn-outline-secondary" href="/modules/knitting/inventory?tab=notions">Finish</a>
                    </div>
                    <p class="muted-copy mt-2 mb-0">Tip: enter comma-separated sizes or colors (e.g. S, M, L) to split into separate listings.</p>
                </section>
            </div>
            <div class="col-12 col-lg-7 col-xl-8">
                <div class="knitting-inventory-list-panel inventory-list-panel @(listBusy ? "is-refreshing" : string.Empty)">
                @if (listBusy)
                {
                    <p class="inventory-list-status muted-copy">Updating list…</p>
                }
                <div class="pattern-card-grid knitting-inventory-card-grid">
                    @foreach (var notion in pagedNotions)
                    {
                        var assetId = notionAssetIds.GetValueOrDefault(notion.Id);
                        <div class="pattern-card pattern-card-with-image @(selectedItemId == notion.Id ? "printing-material-card-active" : string.Empty)">
                            <AssetThumbnailImage AssetId="assetId" AltText="@($"{notion.BrandName} {notion.TypeName}")" />
                            <div>
                            <a class="pattern-card-link" href="/modules/knitting/inventory/notion/@notion.Id">
                                <h2>@notion.TypeName</h2>
                                <p>@notion.BrandName</p>
                                <div class="pattern-card-stats">
                                    <span>@notion.Quantity owned</span>
                                    <span>@notion.Size</span>
                                    <span>@notion.ColorName</span>
                                </div>
                                <p>@PurchaseSummary(notion.Purchases)</p>
                            </a>
                            <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => SelectItemForAssetsAsync(notion.Id, NotionRecordType)">
                                Manage Assets
                            </button>
                            </div>
                        </div>
                    }
                </div>
                @if (notions.Count > inventoryPageSize)
                {
                    <div class="auth-actions mt-3">
                        <button class="btn btn-outline-secondary btn-sm" disabled="@(inventoryPage <= 1 || busy)" @onclick="PreviousInventoryPage">Previous</button>
                        <span class="muted-copy align-self-center">Page @inventoryPage of @InventoryPageCount</span>
                        <button class="btn btn-outline-secondary btn-sm" disabled="@(inventoryPage >= InventoryPageCount || busy)" @onclick="NextInventoryPage">Next</button>
                    </div>
                }
                </div>
            </div>
        </div>
    }

    @if (selectedItemId.HasValue)
    {
        <section class="printing-panel printing-assets-panel mt-3">
            <h2>Item Assets</h2>
            <InputFile OnChange="UploadItemAssetAsync" disabled="@busy" />
            <p class="muted-copy">Upload stores the file in Knitting assets. Attach to the selected item with one click.</p>

            @if (selectedItemAssets.Count == 0)
            {
                <p class="muted-copy">No assets found for the selected item yet.</p>
            }
            else
            {
                <ul class="project-supply-list">
                    @foreach (var asset in selectedItemAssets)
                    {
                        <li>
                            <div>
                                <strong>@asset.OriginalFileName</strong>
                                <span>@AssetMeta(asset)</span>
                            </div>
                            @if (asset.RecordId == selectedItemId)
                            {
                                <button class="btn btn-outline-danger btn-sm"
                                        disabled="@busy"
                                        @onclick="() => UnassignItemAssetAsync(asset.Id)">
                                    Unlink
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-primary btn-sm"
                                        disabled="@busy"
                                        @onclick="() => AssignItemAssetAsync(asset.Id)">
                                    Attach
                                </button>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    }
}

@code {
    private const string ModuleKey = "knitting";
    private const string YarnRecordType = "yarn";
    private const string ToolRecordType = "tool";
    private const string NotionRecordType = "notion";

    private readonly Dictionary<Guid, Guid?> yarnAssetIds = [];
    private readonly Dictionary<Guid, Guid?> toolAssetIds = [];
    private readonly Dictionary<Guid, Guid?> notionAssetIds = [];
