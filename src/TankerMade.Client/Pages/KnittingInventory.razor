    private async Task AddReferenceOptionAsync(
        string category,
        string rawName,
        Action clearInput,
        List<string> options,
        Action<string> assignSelection)
    {
        var name = rawName.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            var created = await ApiClient.CreateModuleInventoryReferenceItemAsync(ModuleKey, category, new CreateModuleInventoryReferenceItemDto { Name = name });
            if (!options.Contains(created.Name))
            {
                options.Add(created.Name);
                options.Sort(StringComparer.OrdinalIgnoreCase);
            }

            assignSelection(created.Name);
            clearInput();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SelectItemForAssetsAsync(Guid itemId, string recordType)
    {
        selectedItemId = itemId;
        selectedRecordType = recordType;
        await LoadSelectedItemAssetsAsync();
    }

    private async Task LoadSelectedItemAssetsAsync()
    {
        selectedItemAssets.Clear();
        if (!selectedItemId.HasValue)
        {
            return;
        }

        selectedItemAssets.AddRange(await ApiClient.GetAssetsForPickerAsync(
            ModuleKey,
            selectedRecordType,
            selectedItemId,
            includeUnassigned: true));
    }

