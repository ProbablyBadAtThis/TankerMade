@page "/modules/printing-3d/projects"
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession

<PageTitle>3D Printing Projects</PageTitle>

<div class="module-shell module-shell-printing">
    <header class="module-hero">
        <h1>3D Printing Projects</h1>
        <p>Track active print outcomes, post-processing, and readiness.</p>
    </header>

    @if (!AuthSession.IsSignedIn)
    {
        <section class="module-card">
            <p>Sign in to use this module section.</p>
            <a class="btn btn-primary" href="/login">Sign in</a>
        </section>
    }
    else if (!ModuleState.IsActive("printing-3d"))
    {
        <section class="module-card">
            <p>Activate 3D Printing from Home to continue.</p>
            <a class="btn btn-outline-primary" href="/">Go to Home</a>
        </section>
    }
    else
    {
        <section class="module-grid">
            <article class="module-card">
                <h2>Project Flow</h2>
                <p>Prepare, print, review quality, and archive by completion state.</p>
            </article>
            <article class="module-card">
                <h2>Readiness</h2>
                <p>Flag jobs blocked by material, profile, or printer availability.</p>
            </article>
        </section>
        <a class="btn btn-outline-secondary" href="/modules/printing-3d">Back to 3D Printing Home</a>
    }
</div>
