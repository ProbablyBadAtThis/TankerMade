@page "/modules/knitting/projects/new"
@using TankerMade.Contracts.DTOs.Assets
@using TankerMade.Contracts.DTOs.ModulePatterns
@using TankerMade.Contracts.DTOs.ModuleProjects
@using TankerMade.Contracts.DTOs.Reference
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession
@inject TankerMade.Client.Services.TankerMadeApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>New Knitting Project</PageTitle>

@if (!sessionReady)
{
    <p>Loading...</p>
}
else if (!AuthSession.IsSignedIn)
{
    <h1>New Project</h1>
    <p>Sign in to use this module section.</p>
    <a class="btn btn-primary" href="/login">Sign in</a>
}
else if (!ModuleState.IsActive(ModuleKey))
{
    <h1>New Project</h1>
    <p>Activate Knitting from Home to continue.</p>
    <a class="btn btn-outline-primary" href="/home">Go to Home</a>
}
else
{
    <div class="page-heading">
        <div>
            <a class="pattern-back-link" href="/modules/knitting/projects">Projects</a>
            <h1>New Project</h1>
            <p>Walk through pattern selection, supplies, and project details.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="wizard-shell">
        <nav class="wizard-steps" aria-label="Wizard steps">
            @foreach (var (step, label, index) in VisibleSteps.Select((entry, index) => (entry.Step, entry.Label, index)))
            {
                var pillClass = step == currentStep ? "wizard-step-pill active" : index < CurrentStepPosition ? "wizard-step-pill complete" : "wizard-step-pill";
                <span class="@pillClass">@label</span>
            }
        </nav>

        <section class="project-panel">
            @if (currentStep == ProjectWizardStep.Pattern)
            {
                <h2>Pattern</h2>
                <div class="list-toolbar">
                    <label>
                        <span>Type</span>
                        <select class="form-control" @bind="typeFilter" @bind:after="ApplyPatternFilters">
                            <option value="">Any</option>
                            <option value="Knit">Knit</option>
                            <option value="Crochet">Crochet</option>
                        </select>
                    </label>
                    <label>
                        <span>Form</span>
                        <select class="form-control" @bind="formFilter" @bind:after="ApplyPatternFilters">
                            <option value="">Any</option>
                            <option value="2D">2D</option>
                            <option value="3D">3D</option>
                        </select>
                    </label>
                    <label>
                        <span>Theme</span>
                        <select class="form-control" @bind="themeFilterIdText" @bind:after="ApplyPatternFilters">
                            <option value="">Any theme</option>
                            @foreach (var theme in themes)
                            {
                                <option value="@theme.Id">@theme.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Search patterns</span>
                        <InputText class="form-control" @bind-Value="patternSearch" @bind-Value:after="ApplyPatternFilters" />
                    </label>
                </div>

                <label class="archive-toggle mb-3">
                    <input type="checkbox" @bind="createNewPattern" @bind:after="OnCreateNewPatternChanged" />
                    Create a new pattern instead of selecting one
                </label>

                @if (createNewPattern)
                {
                    <div class="form-grid">
                        <label>
                            <span>New pattern name</span>
                            <InputText class="form-control" @bind-Value="newPatternName" />
                        </label>
                        <label>
                            <span>Type</span>
                            <InputText class="form-control" @bind-Value="newPatternType" />
                        </label>
                        <label>
                            <span>Form</span>
                            <InputText class="form-control" @bind-Value="newPatternForm" />
                        </label>
                        <label>
                            <span>Theme</span>
                            <select class="form-control" @bind="newPatternThemeIdText">
                                <option value="">None</option>
                                @foreach (var theme in themes)
                                {
                                    <option value="@theme.Id">@theme.Name</option>
                                }
                            </select>
                        </label>
                    </div>
                    <div class="auth-actions mt-2">
                        <ReferenceAutocompleteInput Label="New theme name"
                                                    Placeholder="New theme name"
                                                    Options="themeNameOptions"
                                                    Disabled="busy"
                                                    @bind-Value="newThemeName" />
                        <button class="btn btn-outline-secondary btn-sm" type="button" disabled="@busy" @onclick="CreateThemeAsync">Add Theme</button>
                    </div>
                }
                else
                {
                    <label>
                        <span>Pattern</span>
                        <select class="form-control" @bind="selectedPatternIdText">
                            <option value="">Select a pattern</option>
                            @foreach (var pattern in filteredPatterns)
                            {
                                <option value="@pattern.Id">@pattern.Name (@pattern.PieceCount pieces)</option>
                            }
                        </select>
                    </label>
                }
            }
            else if (currentStep == ProjectWizardStep.Steps)
            {
                <h2>Pattern Steps</h2>
                <p class="text-muted">Add pieces and row/stitch steps for your new pattern.</p>

                @if (draftPieces.Count > 0)
                {
                    <ul class="project-supply-list mb-3">
                        @foreach (var (piece, pieceIndex) in draftPieces.Select((piece, index) => (piece, index)))
                        {
                            <li>
                                <div>
                                    <strong>@piece.Name</strong>
                                    <span class="text-muted">(@piece.Steps.Count steps)</span>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm" type="button" disabled="@busy" @onclick="() => SelectDraftPiece(pieceIndex)">Edit</button>
                            </li>
                        }
                    </ul>
                }

                <div class="form-grid">
                    <label>
                        <span>@(ActiveDraftPiece == null ? "Piece name" : $"Piece: {ActiveDraftPiece.Name}")</span>
                        <InputText class="form-control" @bind-Value="draftPieceName" />
                    </label>
                    <label>
                        <span>Step label</span>
                        <InputText class="form-control" @bind-Value="draftStepLabel" placeholder="e.g. Body rows" />
                    </label>
                    <label>
                        <span>Row start</span>
                        <InputNumber class="form-control" @bind-Value="draftStartIndex" />
                    </label>
                    <label>
                        <span>Row end</span>
                        <InputNumber class="form-control" @bind-Value="draftEndIndex" />
                    </label>
                    <label>
                        <span>Stitch count</span>
                        <InputNumber class="form-control" @bind-Value="draftStitchCount" />
                    </label>
                </div>
                <div class="auth-actions mt-2">
                    <button class="btn btn-outline-primary" type="button" disabled="@busy" @onclick="AddDraftStepAsync">Add Row</button>
                    <button class="btn btn-outline-secondary" type="button" disabled="@busy" @onclick="StartNewDraftPiece">New Piece</button>
                </div>
            }
            else if (currentStep == ProjectWizardStep.Supplies)
            {
                <h2>Supplies</h2>
                <div class="form-grid">
                    <label>
                        <span>Supply type</span>
                        <select class="form-control" @bind="supplyType" @bind:after="LoadSupplyInventoryOptionsAsync">
                            <option value="yarn">Yarn</option>
                            <option value="tool">Tool</option>
                            <option value="notion">Notion</option>
                        </select>
                    </label>
                    <label>
                        <span>Inventory item</span>
                        <select class="form-control" @bind="selectedSupplyInventoryIdText" @bind:after="OnSupplyInventoryChanged">
                            <option value="">Select item</option>
                            @foreach (var option in supplyInventoryOptions)
                            {
                                <option value="@option.Id">@option.Label</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Quantity planned</span>
                        <InputNumber class="form-control" @bind-Value="supplyQuantity" />
                    </label>
                </div>
                <button class="btn btn-outline-primary mt-2" type="button" disabled="@busy" @onclick="AddPendingSupply">Add Supply Link</button>

                @if (pendingSupplies.Count > 0)
                {
                    <ul class="project-supply-list mt-3">
                        @foreach (var supply in pendingSupplies)
                        {
                            <li>
                                <label>
                                    <input type="checkbox" @bind="supply.Include" />
                                    <strong>@supply.Label</strong>
                                    <span class="text-muted">(@supply.InventoryItemType)</span>
                                </label>
                                <button class="btn btn-outline-danger btn-sm" type="button" disabled="@busy" @onclick="() => RemovePendingSupply(supply)">Remove</button>
                            </li>
                        }
                    </ul>
                }
            }
            else if (currentStep == ProjectWizardStep.Metadata)
            {
                <h2>Project Details</h2>
                <div class="knitting-hero-card mb-3">
                    @if (uploadedAssetId.HasValue)
                    {
                        <AssetThumbnailImage AssetId="uploadedAssetId" AltText="Project image preview" />
                    }
                    else
                    {
                        <div class="asset-thumbnail-placeholder">No image yet</div>
                    }
                    <div>
                        <label>
                            <span>Project image</span>
                            <InputFile OnChange="UploadProjectImageAsync" disabled="@busy" />
                        </label>
                    </div>
                </div>
                <div class="form-grid">
                    <label>
                        <span>Project title</span>
                        <InputText class="form-control" @bind-Value="projectTitle" />
                    </label>
                    <label>
                        <span>Theme</span>
                        <select class="form-control" @bind="projectThemeIdText">
                            <option value="">None</option>
                            @foreach (var theme in themes)
                            {
                                <option value="@theme.Id">@theme.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Main color</span>
                        <select class="form-control" @bind="projectColorIdText">
                            <option value="">None</option>
                            @foreach (var color in colors)
                            {
                                <option value="@color.Id">@color.Name</option>
                            }
                        </select>
                    </label>
                </div>
                <div class="mt-3">
                    <span>Difficulty</span>
                    <DifficultyPicker @bind-Value="projectDifficulty" Disabled="busy" />
                </div>
            }
            else
            {
                <h2>Ready to Start</h2>
                <div class="form-grid mb-3">
                    <label class="archive-toggle">
                        <input type="checkbox" @bind="useAutoStartDate" />
                        Use today's date as start date
                    </label>
                    @if (!useAutoStartDate)
                    {
                        <label>
                            <span>Date started</span>
                            <InputDate class="form-control" @bind-Value="manualStartDate" />
                        </label>
                    }
                </div>
                <article class="project-card project-card-with-image">
                    @if (uploadedAssetId.HasValue)
                    {
                        <AssetThumbnailImage AssetId="uploadedAssetId" AltText="Project preview" />
                    }
                    else
                    {
                        <div class="asset-thumbnail-placeholder">No image</div>
                    }
                    <div>
                        <h3>@(string.IsNullOrWhiteSpace(projectTitle) ? "Untitled project" : projectTitle)</h3>
                        <p>
                            <span class="@KnittingUi.DifficultyCssClass(projectDifficulty)">@KnittingUi.DifficultyLabel(projectDifficulty)</span>
                        </p>
                        <p class="mb-1"><strong>Pattern:</strong> @SummaryPatternName</p>
                        <p class="mb-1"><strong>Theme:</strong> @SummaryThemeName</p>
                        <p class="mb-1"><strong>Color:</strong> @SummaryColorName</p>
                        <p class="mb-1"><strong>Start date:</strong> @SummaryStartDate</p>
                        <p class="mb-1"><strong>Supplies:</strong> @pendingSupplies.Count(s => s.Include) selected</p>
                        @if (createNewPattern)
                        {
                            <p class="mb-0"><strong>New pattern pieces:</strong> @draftPieces.Count</p>
                        }
                    </div>
                </article>
                @if (pendingSupplies.Count > 0)
                {
                    <ul class="project-supply-list mt-3">
                        @foreach (var supply in pendingSupplies)
                        {
                            <li>
                                <label>
                                    <input type="checkbox" @bind="supply.Include" />
                                    <strong>@supply.Label</strong>
                                    <span class="text-muted">(@supply.InventoryItemType)</span>
                                </label>
                            </li>
                        }
                    </ul>
                }
                <button class="btn btn-primary mt-3" type="button" disabled="@busy" @onclick="FinalizeProjectAsync">Start Project</button>
            }

            @if (currentStep != ProjectWizardStep.Finalize)
            {
                <div class="auth-actions mt-3">
                    @if (CurrentStepPosition > 0)
                    {
                        <button class="btn btn-outline-secondary" type="button" disabled="@busy" @onclick="PreviousStep">Back</button>
                    }
                    <button class="btn btn-primary" type="button" disabled="@busy" @onclick="NextStep">Next</button>
                </div>
            }
            else if (CurrentStepPosition > 0)
            {
                <div class="auth-actions mt-3">
                    <button class="btn btn-outline-secondary" type="button" disabled="@busy" @onclick="PreviousStep">Back</button>
                </div>
            }
        </section>
    </div>
}

@code {
    private const string ModuleKey = "knitting";
    private const string ProjectRecordType = "project";

    private enum ProjectWizardStep
    {
        Pattern,
        Steps,
        Supplies,
        Metadata,
        Finalize
    }

    private readonly List<ModulePatternDto> allPatterns = [];
    private readonly List<ModulePatternDto> filteredPatterns = [];
    private readonly List<CoreReferenceItemDto> themes = [];
    private readonly List<CoreReferenceItemDto> colors = [];
    private readonly List<DraftPiece> draftPieces = [];
    private readonly List<PendingSupply> pendingSupplies = [];
    private readonly List<InventoryOption> supplyInventoryOptions = [];

    private ProjectWizardStep currentStep = ProjectWizardStep.Pattern;
    private bool sessionReady;
    private bool busy;
    private bool createNewPattern;
    private string errorMessage = string.Empty;
    private string typeFilter = string.Empty;
    private string formFilter = string.Empty;
    private string themeFilterIdText = string.Empty;
    private string patternSearch = string.Empty;
    private string selectedPatternIdText = string.Empty;
    private string newPatternName = string.Empty;
    private string newPatternType = "Knit";
    private string newPatternForm = "2D";
    private string newPatternThemeIdText = string.Empty;
    private string newThemeName = string.Empty;
    private string draftPieceName = string.Empty;
    private string draftStepLabel = string.Empty;
    private int? draftStartIndex;
    private int? draftEndIndex;
    private int? draftStitchCount;
    private int? activeDraftPieceIndex;
    private string supplyType = "yarn";
    private string selectedSupplyInventoryIdText = string.Empty;
    private decimal? supplyQuantity;
    private string projectTitle = string.Empty;
    private string projectThemeIdText = string.Empty;
    private string projectColorIdText = string.Empty;
    private int projectDifficulty = 1;
    private bool useAutoStartDate = true;
    private DateTime? manualStartDate = DateTime.Today;
    private Guid? uploadedAssetId;

    private IReadOnlyList<string> themeNameOptions => themes.Select(theme => theme.Name).ToList();

    private IEnumerable<(ProjectWizardStep Step, string Label)> VisibleSteps
    {
        get
        {
            yield return (ProjectWizardStep.Pattern, "Pattern");
            if (createNewPattern)
            {
                yield return (ProjectWizardStep.Steps, "Steps");
            }

            yield return (ProjectWizardStep.Supplies, "Supplies");
            yield return (ProjectWizardStep.Metadata, "Details");
            yield return (ProjectWizardStep.Finalize, "Start");
        }
    }

    private int CurrentStepPosition => VisibleSteps.ToList().FindIndex(entry => entry.Step == currentStep);

    private DraftPiece? ActiveDraftPiece =>
        activeDraftPieceIndex.HasValue && activeDraftPieceIndex.Value >= 0 && activeDraftPieceIndex.Value < draftPieces.Count
            ? draftPieces[activeDraftPieceIndex.Value]
            : null;

    private string SummaryPatternName =>
        createNewPattern
            ? (string.IsNullOrWhiteSpace(newPatternName) ? "New pattern" : newPatternName)
            : filteredPatterns.FirstOrDefault(pattern => pattern.Id.ToString() == selectedPatternIdText)?.Name ?? "Selected pattern";

    private string SummaryThemeName =>
        themes.FirstOrDefault(theme => theme.Id.ToString() == projectThemeIdText)?.Name
        ?? (createNewPattern
            ? themes.FirstOrDefault(theme => theme.Id.ToString() == newPatternThemeIdText)?.Name
            : filteredPatterns.FirstOrDefault(pattern => pattern.Id.ToString() == selectedPatternIdText)?.ThemeName)
        ?? "None";

    private string SummaryColorName =>
        colors.FirstOrDefault(color => color.Id.ToString() == projectColorIdText)?.Name ?? "None";

    private string SummaryStartDate =>
        (useAutoStartDate ? DateTime.Today : manualStartDate ?? DateTime.Today).ToString("MMM d, yyyy");

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.InitializeAsync();
        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
        }

        sessionReady = true;
        await LoadReferenceDataAsync();
        await LoadPatternsAsync();
    }

    private async Task LoadReferenceDataAsync()
    {
        themes.Clear();
        themes.AddRange(await ApiClient.GetCoreReferenceItemsAsync("themes"));
        colors.Clear();
        colors.AddRange(await ApiClient.GetCoreReferenceItemsAsync("colors"));
    }

    private async Task LoadPatternsAsync()
    {
        try
        {
            allPatterns.Clear();
            allPatterns.AddRange(await ApiClient.GetModulePatternsAsync(ModuleKey));
            ApplyPatternFilters();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ApplyPatternFilters()
    {
        filteredPatterns.Clear();
        Guid? themeFilterId = Guid.TryParse(themeFilterIdText, out var parsedThemeId) ? parsedThemeId : null;

        filteredPatterns.AddRange(allPatterns.Where(pattern =>
            (string.IsNullOrWhiteSpace(typeFilter) || pattern.Type.Equals(typeFilter, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrWhiteSpace(formFilter) || pattern.Form.Equals(formFilter, StringComparison.OrdinalIgnoreCase))
            && (!themeFilterId.HasValue || pattern.ThemeId == themeFilterId)
            && (string.IsNullOrWhiteSpace(patternSearch)
                || pattern.Name.Contains(patternSearch, StringComparison.OrdinalIgnoreCase))));
    }

    private void OnCreateNewPatternChanged()
    {
        if (createNewPattern && currentStep == ProjectWizardStep.Pattern && draftPieces.Count == 0)
        {
            draftPieceName = "Piece 1";
        }

        if (!createNewPattern && currentStep == ProjectWizardStep.Steps)
        {
            currentStep = ProjectWizardStep.Supplies;
        }
    }

    private async Task CreateThemeAsync()
    {
        if (string.IsNullOrWhiteSpace(newThemeName))
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            var created = await ApiClient.CreateCoreReferenceItemAsync("themes", new CreateCoreReferenceItemRequest
            {
                Name = newThemeName.Trim()
            });
            themes.Add(created);
            newPatternThemeIdText = created.Id.ToString();
            newThemeName = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void StartNewDraftPiece()
    {
        activeDraftPieceIndex = null;
        draftPieceName = $"Piece {draftPieces.Count + 1}";
        draftStepLabel = string.Empty;
        draftStartIndex = null;
        draftEndIndex = null;
        draftStitchCount = null;
    }

    private void SelectDraftPiece(int pieceIndex)
    {
        activeDraftPieceIndex = pieceIndex;
        draftPieceName = draftPieces[pieceIndex].Name;
    }

    private Task AddDraftStepAsync()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(draftPieceName))
        {
            errorMessage = "Enter a piece name before adding steps.";
            return Task.CompletedTask;
        }

        if (activeDraftPieceIndex == null)
        {
            draftPieces.Add(new DraftPiece { Name = draftPieceName.Trim() });
            activeDraftPieceIndex = draftPieces.Count - 1;
        }
        else
        {
            draftPieces[activeDraftPieceIndex.Value].Name = draftPieceName.Trim();
        }

        draftPieces[activeDraftPieceIndex.Value].Steps.Add(new DraftStep
        {
            Label = string.IsNullOrWhiteSpace(draftStepLabel) ? "Step" : draftStepLabel.Trim(),
            StartIndex = draftStartIndex,
            EndIndex = draftEndIndex,
            StitchCount = draftStitchCount
        });

        draftStepLabel = string.Empty;
        draftStartIndex = null;
        draftEndIndex = null;
        draftStitchCount = null;
        return Task.CompletedTask;
    }

    private async Task LoadSupplyInventoryOptionsAsync()
    {
        supplyInventoryOptions.Clear();
        selectedSupplyInventoryIdText = string.Empty;

        switch (supplyType)
        {
            case "tool":
                foreach (var tool in await ApiClient.GetModuleToolsAsync(ModuleKey))
                {
                    supplyInventoryOptions.Add(new InventoryOption(tool.Id, "tool", $"{tool.BrandName} - {tool.TypeName}"));
                }

                break;
            case "notion":
                foreach (var notion in await ApiClient.GetModuleNotionsAsync(ModuleKey))
                {
                    supplyInventoryOptions.Add(new InventoryOption(notion.Id, "notion", $"{notion.BrandName} - {notion.TypeName}"));
                }

                break;
            default:
                foreach (var yarn in await ApiClient.GetModuleYarnsAsync(ModuleKey))
                {
                    supplyInventoryOptions.Add(new InventoryOption(yarn.Id, "yarn", $"{yarn.BrandName} - {yarn.ColorName}"));
                }

                break;
        }
    }

    private void OnSupplyInventoryChanged()
    {
        if (!Guid.TryParse(selectedSupplyInventoryIdText, out var inventoryId))
        {
            return;
        }

        var selected = supplyInventoryOptions.FirstOrDefault(option => option.Id == inventoryId);
        if (selected != null)
        {
            supplyType = selected.InventoryItemType;
        }
    }

    private void AddPendingSupply()
    {
        if (!Guid.TryParse(selectedSupplyInventoryIdText, out var inventoryId))
        {
            errorMessage = "Select an inventory item to link.";
            return;
        }

        var selected = supplyInventoryOptions.FirstOrDefault(option => option.Id == inventoryId);
        if (selected == null)
        {
            errorMessage = "Select an inventory item to link.";
            return;
        }

        pendingSupplies.Add(new PendingSupply
        {
            InventoryItemType = selected.InventoryItemType,
            InventoryItemId = selected.Id,
            Label = selected.Label,
            QuantityPlanned = supplyQuantity,
            Include = true
        });

        selectedSupplyInventoryIdText = string.Empty;
        supplyQuantity = null;
        errorMessage = string.Empty;
    }

    private void RemovePendingSupply(PendingSupply supply) => pendingSupplies.Remove(supply);

    private async Task UploadProjectImageAsync(InputFileChangeEventArgs args)
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            var asset = await ApiClient.UploadAssetAsync(ModuleKey, args.File);
            uploadedAssetId = asset.Id;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void NextStep()
    {
        if (!ValidateCurrentStep())
        {
            return;
        }

        var steps = VisibleSteps.ToList();
        var index = steps.FindIndex(entry => entry.Step == currentStep);
        if (index >= 0 && index < steps.Count - 1)
        {
            currentStep = steps[index + 1].Step;
            errorMessage = string.Empty;

            if (currentStep == ProjectWizardStep.Supplies && supplyInventoryOptions.Count == 0)
            {
                _ = LoadSupplyInventoryOptionsAsync();
            }
        }
    }

    private void PreviousStep()
    {
        var steps = VisibleSteps.ToList();
        var index = steps.FindIndex(entry => entry.Step == currentStep);
        if (index > 0)
        {
            currentStep = steps[index - 1].Step;
            errorMessage = string.Empty;
        }
    }

    private bool ValidateCurrentStep()
    {
        errorMessage = string.Empty;

        switch (currentStep)
        {
            case ProjectWizardStep.Pattern:
                if (createNewPattern)
                {
                    if (string.IsNullOrWhiteSpace(newPatternName))
                    {
                        errorMessage = "Enter a name for the new pattern.";
                        return false;
                    }
                }
                else if (!Guid.TryParse(selectedPatternIdText, out _))
                {
                    errorMessage = "Select a pattern or choose to create a new one.";
                    return false;
                }

                return true;
            case ProjectWizardStep.Steps:
                if (draftPieces.Count == 0 || draftPieces.All(piece => piece.Steps.Count == 0))
                {
                    errorMessage = "Add at least one piece with one step.";
                    return false;
                }

                return true;
            case ProjectWizardStep.Metadata:
                if (string.IsNullOrWhiteSpace(projectTitle))
                {
                    errorMessage = "Enter a project title.";
                    return false;
                }

                return true;
            default:
                return true;
        }
    }

    private async Task FinalizeProjectAsync()
    {
        if (!ValidateCurrentStep())
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            Guid? patternId = null;
            Guid? themeId = null;

            if (createNewPattern)
            {
                if (Guid.TryParse(newPatternThemeIdText, out var parsedThemeId))
                {
                    themeId = parsedThemeId;
                }

                var createdPattern = await ApiClient.CreateModulePatternAsync(ModuleKey, new CreateModulePatternRequest
                {
                    Name = newPatternName.Trim(),
                    Type = newPatternType.Trim(),
                    Form = newPatternForm.Trim(),
                    Difficulty = KnittingUi.DifficultyLabel(projectDifficulty),
                    ThemeId = themeId
                });

                patternId = createdPattern.Id;

                foreach (var draftPiece in draftPieces)
                {
                    var piece = await ApiClient.AddModulePatternPieceAsync(ModuleKey, createdPattern.Id, new CreateModulePatternPieceRequest
                    {
                        Name = draftPiece.Name
                    });

                    if (piece == null)
                    {
                        continue;
                    }

                    foreach (var step in draftPiece.Steps)
                    {
                        await ApiClient.AddModulePatternStepAsync(ModuleKey, createdPattern.Id, piece.Id, new CreateModulePatternStepRequest
                        {
                            Label = step.Label,
                            StartIndex = step.StartIndex,
                            EndIndex = step.EndIndex,
                            StitchCount = step.StitchCount
                        });
                    }
                }
            }
            else if (Guid.TryParse(selectedPatternIdText, out var selectedPatternId))
            {
                patternId = selectedPatternId;
                var selectedPattern = filteredPatterns.FirstOrDefault(pattern => pattern.Id == selectedPatternId);
                themeId = selectedPattern?.ThemeId;
            }

            if (Guid.TryParse(projectThemeIdText, out var parsedProjectThemeId))
            {
                themeId = parsedProjectThemeId;
            }

            Guid? colorId = Guid.TryParse(projectColorIdText, out var parsedColorId) ? parsedColorId : null;
            var startedAt = useAutoStartDate
                ? DateTime.UtcNow
                : DateTime.SpecifyKind((manualStartDate ?? DateTime.Today).Date, DateTimeKind.Utc);

            var project = await ApiClient.CreateModuleProjectAsync(ModuleKey, new CreateModuleProjectRequest
            {
                Name = projectTitle.Trim(),
                PatternId = patternId,
                ThemeId = themeId,
                ColorId = colorId,
                Difficulty = projectDifficulty,
                StartedAt = startedAt
            });

            foreach (var supply in pendingSupplies.Where(item => item.Include))
            {
                await ApiClient.AddModuleProjectInventoryLinkAsync(ModuleKey, project.Id, new CreateModuleProjectInventoryLinkRequest
                {
                    InventoryItemType = supply.InventoryItemType,
                    InventoryItemId = supply.InventoryItemId,
                    QuantityPlanned = supply.QuantityPlanned
                });
            }

            if (uploadedAssetId.HasValue)
            {
                await ApiClient.AssignAssetAsync(uploadedAssetId.Value, new AssetAssignmentRequest
                {
                    ModuleKey = ModuleKey,
                    RecordType = ProjectRecordType,
                    RecordId = project.Id
                });
            }

            Navigation.NavigateTo($"/modules/knitting/projects/{project.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class DraftPiece
    {
        public string Name { get; set; } = string.Empty;
        public List<DraftStep> Steps { get; } = [];
    }

    private sealed class DraftStep
    {
        public string Label { get; set; } = string.Empty;
        public int? StartIndex { get; set; }
        public int? EndIndex { get; set; }
        public int? StitchCount { get; set; }
    }

    private sealed class PendingSupply
    {
        public string InventoryItemType { get; set; } = string.Empty;
        public Guid InventoryItemId { get; set; }
        public string Label { get; set; } = string.Empty;
        public decimal? QuantityPlanned { get; set; }
        public bool Include { get; set; }
    }

    private sealed record InventoryOption(Guid Id, string InventoryItemType, string Label);
}
