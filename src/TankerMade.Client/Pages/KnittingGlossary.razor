@page "/modules/knitting/glossary"
@using TankerMade.Contracts.DTOs.ModuleSettings
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession
@inject TankerMade.Client.Services.TankerMadeApiClient ApiClient

<PageTitle>Knitting Glossary</PageTitle>

<KnittingModuleGate Loading="loading">
    <MudStack Spacing="3">
        <KnittingPageHeader Title="Glossary"
                            Subtitle="Stitch terms, abbreviations, and definitions you can reference while knitting." />

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <MudAlert Severity="Severity.Success">@successMessage</MudAlert>
        }

        <MudPaper Class="pa-4 knitting-panel-mud" Elevation="1">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1">@(editingTermKey == null ? "Add Term" : "Edit Term")</MudText>
                <EditForm Model="termForm" OnValidSubmit="SaveTermAsync">
                    <DataAnnotationsValidator />
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="termForm.Term"
                                      Label="Term"
                                      Variant="Variant.Outlined"
                                      Disabled="@(editingTermKey != null)"
                                      Required="true" />
                        <MudTextField @bind-Value="termForm.Definition"
                                      Label="Definition"
                                      Variant="Variant.Outlined"
                                      Lines="3" />
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="busy">
                                @(editingTermKey == null ? "Add Term" : "Save Term")
                            </MudButton>
                            @if (editingTermKey != null)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="busy" OnClick="CancelTermEdit">Cancel</MudButton>
                            }
                        </MudStack>
                    </MudStack>
                </EditForm>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 knitting-panel-mud" Elevation="1">
            <MudStack Spacing="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle1">Terms</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@filteredTerms.Count of @allTerms.Count</MudText>
                </MudStack>
                <MudTextField @bind-Value="termSearch"
                              @bind-Value:after="ApplyTermFilter"
                              Label="Search terms"
                              Variant="Variant.Outlined"
                              Placeholder="Filter as you type"
                              Immediate="true" />

                @if (filteredTerms.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @(allTerms.Count == 0 ? "No terms yet. Add your first abbreviation or stitch definition above." : "No terms match your search.")
                    </MudText>
                }
                else
                {
                    <MudStack Spacing="1">
                        @foreach (var term in filteredTerms)
                        {
                            <MudPaper Class="pa-3 knitting-term-row" Elevation="0" Outlined="true">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Spacing="2">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle2">@term.Key</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@term.Value</MudText>
                                    </MudStack>
                                    <MudStack Row="true" Spacing="1">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Disabled="busy" OnClick="@(() => EditTerm(term))">Edit</MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="busy" OnClick="@(() => DeleteTermAsync(term.Key))">Delete</MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                }
            </MudStack>
        </MudPaper>
    </MudStack>
</KnittingModuleGate>

@code {
    private const string ModuleKey = "knitting";
    private readonly List<ModuleSettingItemDto> allTerms = [];
    private readonly List<ModuleSettingItemDto> filteredTerms = [];
    private string termSearch = string.Empty;
    private string? editingTermKey;
    private TermFormModel termForm = new();
    private bool loading = true;
    private bool busy;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.InitializeAsync();
        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
        }

        await LoadTermsAsync();
    }

    private async Task LoadTermsAsync()
    {
        loading = true;
        errorMessage = string.Empty;

        try
        {
            if (!AuthSession.IsSignedIn || !ModuleState.IsActive(ModuleKey))
            {
                return;
            }

            var settings = await ApiClient.GetModuleSettingsAsync(ModuleKey);
            allTerms.Clear();
            allTerms.AddRange(settings.Where(setting =>
                string.Equals(setting.Category, "terms", StringComparison.OrdinalIgnoreCase)));
            ApplyTermFilter();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void ApplyTermFilter()
    {
        filteredTerms.Clear();
        IEnumerable<ModuleSettingItemDto> query = allTerms.OrderBy(term => term.Key);

        if (!string.IsNullOrWhiteSpace(termSearch))
        {
            query = query.Where(term =>
                term.Key.Contains(termSearch, StringComparison.OrdinalIgnoreCase)
                || term.Value.Contains(termSearch, StringComparison.OrdinalIgnoreCase));
        }

        filteredTerms.AddRange(query);
    }

    private async Task SaveTermAsync()
    {
        var term = termForm.Term.Trim();
        if (string.IsNullOrWhiteSpace(term))
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            await ApiClient.UpsertModuleSettingAsync(ModuleKey, new UpsertModuleSettingItemRequest
            {
                Category = "terms",
                Key = term,
                Value = termForm.Definition.Trim()
            });
            termForm = new();
            editingTermKey = null;
            await LoadTermsAsync();
            successMessage = "Saved term.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void EditTerm(ModuleSettingItemDto term)
    {
        editingTermKey = term.Key;
        termForm = new TermFormModel
        {
            Term = term.Key,
            Definition = term.Value
        };
    }

    private void CancelTermEdit()
    {
        editingTermKey = null;
        termForm = new();
    }

    private async Task DeleteTermAsync(string key)
    {
        busy = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            await ApiClient.DeleteModuleSettingAsync(ModuleKey, key);
            if (string.Equals(editingTermKey, key, StringComparison.OrdinalIgnoreCase))
            {
                CancelTermEdit();
            }

            await LoadTermsAsync();
            successMessage = "Deleted term.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private class TermFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Term is required")]
        [System.ComponentModel.DataAnnotations.StringLength(150, ErrorMessage = "Term cannot exceed 150 characters")]
        public string Term { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(1000, ErrorMessage = "Definition cannot exceed 1000 characters")]
        public string Definition { get; set; } = string.Empty;
    }
}
