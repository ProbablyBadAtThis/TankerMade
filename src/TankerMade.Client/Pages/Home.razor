@page "/home"
@using TankerMade.Contracts.DTOs.Dashboard
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession
@inject TankerMade.Client.Services.TankerMadeApiClient ApiClient
@inject TankerMade.Client.Services.DashboardLayoutPreferences LayoutPreferences
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

<div class="core-dashboard-page">
    <header class="core-dashboard-header">
        <div class="core-dashboard-header-bar">
            <div class="core-dashboard-header-lead"></div>

            <MudStack Spacing="1" Class="core-dashboard-header-center">
                <MudText Typo="Typo.h4">@GetGreeting()</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">Your local-first maker workbench.</MudText>
                @if (initialized && LayoutPreferences.ShowActivitySummary && overview != null && HasActiveModules)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="core-dashboard-activity-summary">
                        @FormatActivitySummary(overview.Activity)
                    </MudText>
                }
            </MudStack>

            <div class="core-dashboard-header-trail">
                @if (initialized)
                {
                    <MudMenu AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             PopoverClass="core-dashboard-customize-popover">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Tune"
                                       Class="core-dashboard-customize-btn"
                                       OnClick="@context.ToggleAsync">
                                Customize
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudStack Spacing="0" Class="core-dashboard-customize-menu" @onclick:stopPropagation="true">
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-3 pt-2 pb-1">Show sections</MudText>
                                <MudSwitch T="bool"
                                           Label="Activity summary"
                                           Color="Color.Primary"
                                           Value="@LayoutPreferences.ShowActivitySummary"
                                           ValueChanged="LayoutPreferences.SetShowActivitySummaryAsync" />
                                <MudSwitch T="bool"
                                           Label="Quick actions"
                                           Color="Color.Primary"
                                           Value="@LayoutPreferences.ShowQuickActions"
                                           ValueChanged="LayoutPreferences.SetShowQuickActionsAsync" />
                                <MudSwitch T="bool"
                                           Label="Due soon"
                                           Color="Color.Primary"
                                           Value="@LayoutPreferences.ShowDueSoon"
                                           ValueChanged="LayoutPreferences.SetShowDueSoonAsync" />
                                <MudSwitch T="bool"
                                           Label="Engagement"
                                           Color="Color.Primary"
                                           Value="@LayoutPreferences.ShowEngagement"
                                           ValueChanged="LayoutPreferences.SetShowEngagementAsync" />
                                @if (IsAdmin)
                                {
                                    <MudSwitch T="bool"
                                               Label="Admin health"
                                               Color="Color.Primary"
                                               Value="@LayoutPreferences.ShowAdminHealth"
                                               ValueChanged="LayoutPreferences.SetShowAdminHealthAsync" />
                                }
                            </MudStack>
                        </ChildContent>
                    </MudMenu>
                }
            </div>
        </div>
    </header>

    @if (!initialized)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
        }

        <div class="core-dashboard-columns @(ShowEngagementSidebar ? "has-sidebar" : null)">
            <MudStack Spacing="3" Class="core-dashboard-main">
                <MudPaper Class="pa-4 core-panel-mud core-dashboard-recent-panel core-dashboard-section" Elevation="1">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Recent projects</MudText>

                        @if (featuredRecentWork != null)
                        {
                            <div class="core-dashboard-recent-layout">
                                <MudPaper Class="pa-3 core-dashboard-recent-featured"
                                          Elevation="0"
                                          Outlined="true">
                                    <MudLink Href="@featuredRecentWork.NavigationPath" Underline="Underline.None" Class="core-dashboard-recent-link">
                                        <div class="core-dashboard-recent-featured-inner">
                                            <AssetThumbnailImage AssetId="featuredRecentWork.ThumbnailAssetId"
                                                                 FallbackSrc="@GetThumbnailFallback(featuredRecentWork)"
                                                                 AltText="@featuredRecentWork.Title"
                                                                 SizeKey="medium"
                                                                 CssClass="core-dashboard-recent-thumb core-dashboard-recent-thumb-featured"
                                                                 ShowPlaceholder="false" />
                                            <MudStack Spacing="1" Class="core-dashboard-recent-copy">
                                                <MudText Typo="Typo.subtitle1">@featuredRecentWork.Title</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @GetModuleName(featuredRecentWork.ModuleKey) · @FormatLastActive(featuredRecentWork.LastAccessedAtUtc)
                                                </MudText>
                                            </MudStack>
                                        </div>
                                    </MudLink>
                                </MudPaper>

                                @if (sidebarRecentWork.Count > 0)
                                {
                                    <MudStack Spacing="1" Class="core-dashboard-recent-sidebar">
                                        @foreach (var item in sidebarRecentWork)
                                        {
                                            <MudPaper Class="pa-2 core-dashboard-recent-sidebar-item"
                                                      Elevation="0"
                                                      Outlined="true">
                                                <MudLink Href="@item.NavigationPath" Underline="Underline.None" Class="core-dashboard-recent-link">
                                                    <div class="core-dashboard-recent-sidebar-inner">
                                                        <AssetThumbnailImage AssetId="item.ThumbnailAssetId"
                                                                             FallbackSrc="@GetThumbnailFallback(item)"
                                                                             AltText="@item.Title"
                                                                             SizeKey="small"
                                                                             CssClass="core-dashboard-recent-thumb core-dashboard-recent-thumb-sidebar"
                                                                             ShowPlaceholder="false" />
                                                        <MudStack Spacing="0" Class="core-dashboard-recent-copy">
                                                            <MudText Typo="Typo.body2">@item.Title</MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                @GetModuleName(item.ModuleKey) · @FormatLastActive(item.LastAccessedAtUtc)
                                                            </MudText>
                                                        </MudStack>
                                                    </div>
                                                </MudLink>
                                            </MudPaper>
                                        }
                                    </MudStack>
                                }
                            </div>
                        }
                        else if (!HasActiveModules)
                        {
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle1">Get started</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Activate a craft module to begin tracking projects.
                                </MudText>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Href="/home/modules"
                                           StartIcon="@Icons.Material.Filled.Extension">
                                    Activate modules
                                </MudButton>
                            </MudStack>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    No recent projects yet. Open a project in an active module to see it here.
                                </MudText>
                                @if (activeModules.Count > 0)
                                {
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        @foreach (var module in activeModules)
                                        {
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Href="@GetModuleRoute(module)">
                                                Open @module.Name
                                            </MudButton>
                                        }
                                    </MudStack>
                                }
                            </MudStack>
                        }
                    </MudStack>
                </MudPaper>

                @if (LayoutPreferences.ShowQuickActions && GetQuickActionGroups().Count > 0)
                {
                    <MudPaper Class="pa-4 core-panel-mud core-dashboard-section" Elevation="1">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Quick actions</MudText>
                            @foreach (var group in GetQuickActionGroups())
                            {
                                <MudStack Spacing="1" Class="core-dashboard-quick-actions-group">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@group.ModuleName</MudText>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        @foreach (var action in group.Actions)
                                        {
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Href="@action.NavigationPath">
                                                @action.Label
                                            </MudButton>
                                        }
                                    </MudStack>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>
                }

                @if (LayoutPreferences.ShowDueSoon && overview?.DueSoonItems.Count > 0)
                {
                    <MudPaper Class="pa-4 core-panel-mud core-dashboard-section" Elevation="1">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Due soon</MudText>
                            @foreach (var item in overview.DueSoonItems)
                            {
                                <MudPaper Class="pa-2 core-dashboard-due-item" Elevation="0" Outlined="true">
                                    <MudLink Href="@item.NavigationPath" Underline="Underline.None" Class="core-dashboard-recent-link">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2">@item.Title</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @item.ModuleName · @FormatDueAt(item.DueAtUtc)
                                            </MudText>
                                        </MudStack>
                                    </MudLink>
                                </MudPaper>
                            }
                        </MudStack>
                    </MudPaper>
                }

                @if (IsAdmin && LayoutPreferences.ShowAdminHealth)
                {
                    <MudPaper Class="pa-4 core-panel-mud core-dashboard-section" Elevation="1">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Workbench health</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Database backups are manual today. Copy <code>App_Data/tankermade.db</code> before major changes or upgrades.
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                See deployment and export/import guidance in project docs for restore steps.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>

            @if (ShowEngagementSidebar)
            {
                <aside class="core-dashboard-sidebar">
                    <MudPaper Class="pa-4 core-panel-mud core-dashboard-section core-dashboard-engagement-panel" Elevation="1">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Engagement</MudText>
                            <MudText Typo="Typo.body2">@GetEngagementCopy()</MudText>
                            <DashboardActivityCalendar ActiveLocalDates="overview!.Activity.ActiveLocalDates" />
                        </MudStack>
                    </MudPaper>
                </aside>
            }
        </div>
    }
</div>
