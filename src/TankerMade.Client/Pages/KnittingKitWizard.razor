@page "/modules/knitting/kits/new"
@using TankerMade.Contracts.DTOs.Assets
@using TankerMade.Contracts.DTOs.ModuleKits
@using TankerMade.Contracts.DTOs.ModulePatterns
@using TankerMade.Contracts.DTOs.Reference
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession
@inject TankerMade.Client.Services.TankerMadeApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>New Knitting Kit</PageTitle>

<KnittingModuleGate Loading="!sessionReady" LoadingMessage="Loading...">
    <MudStack Spacing="3">
        <KnittingPageHeader Title="New Kit"
                            Subtitle="Plan kit pieces, supplies, and metadata before saving."
                            BackHref="/modules/knitting/kits"
                            BackLabel="Kits" />

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
        }

        <div class="wizard-shell">
            <nav class="wizard-steps" aria-label="Wizard steps">
                @foreach (var (step, label, index) in VisibleSteps.Select((entry, index) => (entry.Step, entry.Label, index)))
                {
                    var pillClass = step == currentStep ? "wizard-step-pill active" : index < CurrentStepPosition ? "wizard-step-pill complete" : "wizard-step-pill";
                    <span class="@pillClass">@label</span>
                }
            </nav>

            <MudPaper Class="pa-4 knitting-panel-mud" Elevation="1">
            @if (currentStep == KitWizardStep.Setup)
            {
                <MudText Typo="Typo.subtitle1">Kit Setup</MudText>
                <MudTextField @bind-Value="kitName" Label="Kit name" Variant="Variant.Outlined" />

                <div class="list-toolbar mt-3">
                    <MudSelect T="string" @bind-Value="typeFilter" @bind-Value:after="ApplyPatternFilters" Label="Type" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@string.Empty">Any</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Knit")">Knit</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Crochet")">Crochet</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="formFilter" @bind-Value:after="ApplyPatternFilters" Label="Form" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@string.Empty">Any</MudSelectItem>
                        <MudSelectItem T="string" Value="@("2D")">2D</MudSelectItem>
                        <MudSelectItem T="string" Value="@("3D")">3D</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="themeFilterIdText" @bind-Value:after="ApplyPatternFilters" Label="Theme" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@string.Empty">Any theme</MudSelectItem>
                        @foreach (var theme in themes)
                        {
                            <MudSelectItem T="string" Value="@theme.Id.ToString()">@theme.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="patternSearch" @bind-Value:after="ApplyPatternFilters" Label="Search patterns" Variant="Variant.Outlined" />
                </div>

                <MudCheckBox T="bool" @bind-Value="createNewPattern" @bind-Value:after="OnCreateNewPatternChanged" Label="Create a new pattern for inline steps" Color="Color.Primary" Class="mb-3" />

                @if (createNewPattern)
                {
                    <div class="form-grid">
                        <MudTextField @bind-Value="newPatternName" Label="New pattern name" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="newPatternType" Label="Type" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="newPatternForm" Label="Form" Variant="Variant.Outlined" />
                    </div>
                }
                else
                {
                    <MudSelect T="string" @bind-Value="selectedPatternIdText" @bind-Value:after="OnReferencePatternChanged" Label="Reference pattern (optional)" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@string.Empty">None</MudSelectItem>
                        @foreach (var pattern in filteredPatterns)
                        {
                            <MudSelectItem T="string" Value="@pattern.Id.ToString()">@pattern.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
            }
            else if (currentStep == KitWizardStep.Pieces)
            {
                <MudText Typo="Typo.subtitle1">Kit Pieces</MudText>

                @if (draftPieces.Count > 0)
                {
                    <ul class="project-supply-list mb-3">
                        @foreach (var piece in draftPieces)
                        {
                            <li>
                                <div>
                                    <strong>@piece.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(piece.Notes))
                                    {
                                        <span class="text-muted"> — @piece.Notes</span>
                                    }
                                    @if (piece.Steps.Count > 0)
                                    {
                                        <span class="text-muted"> (@piece.Steps.Count steps)</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }

                <div class="form-grid">
                    <MudTextField @bind-Value="draftPieceName" Label="Piece name" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="draftPieceNotes" Label="Notes" Variant="Variant.Outlined" />
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2" Disabled="busy" OnClick="AddDraftPiece">Add Piece</MudButton>

                @if (createNewPattern)
                {
                    <hr />
                    <MudText Typo="Typo.subtitle2">Inline Pattern Steps</MudText>
                    <div class="form-grid">
                        <MudTextField @bind-Value="draftStepLabel" Label="Step label" Variant="Variant.Outlined" />
                        <MudNumericField T="int?" @bind-Value="draftStartIndex" Label="Row start" Variant="Variant.Outlined" />
                        <MudNumericField T="int?" @bind-Value="draftEndIndex" Label="Row end" Variant="Variant.Outlined" />
                        <MudNumericField T="int?" @bind-Value="draftStitchCount" Label="Stitch count" Variant="Variant.Outlined" />
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-2" Disabled="busy" OnClick="AddDraftStep">Add Step to Last Piece</MudButton>
                }
            }
            else if (currentStep == KitWizardStep.Supplies)
            {
                <MudText Typo="Typo.subtitle1">Supplies</MudText>
                <div class="form-grid">
                    <MudSelect T="string" @bind-Value="supplyType" @bind-Value:after="LoadSupplyInventoryOptionsAsync" Label="Supply type" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("yarn")">Yarn</MudSelectItem>
                        <MudSelectItem T="string" Value="@("tool")">Tool</MudSelectItem>
                        <MudSelectItem T="string" Value="@("notion")">Notion</MudSelectItem>
                    </MudSelect>
                    <MudTextField @bind-Value="supplyName" Label="Name" Variant="Variant.Outlined" />
                    <MudSelect T="string" @bind-Value="selectedSupplyInventoryIdText" @bind-Value:after="OnSupplyInventoryChanged" Label="Inventory item (optional)" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@string.Empty">Manual name only</MudSelectItem>
                        @foreach (var option in supplyInventoryOptions)
                        {
                            <MudSelectItem T="string" Value="@option.Id.ToString()">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField T="decimal?" @bind-Value="supplyQuantity" Label="Quantity" Variant="Variant.Outlined" />
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2" Disabled="busy" OnClick="AddDraftSupply">Add Supply</MudButton>

                @if (draftSupplies.Count > 0)
                {
                    <ul class="project-supply-list mt-3">
                        @foreach (var supply in draftSupplies)
                        {
                            <li>
                                <div>
                                    <strong>@supply.Name</strong>
                                    <span class="text-muted">(@supply.SupplyType)</span>
                                </div>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="busy" OnClick="@(() => draftSupplies.Remove(supply))">Remove</MudButton>
                            </li>
                        }
                    </ul>
                }
            }
            else if (currentStep == KitWizardStep.Metadata)
            {
                <MudText Typo="Typo.subtitle1">Kit Metadata</MudText>
                <div class="knitting-hero-card mb-3">
                    @if (uploadedAssetId.HasValue)
                    {
                        <AssetThumbnailImage AssetId="uploadedAssetId" AltText="Kit image preview" />
                    }
                    else
                    {
                        <div class="asset-thumbnail-placeholder">No image yet</div>
                    }
                    <div>
                        <MudText Typo="Typo.body2">Kit image</MudText>
                        <InputFile OnChange="UploadKitImageAsync" disabled="@busy" />
                    </div>
                </div>
                <MudTextField @bind-Value="kitDescription" Label="Description" Variant="Variant.Outlined" Lines="3" />
                <div class="mt-3">
                    <MudText Typo="Typo.body2">Difficulty</MudText>
                    <DifficultyPicker @bind-Value="kitDifficulty" Disabled="busy" />
                </div>
            }
            else
            {
                <MudText Typo="Typo.subtitle1">Finalize Kit</MudText>
                <article class="project-card kit-card-with-image">
                    @if (uploadedAssetId.HasValue)
                    {
                        <AssetThumbnailImage AssetId="uploadedAssetId" AltText="Kit preview" />
                    }
                    else
                    {
                        <div class="asset-thumbnail-placeholder">No image</div>
                    }
                    <div>
                        <h3>@kitName</h3>
                        <p><KnittingDifficultyBadge Difficulty="kitDifficulty" /></p>
                        <p class="mb-1"><strong>Pieces:</strong> @draftPieces.Count</p>
                        <p class="mb-0"><strong>Supplies:</strong> @draftSupplies.Count</p>
                    </div>
                </article>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" Disabled="busy" OnClick="FinalizeKitAsync">Create Kit</MudButton>
            }

            @if (currentStep != KitWizardStep.Finalize)
            {
                <MudStack Row="true" Spacing="1" Class="mt-3">
                    @if (CurrentStepPosition > 0)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="busy" OnClick="PreviousStep">Back</MudButton>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="NextStep">Next</MudButton>
                </MudStack>
            }
            else if (CurrentStepPosition > 0)
            {
                <MudStack Row="true" Spacing="1" Class="mt-3">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="busy" OnClick="PreviousStep">Back</MudButton>
                </MudStack>
            }
            </MudPaper>
        </div>
    </MudStack>
</KnittingModuleGate>

@code {
    private const string ModuleKey = "knitting";
    private const string KitRecordType = "kit";

    private enum KitWizardStep
    {
        Setup,
        Pieces,
        Supplies,
        Metadata,
        Finalize
    }

    private readonly List<ModulePatternDto> allPatterns = [];
    private readonly List<ModulePatternDto> filteredPatterns = [];
    private readonly List<CoreReferenceItemDto> themes = [];
    private readonly List<DraftKitPiece> draftPieces = [];
    private readonly List<DraftKitSupply> draftSupplies = [];
    private readonly List<InventoryOption> supplyInventoryOptions = [];

    private KitWizardStep currentStep = KitWizardStep.Setup;
    private bool sessionReady;
    private bool busy;
    private bool createNewPattern;
    private string errorMessage = string.Empty;
    private string kitName = string.Empty;
    private string kitDescription = string.Empty;
    private int kitDifficulty = 1;
    private Guid? uploadedAssetId;
    private string typeFilter = string.Empty;
    private string formFilter = string.Empty;
    private string themeFilterIdText = string.Empty;
    private string patternSearch = string.Empty;
    private string selectedPatternIdText = string.Empty;
    private string newPatternName = string.Empty;
    private string newPatternType = "Knit";
    private string newPatternForm = "2D";
    private string draftPieceName = string.Empty;
    private string draftPieceNotes = string.Empty;
    private string draftStepLabel = string.Empty;
    private int? draftStartIndex;
    private int? draftEndIndex;
    private int? draftStitchCount;
    private string supplyType = "yarn";
    private string supplyName = string.Empty;
    private string selectedSupplyInventoryIdText = string.Empty;
    private decimal? supplyQuantity;

    private IEnumerable<(KitWizardStep Step, string Label)> VisibleSteps
    {
        get
        {
            yield return (KitWizardStep.Setup, "Setup");
            yield return (KitWizardStep.Pieces, "Pieces");
            yield return (KitWizardStep.Supplies, "Supplies");
            yield return (KitWizardStep.Metadata, "Details");
            yield return (KitWizardStep.Finalize, "Create");
        }
    }

    private int CurrentStepPosition => VisibleSteps.ToList().FindIndex(entry => entry.Step == currentStep);

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.InitializeAsync();
        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
        }

        sessionReady = true;
        themes.AddRange(await ApiClient.GetCoreReferenceItemsAsync("themes"));
        await LoadPatternsAsync();
    }

    private async Task LoadPatternsAsync()
    {
        try
        {
            allPatterns.Clear();
            allPatterns.AddRange(await ApiClient.GetModulePatternsAsync(ModuleKey));
            ApplyPatternFilters();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ApplyPatternFilters()
    {
        filteredPatterns.Clear();
        Guid? themeFilterId = Guid.TryParse(themeFilterIdText, out var parsedThemeId) ? parsedThemeId : null;

        filteredPatterns.AddRange(allPatterns.Where(pattern =>
            (string.IsNullOrWhiteSpace(typeFilter) || pattern.Type.Equals(typeFilter, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrWhiteSpace(formFilter) || pattern.Form.Equals(formFilter, StringComparison.OrdinalIgnoreCase))
            && (!themeFilterId.HasValue || pattern.ThemeId == themeFilterId)
            && (string.IsNullOrWhiteSpace(patternSearch)
                || pattern.Name.Contains(patternSearch, StringComparison.OrdinalIgnoreCase))));
    }

    private async Task OnReferencePatternChanged()
    {
        if (!Guid.TryParse(selectedPatternIdText, out var patternId))
        {
            return;
        }

        var pattern = await ApiClient.GetModulePatternAsync(ModuleKey, patternId);
        if (pattern == null)
        {
            return;
        }

        draftPieces.Clear();
        foreach (var piece in pattern.Pieces)
        {
            draftPieces.Add(new DraftKitPiece
            {
                Name = piece.Name,
                Notes = $"From pattern {pattern.Name}"
            });
        }
    }

    private void OnCreateNewPatternChanged()
    {
        if (createNewPattern && draftPieces.Count == 0)
        {
            draftPieceName = "Piece 1";
        }
    }

    private void AddDraftPiece()
    {
        if (string.IsNullOrWhiteSpace(draftPieceName))
        {
            errorMessage = "Enter a piece name.";
            return;
        }

        draftPieces.Add(new DraftKitPiece
        {
            Name = draftPieceName.Trim(),
            Notes = draftPieceNotes.Trim()
        });

        draftPieceName = $"Piece {draftPieces.Count + 1}";
        draftPieceNotes = string.Empty;
        errorMessage = string.Empty;
    }

    private void AddDraftStep()
    {
        if (draftPieces.Count == 0)
        {
            errorMessage = "Add a piece before adding steps.";
            return;
        }

        var piece = draftPieces[^1];
        piece.Steps.Add(new DraftStep
        {
            Label = string.IsNullOrWhiteSpace(draftStepLabel) ? $"Step {piece.Steps.Count + 1}" : draftStepLabel.Trim(),
            StartIndex = draftStartIndex,
            EndIndex = draftEndIndex,
            StitchCount = draftStitchCount
        });

        draftStepLabel = string.Empty;
        draftStartIndex = null;
        draftEndIndex = null;
        draftStitchCount = null;
        errorMessage = string.Empty;
    }

    private async Task LoadSupplyInventoryOptionsAsync()
    {
        supplyInventoryOptions.Clear();
        selectedSupplyInventoryIdText = string.Empty;

        switch (supplyType)
        {
            case "tool":
                foreach (var tool in await ApiClient.GetModuleToolsAsync(ModuleKey))
                {
                    supplyInventoryOptions.Add(new InventoryOption(tool.Id, $"{tool.BrandName} - {tool.TypeName}"));
                }

                break;
            case "notion":
                foreach (var notion in await ApiClient.GetModuleNotionsAsync(ModuleKey))
                {
                    supplyInventoryOptions.Add(new InventoryOption(notion.Id, $"{notion.BrandName} - {notion.TypeName}"));
                }

                break;
            default:
                foreach (var yarn in await ApiClient.GetModuleYarnsAsync(ModuleKey))
                {
                    supplyInventoryOptions.Add(new InventoryOption(yarn.Id, $"{yarn.BrandName} - {yarn.ColorName}"));
                }

                break;
        }
    }

    private void OnSupplyInventoryChanged()
    {
        if (!Guid.TryParse(selectedSupplyInventoryIdText, out var inventoryId))
        {
            return;
        }

        var selected = supplyInventoryOptions.FirstOrDefault(option => option.Id == inventoryId);
        if (selected != null && string.IsNullOrWhiteSpace(supplyName))
        {
            supplyName = selected.Label;
        }
    }

    private void AddDraftSupply()
    {
        if (string.IsNullOrWhiteSpace(supplyName))
        {
            errorMessage = "Enter a supply name.";
            return;
        }

        draftSupplies.Add(new DraftKitSupply
        {
            SupplyType = supplyType,
            Name = supplyName.Trim(),
            InventoryItemId = Guid.TryParse(selectedSupplyInventoryIdText, out var inventoryId) ? inventoryId : null,
            Quantity = supplyQuantity
        });

        supplyName = string.Empty;
        selectedSupplyInventoryIdText = string.Empty;
        supplyQuantity = null;
        errorMessage = string.Empty;
    }

    private async Task UploadKitImageAsync(InputFileChangeEventArgs args)
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            var asset = await ApiClient.UploadAssetAsync(ModuleKey, args.File);
            uploadedAssetId = asset.Id;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void NextStep()
    {
        if (!ValidateCurrentStep())
        {
            return;
        }

        var steps = VisibleSteps.ToList();
        var index = steps.FindIndex(entry => entry.Step == currentStep);
        if (index >= 0 && index < steps.Count - 1)
        {
            currentStep = steps[index + 1].Step;
            errorMessage = string.Empty;

            if (currentStep == KitWizardStep.Supplies && supplyInventoryOptions.Count == 0)
            {
                _ = LoadSupplyInventoryOptionsAsync();
            }
        }
    }

    private void PreviousStep()
    {
        var steps = VisibleSteps.ToList();
        var index = steps.FindIndex(entry => entry.Step == currentStep);
        if (index > 0)
        {
            currentStep = steps[index - 1].Step;
            errorMessage = string.Empty;
        }
    }

    private bool ValidateCurrentStep()
    {
        errorMessage = string.Empty;

        switch (currentStep)
        {
            case KitWizardStep.Setup:
                if (string.IsNullOrWhiteSpace(kitName))
                {
                    errorMessage = "Enter a kit name.";
                    return false;
                }

                if (createNewPattern && string.IsNullOrWhiteSpace(newPatternName))
                {
                    errorMessage = "Enter a name for the new pattern.";
                    return false;
                }

                return true;
            case KitWizardStep.Pieces:
                if (draftPieces.Count == 0)
                {
                    errorMessage = "Add at least one kit piece.";
                    return false;
                }

                return true;
            default:
                return true;
        }
    }

    private async Task FinalizeKitAsync()
    {
        if (!ValidateCurrentStep())
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            if (createNewPattern && draftPieces.Any(piece => piece.Steps.Count > 0))
            {
                var pattern = await ApiClient.CreateModulePatternAsync(ModuleKey, new CreateModulePatternRequest
                {
                    Name = newPatternName.Trim(),
                    Type = newPatternType.Trim(),
                    Form = newPatternForm.Trim(),
                    Difficulty = KnittingUi.DifficultyLabel(kitDifficulty)
                });

                foreach (var draftPiece in draftPieces.Where(piece => piece.Steps.Count > 0))
                {
                    var piece = await ApiClient.AddModulePatternPieceAsync(ModuleKey, pattern.Id, new CreateModulePatternPieceRequest
                    {
                        Name = draftPiece.Name
                    });

                    if (piece == null)
                    {
                        continue;
                    }

                    foreach (var step in draftPiece.Steps)
                    {
                        await ApiClient.AddModulePatternStepAsync(ModuleKey, pattern.Id, piece.Id, new CreateModulePatternStepRequest
                        {
                            Label = step.Label,
                            StartIndex = step.StartIndex,
                            EndIndex = step.EndIndex,
                            StitchCount = step.StitchCount
                        });
                    }
                }
            }

            var description = kitDescription.Trim();
            var difficultyLabel = KnittingUi.DifficultyLabel(kitDifficulty);
            if (!description.Contains(difficultyLabel, StringComparison.OrdinalIgnoreCase))
            {
                description = string.IsNullOrWhiteSpace(description)
                    ? $"Difficulty: {difficultyLabel}"
                    : $"{description}{Environment.NewLine}Difficulty: {difficultyLabel}";
            }

            var kit = await ApiClient.CreateModuleKitAsync(ModuleKey, new CreateModuleKitRequest
            {
                Name = kitName.Trim(),
                Description = description,
                Type = createNewPattern ? newPatternType.Trim() : typeFilter.Trim()
            });

            foreach (var piece in draftPieces)
            {
                await ApiClient.AddModuleKitPieceAsync(ModuleKey, kit.Id, new CreateModuleKitPieceRequest
                {
                    Name = piece.Name,
                    Notes = piece.Notes
                });
            }

            foreach (var supply in draftSupplies)
            {
                await ApiClient.AddModuleKitSupplyAsync(ModuleKey, kit.Id, new CreateModuleKitSupplyRequest
                {
                    SupplyType = supply.SupplyType,
                    Name = supply.Name,
                    InventoryItemId = supply.InventoryItemId,
                    Quantity = supply.Quantity
                });
            }

            if (uploadedAssetId.HasValue)
            {
                await ApiClient.AssignAssetAsync(uploadedAssetId.Value, new AssetAssignmentRequest
                {
                    ModuleKey = ModuleKey,
                    RecordType = KitRecordType,
                    RecordId = kit.Id
                });
            }

            Navigation.NavigateTo("/modules/knitting/kits");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class DraftKitPiece
    {
        public string Name { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
        public List<DraftStep> Steps { get; } = [];
    }

    private sealed class DraftStep
    {
        public string Label { get; set; } = string.Empty;
        public int? StartIndex { get; set; }
        public int? EndIndex { get; set; }
        public int? StitchCount { get; set; }
    }

    private sealed class DraftKitSupply
    {
        public string SupplyType { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public Guid? InventoryItemId { get; set; }
        public decimal? Quantity { get; set; }
    }

    private sealed record InventoryOption(Guid Id, string Label);
}
