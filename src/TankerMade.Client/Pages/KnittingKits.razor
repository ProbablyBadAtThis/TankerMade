        [System.ComponentModel.DataAnnotations.StringLength(1000, ErrorMessage = "Description cannot exceed 1000 characters")]
        public string Description { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(100, ErrorMessage = "Type cannot exceed 100 characters")]
        public string Type { get; set; } = string.Empty;
    }

    private class KitPieceFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Piece name is required")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Piece name cannot exceed 200 characters")]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(1000, ErrorMessage = "Notes cannot exceed 1000 characters")]
        public string Notes { get; set; } = string.Empty;
    }

    private class KitSupplyFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Supply type is required")]
        [System.ComponentModel.DataAnnotations.StringLength(100, ErrorMessage = "Supply type cannot exceed 100 characters")]
        public string SupplyType { get; set; } = "yarn";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Supply name is required")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Supply name cannot exceed 200 characters")]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Range(typeof(decimal), "0.01", "999999", ErrorMessage = "Quantity must be greater than 0")]
        public decimal? Quantity { get; set; }
    }
