@page "/modules/sewing"
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession

<PageTitle>Sewing</PageTitle>

<div class="module-shell module-shell-sewing">
    <header class="module-hero">
        <h1>Sewing</h1>
        <p>Module home for garment and craft sewing workflows, patterns, and supplies.</p>
    </header>

    @if (!AuthSession.IsSignedIn)
    {
        <section class="module-card">
            <h2>Sign In Required</h2>
            <p>Sign in to open and test this module.</p>
            <a class="btn btn-primary" href="login">Sign in</a>
        </section>
    }
    else if (!ModuleState.IsActive("sewing"))
    {
        <section class="module-card">
            <h2>Module Not Active</h2>
            <p>Activate Sewing from Home to continue.</p>
            <a class="btn btn-outline-primary" href="/">Go to Home</a>
        </section>
    }
    else
    {
        <section class="module-grid">
            <article class="module-card">
                <h2>In Progress</h2>
                <p>Track sewing projects from prep and cutting through finishing.</p>
                <span class="module-pill">Projects</span>
            </article>
            <article class="module-card">
                <h2>Pattern Set</h2>
                <p>Maintain module-owned pattern templates and per-piece instructions.</p>
                <span class="module-pill">Patterns</span>
            </article>
            <article class="module-card">
                <h2>Fabric Stock</h2>
                <p>Log fabric, notions, and tool availability for project planning.</p>
                <span class="module-pill">Inventory</span>
            </article>
        </section>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthSession.InitializeAsync();
        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
        }
    }
}
