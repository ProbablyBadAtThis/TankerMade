@page "/modules/printing-3d"
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession

<PageTitle>3D Printing</PageTitle>

@if (!AuthSession.IsSignedIn)
{
    <h1>3D Printing</h1>
    <p>Sign in to open the 3D Printing module.</p>
    <a class="btn btn-primary" href="login">Sign in</a>
}
else if (!ModuleState.IsActive("printing-3d"))
{
    <h1>3D Printing</h1>
    <p>Activate the 3D Printing module from Home to continue.</p>
}
else
{
    <h1>3D Printing</h1>
    <p>Module home for active 3D printing work.</p>

    <div class="d-flex flex-wrap gap-2 mt-3">
        <a class="btn btn-primary" href="/modules/printing-3d/inventory">Inventory</a>
        <a class="btn btn-outline-secondary" href="/modules/printing-3d/projects">Projects</a>
        <a class="btn btn-outline-secondary" href="/modules/printing-3d/patterns">Patterns</a>
        <a class="btn btn-outline-secondary" href="/modules/printing-3d/queue">Queue</a>
        <a class="btn btn-outline-secondary" href="/modules/printing-3d/settings">Settings</a>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthSession.InitializeAsync();
        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
        }
    }
}
