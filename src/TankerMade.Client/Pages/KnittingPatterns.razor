@page "/modules/knitting/patterns"
@using TankerMade.Contracts.DTOs.ModulePatterns
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession
@inject TankerMade.Client.Services.TankerMadeApiClient ApiClient
@inject TankerMade.Client.Services.KnittingCardAssetCache CardAssets

<PageTitle>Knitting Patterns</PageTitle>

<KnittingModuleGate Loading="loading" LoadingMessage="Loading patterns...">
    <MudStack Spacing="3">
        <KnittingPageHeader Title="Patterns"
                            Subtitle="Module-owned knitting pattern records via core extension-point APIs." />

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modules/knitting/patterns/new">
            New Pattern Wizard
        </MudButton>

        <MudPaper Class="pa-4 knitting-panel-mud" Elevation="1">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1">@(selectedPatternId.HasValue ? "Update Pattern" : "Quick Create")</MudText>
                <EditForm Model="form" OnValidSubmit="SavePatternAsync">
                    <DataAnnotationsValidator />
                    <MudStack Spacing="2">
                        <div class="knitting-list-toolbar-mud">
                            <MudTextField @bind-Value="form.Name" Label="Name" Variant="Variant.Outlined" Required="true" />
                            <MudTextField @bind-Value="form.Type" Label="Type" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="form.Form" Label="Form" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="form.Difficulty" Label="Difficulty" Variant="Variant.Outlined" />
                            <MudSelect T="string" @bind-Value="form.ThemeIdText" Label="Theme" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@string.Empty">No theme</MudSelectItem>
                                @foreach (var theme in themes)
                                {
                                    <MudSelectItem T="string" Value="@theme.Id.ToString()">@theme.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="form.ColorIdText" Label="Main color" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@string.Empty">No color</MudSelectItem>
                                @foreach (var color in colors)
                                {
                                    <MudSelectItem T="string" Value="@color.Id.ToString()">@color.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="form.SourceIdText" Label="Source" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@string.Empty">No source</MudSelectItem>
                                @foreach (var source in sources)
                                {
                                    <MudSelectItem T="string" Value="@source.Id.ToString()">@source.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField @bind-Value="form.SuggestedYarnWeight" Label="Suggested yarn weight" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="form.SuggestedNeedleSizes" Label="Suggested needle sizes" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="form.RequiredNotions" Label="Required notions" Variant="Variant.Outlined" />
                        </div>
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="busy">
                                @(selectedPatternId.HasValue ? "Save Changes" : "Create Pattern")
                            </MudButton>
                            @if (selectedPatternId.HasValue)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="busy" OnClick="ResetForm">Cancel Edit</MudButton>
                            }
                        </MudStack>
                    </MudStack>
                </EditForm>
            </MudStack>
        </MudPaper>

        <div class="knitting-list-toolbar-mud">
            <MudTextField @bind-Value="search"
                          @bind-Value:after="ApplyFiltersAsync"
                          Label="Search"
                          Variant="Variant.Outlined"
                          Placeholder="Filter as you type"
                          Immediate="true" />
            <MudSelect T="string" @bind-Value="sortBy" @bind-Value:after="ApplyFiltersAsync" Label="Sort" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@("recent")">Date added</MudSelectItem>
                <MudSelectItem T="string" Value="@("name")">Name</MudSelectItem>
                <MudSelectItem T="string" Value="@("steps")">Step count</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" @bind-Value="filterThemeId" @bind-Value:after="ApplyFiltersAsync" Label="Theme" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@string.Empty">All themes</MudSelectItem>
                @foreach (var theme in themes)
                {
                    <MudSelectItem T="string" Value="@theme.Id.ToString()">@theme.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="filterSourceId" @bind-Value:after="ApplyFiltersAsync" Label="Source" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@string.Empty">All sources</MudSelectItem>
                @foreach (var source in sources)
                {
                    <MudSelectItem T="string" Value="@source.Id.ToString()">@source.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="filterColorId" @bind-Value:after="ApplyFiltersAsync" Label="Color" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@string.Empty">All colors</MudSelectItem>
                @foreach (var color in colors)
                {
                    <MudSelectItem T="string" Value="@color.Id.ToString()">@color.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="filterDifficulty" @bind-Value:after="ApplyFiltersAsync" Label="Difficulty" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@string.Empty">All</MudSelectItem>
                <MudSelectItem T="string" Value="@("1")">Beginner</MudSelectItem>
                <MudSelectItem T="string" Value="@("2")">Beginner+</MudSelectItem>
                <MudSelectItem T="string" Value="@("3")">Intermediate</MudSelectItem>
                <MudSelectItem T="string" Value="@("4")">Intermediate+</MudSelectItem>
                <MudSelectItem T="string" Value="@("5")">Advanced</MudSelectItem>
                <MudSelectItem T="string" Value="@("6")">Advanced+</MudSelectItem>
            </MudSelect>
        </div>

        @if (pagedPatterns.Count == 0 && filteredPatterns.Count == 0)
        {
            <MudPaper Class="pa-6 knitting-panel-mud" Elevation="1">
                <MudStack Spacing="1" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">No Patterns Yet</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Create your first knitting pattern to start building module-owned workflows.</MudText>
                </MudStack>
            </MudPaper>
        }
        else
        {
            <div class="knitting-card-grid-mud">
                @foreach (var pattern in pagedPatterns)
                {
                    var assetId = patternAssetIds.GetValueOrDefault(pattern.Id);
                    <MudPaper Class="knitting-card-mud pattern-card-with-image" Elevation="1">
                        <AssetThumbnailImage AssetId="assetId" AltText="@pattern.Name" />
                        <div class="pa-3 knitting-card-mud-body">
                            <MudText Typo="Typo.h6">@pattern.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@DisplayMetadata(pattern)</MudText>
                            <div class="pattern-card-stats">
                                <KnittingDifficultyBadge DifficultyText="@(string.IsNullOrWhiteSpace(pattern.Difficulty) ? "Unspecified" : pattern.Difficulty)" />
                                <span>@pattern.PieceCount pieces</span>
                                <span>@pattern.StepCount steps</span>
                                <span>@(string.IsNullOrWhiteSpace(pattern.ThemeName) ? "No theme" : pattern.ThemeName)</span>
                                <span>@(string.IsNullOrWhiteSpace(pattern.ColorName) ? "No color" : pattern.ColorName)</span>
                                <span>@(string.IsNullOrWhiteSpace(pattern.SourceName) ? "No source" : pattern.SourceName)</span>
                            </div>
                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="knitting-card-mud-actions">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Href="@($"/modules/knitting/patterns/{pattern.Id}")">Open</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Disabled="busy" OnClick="@(() => StartEdit(pattern))">Edit</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="busy" OnClick="@(() => DeletePatternAsync(pattern.Id))">Delete</MudButton>
                            </MudStack>
                        </div>
                    </MudPaper>
                }
            </div>
            @if (filteredPatterns.Count > patternPageSize)
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudButton Variant="Variant.Outlined" Disabled="@(patternPage <= 1 || busy)" OnClick="PreviousPatternPage">Previous</MudButton>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Page @patternPage of @PatternPageCount</MudText>
                    <MudButton Variant="Variant.Outlined" Disabled="@(patternPage >= PatternPageCount || busy)" OnClick="NextPatternPage">Next</MudButton>
                </MudStack>
            }
        }
    </MudStack>
</KnittingModuleGate>

@code {
    private const string ModuleKey = "knitting";
    private readonly List<ModulePatternDto> patterns = [];
    private readonly List<ModulePatternDto> filteredPatterns = [];
    private readonly List<ModulePatternDto> pagedPatterns = [];
    private readonly Dictionary<Guid, Guid?> patternAssetIds = [];
    private readonly List<TankerMade.Contracts.DTOs.Reference.CoreReferenceItemDto> themes = [];
    private readonly List<TankerMade.Contracts.DTOs.Reference.CoreReferenceItemDto> colors = [];
    private readonly List<TankerMade.Contracts.DTOs.Reference.CoreReferenceItemDto> sources = [];
    private string search = string.Empty;
    private string sortBy = "recent";
    private string filterThemeId = string.Empty;
    private string filterSourceId = string.Empty;
    private string filterColorId = string.Empty;
    private string filterDifficulty = string.Empty;
    private int patternPage = 1;
    private const int patternPageSize = 12;
    private PatternFormModel form = new();
    private Guid? selectedPatternId;
    private bool loading = true;
    private bool busy;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.InitializeAsync();
        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
        }

        await LoadPatternsAsync();
    }

    private async Task LoadPatternsAsync()
    {
        loading = true;
        errorMessage = string.Empty;

        try
        {
            if (!AuthSession.IsSignedIn || !ModuleState.IsActive(ModuleKey))
            {
                return;
            }

            themes.Clear();
            themes.AddRange(await ApiClient.GetCoreReferenceItemsAsync("themes"));
            colors.Clear();
            colors.AddRange(await ApiClient.GetCoreReferenceItemsAsync("colors"));
            sources.Clear();
            sources.AddRange(await ApiClient.GetCoreReferenceItemsAsync("sources"));
            patterns.Clear();
            patterns.AddRange(await ApiClient.GetModulePatternsAsync(ModuleKey));
            CardAssets.InvalidateAll();
            patternAssetIds.Clear();
            var assets = await CardAssets.GetAssetsAsync(ModuleKey, "pattern");
            foreach (var pattern in patterns)
            {
                patternAssetIds[pattern.Id] = assets.FirstOrDefault(asset => asset.RecordId == pattern.Id)?.Id;
            }

            ApplyFilters();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private Task ApplyFiltersAsync()
    {
        ApplyFilters();
        return Task.CompletedTask;
    }

    private void ApplyFilters()
    {
        filteredPatterns.Clear();
        IEnumerable<ModulePatternDto> query = patterns;

        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(pattern =>
                pattern.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                || pattern.Type.Contains(search, StringComparison.OrdinalIgnoreCase)
                || pattern.Form.Contains(search, StringComparison.OrdinalIgnoreCase)
                || pattern.ThemeName.Contains(search, StringComparison.OrdinalIgnoreCase)
                || pattern.SourceName.Contains(search, StringComparison.OrdinalIgnoreCase)
                || pattern.Difficulty.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        if (Guid.TryParse(filterThemeId, out var themeId))
        {
            query = query.Where(pattern => pattern.ThemeId == themeId);
        }

        if (Guid.TryParse(filterSourceId, out var sourceId))
        {
            query = query.Where(pattern => pattern.SourceId == sourceId);
        }

        if (Guid.TryParse(filterColorId, out var colorId))
        {
            query = query.Where(pattern => pattern.ColorId == colorId);
        }

        if (int.TryParse(filterDifficulty, out var difficulty) && difficulty > 0)
        {
            var label = KnittingUi.DifficultyLabel(difficulty);
            query = query.Where(pattern =>
                string.Equals(pattern.Difficulty, label, StringComparison.OrdinalIgnoreCase)
                || KnittingUi.ParseDifficulty(pattern.Difficulty) == difficulty);
        }

        query = sortBy switch
        {
            "name" => query.OrderBy(pattern => pattern.Name),
            "steps" => query.OrderByDescending(pattern => pattern.StepCount),
            _ => query.OrderByDescending(pattern => pattern.CreatedAt)
        };

        filteredPatterns.AddRange(query);
        patternPage = 1;
        ApplyPatternPagination();
    }

    private int PatternPageCount => filteredPatterns.Count == 0
        ? 1
        : (int)Math.Ceiling(filteredPatterns.Count / (double)patternPageSize);

    private void ApplyPatternPagination()
    {
        pagedPatterns.Clear();
        if (filteredPatterns.Count == 0)
        {
            return;
        }

        var skip = (patternPage - 1) * patternPageSize;
        pagedPatterns.AddRange(filteredPatterns.Skip(skip).Take(patternPageSize));
    }

    private void PreviousPatternPage()
    {
        if (patternPage > 1)
        {
            patternPage--;
            ApplyPatternPagination();
        }
    }

    private void NextPatternPage()
    {
        if (patternPage < PatternPageCount)
        {
            patternPage++;
            ApplyPatternPagination();
        }
    }

    private async Task SavePatternAsync()
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            if (selectedPatternId.HasValue)
            {
                await ApiClient.UpdateModulePatternAsync(ModuleKey, selectedPatternId.Value, new UpdateModulePatternRequest
                {
                    Name = form.Name,
                    Type = form.Type,
                    Form = form.Form,
                    Difficulty = form.Difficulty,
                    ThemeId = ParseOptionalGuid(form.ThemeIdText),
                    ColorId = ParseOptionalGuid(form.ColorIdText),
                    SourceId = ParseOptionalGuid(form.SourceIdText),
                    SuggestedYarnWeight = form.SuggestedYarnWeight,
                    SuggestedNeedleSizes = form.SuggestedNeedleSizes,
                    RequiredNotions = form.RequiredNotions
                });
            }
            else
            {
                await ApiClient.CreateModulePatternAsync(ModuleKey, new CreateModulePatternRequest
                {
                    Name = form.Name,
                    Type = form.Type,
                    Form = form.Form,
                    Difficulty = form.Difficulty,
                    ThemeId = ParseOptionalGuid(form.ThemeIdText),
                    ColorId = ParseOptionalGuid(form.ColorIdText),
                    SourceId = ParseOptionalGuid(form.SourceIdText),
                    SuggestedYarnWeight = form.SuggestedYarnWeight,
                    SuggestedNeedleSizes = form.SuggestedNeedleSizes,
                    RequiredNotions = form.RequiredNotions
                });
            }

            ResetForm();
            await LoadPatternsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeletePatternAsync(Guid patternId)
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.DeleteModulePatternAsync(ModuleKey, patternId);
            if (selectedPatternId == patternId)
            {
                ResetForm();
            }

            await LoadPatternsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void StartEdit(ModulePatternDto pattern)
    {
        selectedPatternId = pattern.Id;
        form = new PatternFormModel
        {
            Name = pattern.Name,
            Type = pattern.Type,
            Form = pattern.Form,
            Difficulty = pattern.Difficulty,
            ThemeIdText = pattern.ThemeId?.ToString() ?? string.Empty,
            ColorIdText = pattern.ColorId?.ToString() ?? string.Empty,
            SourceIdText = pattern.SourceId?.ToString() ?? string.Empty,
            SuggestedYarnWeight = pattern.SuggestedYarnWeight,
            SuggestedNeedleSizes = pattern.SuggestedNeedleSizes,
            RequiredNotions = pattern.RequiredNotions
        };
    }

    private void ResetForm()
    {
        selectedPatternId = null;
        form = new PatternFormModel();
    }

    private static Guid? ParseOptionalGuid(string? value)
        => Guid.TryParse(value, out var parsed) ? parsed : null;

    private static string DisplayMetadata(ModulePatternDto pattern)
    {
        var parts = new[] { pattern.Type, pattern.Form, pattern.Difficulty }
            .Where(part => !string.IsNullOrWhiteSpace(part));

        return string.Join(" - ", parts);
    }

    private class PatternFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Name is required")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Name cannot exceed 200 characters")]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(100, ErrorMessage = "Type cannot exceed 100 characters")]
        public string Type { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(100, ErrorMessage = "Form cannot exceed 100 characters")]
        public string Form { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(100, ErrorMessage = "Difficulty cannot exceed 100 characters")]
        public string Difficulty { get; set; } = string.Empty;

        public string ThemeIdText { get; set; } = string.Empty;

        public string ColorIdText { get; set; } = string.Empty;

        public string SourceIdText { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(100, ErrorMessage = "Suggested yarn weight cannot exceed 100 characters")]
        public string SuggestedYarnWeight { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Suggested needle sizes cannot exceed 200 characters")]
        public string SuggestedNeedleSizes { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(500, ErrorMessage = "Required notions cannot exceed 500 characters")]
        public string RequiredNotions { get; set; } = string.Empty;
    }
}
