@page "/modules/crafting/projects/{ProjectId:guid}"
@implements IDisposable
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession
@inject TankerMade.Client.Services.TankerMadeApiClient ApiClient

<PageTitle>@(project?.Name ?? "Project")</PageTitle>

@if (!AuthSession.IsSignedIn)
{
    <h1>Project</h1>
    <p>Sign in to load Crafting projects.</p>
    <a class="btn btn-primary" href="login">Sign in</a>
}
else if (!ModuleState.IsActive("crafting"))
{
    <h1>Project</h1>
    <p>Activate the Crafting module from Home to load its tools.</p>
}
else if (loading)
{
    <h1>Project</h1>
    <p>Loading...</p>
}
else if (project == null)
{
    <h1>Project Not Found</h1>
    <p>This Crafting project is not available.</p>
    <a class="btn btn-primary" href="modules/crafting/projects">Projects</a>
}
else
{
    <div class="pattern-detail">
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-warning">@errorMessage</div>
        }

        <div class="pattern-header">
            <div>
                <a class="pattern-back-link" href="modules/crafting/projects">Projects</a>
                <h1>@project.Name</h1>
                <p>@ProjectMeta</p>
                @if (project.IsArchived)
                {
                    <span class="archive-badge">Archived</span>
                }
            </div>
            <div class="pattern-stats" aria-label="Project summary">
                <div>
                    <strong>@($"{project.Progress}%")</strong>
                    <span>Progress</span>
                </div>
                <div>
                    <strong>@PatternPieceCount</strong>
                    <span>Pieces</span>
                </div>
                <div>
                    <strong>@PatternStepCount</strong>
                    <span>Steps</span>
                </div>
                <div>
                    <strong>@ChecklistText</strong>
                    <span>Done</span>
                </div>
                <div>
                    <strong>@TrackedTimeText</strong>
                    <span>Time</span>
                </div>
            </div>
        </div>

        <div class="project-workspace">
            <section class="project-panel">
                <h2>Workspace Setup</h2>
                <EditForm Model="form" OnValidSubmit="SaveAsync" class="project-edit-form">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <label>
                        <span>Name</span>
                        <InputText class="form-control" @bind-Value="form.Name" />
                    </label>

                    <label>
                        <span>Description</span>
                        <InputTextArea class="form-control" @bind-Value="form.Description" />
                    </label>

                    <div class="form-grid">
                        <label>
                            <span>Pattern</span>
                            <InputSelect class="form-control" disabled="@PatternSelectionLocked" @bind-Value="form.PatternIdText">
                                <option value="">No pattern linked</option>
                                @foreach (var pattern in patterns)
                                {
                                    <option value="@pattern.Id">@pattern.Name</option>
                                }
                            </InputSelect>
                            @if (PatternSelectionLocked)
                            {
                                <small class="muted-copy">Locked after progress or timer history exists.</small>
                            }
                        </label>

                        <label>
                            <span>Difficulty</span>
                            <InputSelect class="form-control" @bind-Value="form.Difficulty">
                                <option value="0">Unspecified</option>
                                <option value="1">Beginner</option>
                                <option value="2">Beginner+</option>
                                <option value="3">Intermediate</option>
                                <option value="4">Intermediate+</option>
                                <option value="5">Advanced</option>
                                <option value="6">Advanced+</option>
                            </InputSelect>
                        </label>
                    </div>

                    <button class="btn btn-primary" disabled="@busy" type="submit">Save Project</button>
                    @if (project.IsArchived)
                    {
                        <button class="btn btn-outline-secondary" disabled="@busy" type="button" @onclick="ReopenProjectAsync">Reopen Project</button>
                    }
                    else
                    {
                        <button class="btn btn-outline-danger" disabled="@busy" type="button" @onclick="ArchiveProjectAsync">Archive Project</button>
                    }
                </EditForm>
            </section>

            <section class="project-panel">
                <div class="project-panel-header">
                    <h2>Project Supplies</h2>
                    <a class="btn btn-outline-secondary btn-sm" href="modules/crafting/inventory">Inventory</a>
                </div>

                @if (project.InventoryLinks.Count == 0)
                {
                    <p class="muted-copy">No supplies linked yet.</p>
                }
                else
                {
                    <ul class="project-supply-list">
                        @foreach (var link in project.InventoryLinks)
                        {
                            <li>
                                <div>
                                    <strong>@link.InventoryItemName</strong>
                                    <span>@SupplyLinkMeta(link)</span>
                                    @if (!string.IsNullOrWhiteSpace(link.Notes))
                                    {
                                        <small>@link.Notes</small>
                                    }
                                </div>
                                <button class="btn btn-outline-danger btn-sm"
                                        disabled="@busy"
                                        type="button"
                                        @onclick="() => RemoveSupplyLinkAsync(link.Id)">
                                    Remove
                                </button>
                            </li>
                        }
                    </ul>
                }

                <EditForm Model="supplyForm" OnValidSubmit="AddSupplyLinkAsync" class="project-edit-form">
                    <DataAnnotationsValidator />

                    <div class="form-grid">
                        <label>
                            <span>Type</span>
                            <select class="form-control" value="@supplyForm.InventoryItemType" @onchange="SelectSupplyType">
                                <option value="yarn">Yarn</option>
                                <option value="tool">Tool</option>
                                <option value="notion">Notion</option>
                            </select>
                        </label>

                        <label>
                            <span>Item</span>
                            <select class="form-control"
                                    disabled="@(!CurrentSupplyOptions.Any())"
                                    value="@supplyForm.InventoryItemIdText"
                                    @onchange="SelectSupplyItem">
                                @foreach (var option in CurrentSupplyOptions)
                                {
                                    <option value="@option.Id">@option.Name</option>
                                }
                            </select>
                        </label>
                    </div>

                    <div class="form-grid">
                        <label>
                            <span>Planned Quantity</span>
                            <InputNumber class="form-control" @bind-Value="supplyForm.QuantityPlanned" />
                        </label>

                        <label>
                            <span>Notes</span>
                            <InputText class="form-control" @bind-Value="supplyForm.Notes" />
                        </label>
                    </div>

                    <button class="btn btn-primary" disabled="@(busy || !CanAddSupplyLink)" type="submit">Link Supply</button>
                    @if (!CurrentSupplyOptions.Any())
                    {
                        <small class="muted-copy">Add @SupplyTypeLabelLower(supplyForm.InventoryItemType) inventory before linking it here.</small>
                    }
                </EditForm>
            </section>

            <section class="project-panel">
                <div class="project-panel-header">
                    <h2>Pattern Context</h2>
                    @if (linkedPattern != null)
                    {
                        <a class="btn btn-outline-secondary btn-sm" href="@($"modules/crafting/patterns/{linkedPattern.Id}")">Open Pattern</a>
                    }
                </div>

                @if (linkedPattern == null)
                {
                    <p class="muted-copy">Link a pattern to preview its pieces and ordered steps here.</p>
                }
                else
                {
                    <div class="linked-pattern-summary">
                        <strong>@linkedPattern.Name</strong>
                        <span>@PatternSummaryText</span>
                    </div>

                    @if (linkedPattern.Pieces.Count == 0)
                    {
                        <p class="muted-copy">This pattern does not have pieces yet.</p>
                    }
                    else
                    {
                        <div class="project-piece-selector">
                            <label>
                                <span>Piece</span>
                                <select class="form-control" value="@SelectedPieceIdText" @onchange="SelectPiece">
                                    @foreach (var piece in linkedPattern.Pieces)
                                    {
                                        <option value="@piece.Id">@piece.Name</option>
                                    }
                                </select>
                            </label>

                            <div class="project-piece-summary">
                                <strong>@SelectedPiecePositionText</strong>
                                <span>@SelectedPieceCompletionText</span>
                                <span>@FormatDuration(GetSelectedPieceTrackedSeconds())</span>
                            </div>
                        </div>

                        @if (SelectedPiece == null)
                        {
                            <p class="muted-copy">Select a piece to view its steps.</p>
                        }
                        else if (SelectedPiece.Steps.Count == 0)
                        {
                            <p class="muted-copy">No steps yet.</p>
                        }
                        else
                        {
                            <ol class="project-step-checklist">
                                @foreach (var step in SelectedPiece.Steps)
                                {
                                    <li>
                                        <label class="project-step-check">
                                            <input type="checkbox"
                                                   checked="@IsStepComplete(step.Id)"
                                                   disabled="@busy"
                                                   @onchange="async args => await SetStepProgressAsync(step.Id, args)" />
                                            <span>
                                                <strong>@StepLabel(step)</strong>
                                                <small>@step.Instructions</small>
                                            </span>
                                        </label>
                                        <div class="project-step-timer">
                                            <span>@FormatDuration(GetStepTrackedSeconds(step.Id))</span>
                                            @if (IsStepTimerRunning(step.Id))
                                            {
                                                <button class="btn btn-outline-secondary btn-sm"
                                                        disabled="@busy"
                                                        @onclick="() => PauseTimerAsync(step.Id)">
                                                    Pause
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-primary btn-sm"
                                                        disabled="@busy"
                                                        @onclick="() => StartTimerAsync(step.Id)">
                                                    Play
                                                </button>
                                            }
                                            <button class="btn btn-outline-secondary btn-sm"
                                                    disabled="@busy"
                                                    @onclick="() => OpenTimerDialog(step)">
                                                Edit
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ol>
                        }
                    }
                }
            </section>
        </div>
    </div>
}

@if (timerDialogStep != null)
{
    <div class="modal-backdrop-panel" role="presentation">
        <div class="timer-dialog" role="dialog" aria-modal="true" aria-labelledby="timer-dialog-title">
            <div class="timer-dialog-header">
                <h2 id="timer-dialog-title">Edit Time</h2>
                <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="CloseTimerDialog">Close</button>
            </div>

            <div class="timer-dialog-fields">
                <label>
                    <span>Current Time for Step:</span>
                    <strong>@FormatDuration(GetStepTrackedSeconds(timerDialogStep.Id))</strong>
                </label>
                <label>
                    <span>Adjusted Time for Step:</span>
                    <input class="form-control"
                           aria-invalid="@(!IsTimerDialogValueValid)"
                           inputmode="numeric"
                           pattern="^(\d+:[0-5]\d|[0-5]?\d)$"
                           type="text"
                           value="@timerDialogValue"
                           @onchange="UpdateDialogTimerValue" />
                </label>
            </div>

            @if (!IsTimerDialogValueValid)
            {
                <p class="timer-dialog-error">Use minutes or mm:ss, with seconds from 00 to 59.</p>
            }

            @if (confirmingTimerReset)
            {
                <div class="timer-reset-confirmation">
                    <p>This will reset the step time to 0.</p>
                    <button class="btn btn-outline-danger" disabled="@busy" @onclick="ConfirmResetTimerAsync">Yes</button>
                    <button class="btn btn-outline-secondary" disabled="@busy" @onclick="CancelResetTimer">No</button>
                </div>
            }
            else
            {
                <div class="timer-dialog-actions">
                    <button class="btn btn-primary" disabled="@(busy || !IsTimerDialogValueValid)" @onclick="SaveDialogTimerAsync">Save</button>
                    <button class="btn btn-outline-danger" disabled="@busy" @onclick="AskResetTimer">Reset</button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private TankerMade.Client.Services.CraftingProjectSummary? project;
    private TankerMade.Client.Services.CraftingPatternDetail? linkedPattern;
    private readonly List<TankerMade.Client.Services.CraftingPatternSummary> patterns = [];
    private readonly List<SupplyOption> yarnOptions = [];
    private readonly List<SupplyOption> toolOptions = [];
    private readonly List<SupplyOption> notionOptions = [];
    private readonly ProjectFormModel form = new();
    private readonly SupplyLinkFormModel supplyForm = new();
    private TankerMade.Client.Services.CraftingPatternStepDetail? timerDialogStep;
    private string timerDialogValue = "00:00";
    private Guid? selectedPieceId;
    private bool confirmingTimerReset;
    private bool loading = true;
    private bool busy;
    private string errorMessage = string.Empty;
    private readonly System.Timers.Timer clock = new(1000);

    private string ProjectMeta
    {
        get
        {
            var parts = new[]
            {
                string.IsNullOrWhiteSpace(project?.PatternName) ? "No pattern linked" : project.PatternName,
                string.IsNullOrWhiteSpace(project?.DifficultyLabel) ? "Difficulty unset" : project.DifficultyLabel
            };

            return string.Join(" - ", parts);
        }
    }

    private string PatternSummaryText => linkedPattern == null
        ? string.Empty
        : $"{linkedPattern.PieceCount} pieces - {linkedPattern.StepCount} steps";

    private int PatternPieceCount => linkedPattern?.PieceCount ?? 0;

    private int PatternStepCount => linkedPattern?.StepCount ?? 0;

    private string ChecklistText => project == null
        ? "0/0"
        : $"{project.CompletedStepCount}/{project.TotalStepCount}";

    private string TrackedTimeText => FormatDuration(GetTrackedSeconds());

    private bool IsTimerDialogValueValid => TryParseDurationSeconds(timerDialogValue, out _);

    private IReadOnlyList<SupplyOption> CurrentSupplyOptions => supplyForm.InventoryItemType switch
    {
        "tool" => toolOptions,
        "notion" => notionOptions,
        _ => yarnOptions
    };

    private bool CanAddSupplyLink =>
        CurrentSupplyOptions.Any()
        && Guid.TryParse(supplyForm.InventoryItemIdText, out _);

    private bool PatternSelectionLocked =>
        project?.StepProgress.Count > 0 == true
        || project?.Timers.Count > 0 == true;

    private TankerMade.Client.Services.CraftingPatternPieceDetail? SelectedPiece =>
        linkedPattern?.Pieces.FirstOrDefault(piece => piece.Id == selectedPieceId)
        ?? linkedPattern?.Pieces.FirstOrDefault();

    private string SelectedPieceIdText => SelectedPiece?.Id.ToString() ?? string.Empty;

    private string SelectedPiecePositionText
    {
        get
        {
            if (linkedPattern == null || SelectedPiece == null)
            {
                return "0/0";
            }

            var selectedIndex = linkedPattern.Pieces.ToList().FindIndex(piece => piece.Id == SelectedPiece.Id);
            return $"{selectedIndex + 1}/{linkedPattern.Pieces.Count}";
        }
    }

    private string SelectedPieceCompletionText
    {
        get
        {
            var piece = SelectedPiece;
            if (piece == null)
            {
                return "0%";
            }

            var completedCount = piece.Steps.Count(step => IsStepComplete(step.Id));
            var percent = piece.Steps.Count == 0
                ? 0
                : (int)Math.Round(completedCount * 100.0 / piece.Steps.Count, MidpointRounding.AwayFromZero);

            return $"{percent}% complete";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        clock.Elapsed += (_, _) => InvokeAsync(StateHasChanged);
        clock.Start();

        await AuthSession.InitializeAsync();
        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
        }

        await LoadProjectAsync();
    }

    private async Task LoadProjectAsync()
    {
        loading = true;
        errorMessage = string.Empty;

        try
        {
            if (!AuthSession.IsSignedIn || !ModuleState.IsActive("crafting"))
            {
                return;
            }

            patterns.Clear();
            patterns.AddRange(await ApiClient.GetCraftingPatternsAsync());
            await LoadSupplyOptionsAsync();
            project = await ApiClient.GetCraftingProjectAsync(ProjectId);
            if (project == null)
            {
                return;
            }

            form.Load(project);
            EnsureSelectedSupply();
            await LoadLinkedPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    public void Dispose()
    {
        clock.Dispose();
    }

    private async Task SaveAsync()
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            project = await ApiClient.UpdateCraftingProjectAsync(ProjectId, form.ToRequest());
            if (project != null)
            {
                form.Load(project);
                await LoadLinkedPatternAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ArchiveProjectAsync()
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            var updated = await ApiClient.ArchiveCraftingProjectAsync(ProjectId);
            if (updated != null)
            {
                project = updated;
                form.Load(project);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ReopenProjectAsync()
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            var updated = await ApiClient.ReopenCraftingProjectAsync(ProjectId);
            if (updated != null)
            {
                project = updated;
                form.Load(project);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadSupplyOptionsAsync()
    {
        yarnOptions.Clear();
        toolOptions.Clear();
        notionOptions.Clear();

        var yarns = await ApiClient.GetCraftingYarnsAsync();
        yarnOptions.AddRange(yarns.Select(yarn => new SupplyOption(
            yarn.Id,
            DisplayParts(yarn.BrandName, yarn.ColorName, yarn.WeightName, yarn.FiberTag))));

        var tools = await ApiClient.GetCraftingToolsAsync();
        toolOptions.AddRange(tools.Select(tool => new SupplyOption(
            tool.Id,
            DisplayParts(tool.BrandName, tool.TypeName, tool.Size))));

        var notions = await ApiClient.GetCraftingNotionsAsync();
        notionOptions.AddRange(notions.Select(notion => new SupplyOption(
            notion.Id,
            DisplayParts(notion.BrandName, notion.TypeName, notion.Size, notion.ColorName))));

        EnsureSelectedSupply();
    }

    private async Task AddSupplyLinkAsync()
    {
        if (!CanAddSupplyLink)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            var updated = await ApiClient.AddCraftingProjectInventoryLinkAsync(ProjectId, supplyForm.ToRequest());
            if (updated != null)
            {
                project = updated;
                supplyForm.QuantityPlanned = null;
                supplyForm.Notes = string.Empty;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RemoveSupplyLinkAsync(Guid linkId)
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            if (await ApiClient.RemoveCraftingProjectInventoryLinkAsync(ProjectId, linkId))
            {
                project = await ApiClient.GetCraftingProjectAsync(ProjectId);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void SelectSupplyType(ChangeEventArgs args)
    {
        supplyForm.InventoryItemType = NormalizeSupplyType(args.Value?.ToString());
        EnsureSelectedSupply();
    }

    private void SelectSupplyItem(ChangeEventArgs args)
    {
        supplyForm.InventoryItemIdText = args.Value?.ToString() ?? string.Empty;
    }

    private void EnsureSelectedSupply()
    {
        if (!CurrentSupplyOptions.Any())
        {
            supplyForm.InventoryItemIdText = string.Empty;
            return;
        }

        if (!Guid.TryParse(supplyForm.InventoryItemIdText, out var selectedId)
            || CurrentSupplyOptions.All(option => option.Id != selectedId))
        {
            supplyForm.InventoryItemIdText = CurrentSupplyOptions[0].Id.ToString();
        }
    }

    private async Task SetStepProgressAsync(Guid patternStepId, ChangeEventArgs args)
    {
        var isComplete = args.Value is bool isChecked && isChecked;
        busy = true;
        errorMessage = string.Empty;

        try
        {
            var updated = await ApiClient.SetCraftingProjectStepProgressAsync(ProjectId, patternStepId, isComplete);
            if (updated != null)
            {
                project = updated;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task StartTimerAsync(Guid patternStepId)
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            var updated = await ApiClient.StartCraftingProjectTimerAsync(ProjectId, patternStepId);
            if (updated != null)
            {
                project = updated;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task PauseTimerAsync(Guid patternStepId)
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            var updated = await ApiClient.PauseCraftingProjectTimerAsync(ProjectId, patternStepId);
            if (updated != null)
            {
                project = updated;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SaveDialogTimerAsync()
    {
        if (timerDialogStep == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            var updated = await ApiClient.SetCraftingProjectTimerAsync(
                ProjectId,
                timerDialogStep.Id,
                ParseDurationSeconds(timerDialogValue));

            if (updated != null)
            {
                project = updated;
                CloseTimerDialog();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmResetTimerAsync()
    {
        if (timerDialogStep == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            var updated = await ApiClient.ResetCraftingProjectTimerAsync(ProjectId, timerDialogStep.Id);
            if (updated != null)
            {
                project = updated;
                CloseTimerDialog();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenTimerDialog(TankerMade.Client.Services.CraftingPatternStepDetail step)
    {
        timerDialogStep = step;
        timerDialogValue = FormatDuration(GetStepTrackedSeconds(step.Id));
        confirmingTimerReset = false;
    }

    private void CloseTimerDialog()
    {
        timerDialogStep = null;
        confirmingTimerReset = false;
    }

    private void UpdateDialogTimerValue(ChangeEventArgs args)
    {
        timerDialogValue = args.Value?.ToString() ?? "00:00";
    }

    private void AskResetTimer()
    {
        confirmingTimerReset = true;
    }

    private void CancelResetTimer()
    {
        confirmingTimerReset = false;
    }

    private async Task LoadLinkedPatternAsync()
    {
        linkedPattern = project?.PatternId == null
            ? null
            : await ApiClient.GetCraftingPatternAsync(project.PatternId.Value);
        EnsureSelectedPiece();
    }

    private void SelectPiece(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var pieceId))
        {
            selectedPieceId = pieceId;
        }
    }

    private void EnsureSelectedPiece()
    {
        if (linkedPattern == null || linkedPattern.Pieces.Count == 0)
        {
            selectedPieceId = null;
            return;
        }

        if (selectedPieceId == null || linkedPattern.Pieces.All(piece => piece.Id != selectedPieceId))
        {
            selectedPieceId = linkedPattern.Pieces.First().Id;
        }
    }

    private bool IsStepComplete(Guid patternStepId)
    {
        return project?.StepProgress.Any(progress => progress.PatternStepId == patternStepId && progress.IsComplete) == true;
    }

    private bool IsStepTimerRunning(Guid patternStepId)
    {
        return project?.Timers.Any(timer => timer.PatternStepId == patternStepId && timer.IsRunning) == true;
    }

    private static string StepLabel(TankerMade.Client.Services.CraftingPatternStepDetail step)
    {
        var label = string.IsNullOrWhiteSpace(step.Label) ? "Step" : step.Label;
        return string.IsNullOrWhiteSpace(step.DisplayRange)
            ? label
            : $"{step.DisplayRange}: {label}";
    }

    private static string SupplyLinkMeta(TankerMade.Client.Services.CraftingProjectInventoryLinkDetail link)
    {
        var parts = new List<string> { SupplyTypeLabel(link.InventoryItemType) };
        if (link.QuantityPlanned is > 0)
        {
            parts.Add($"Qty {link.QuantityPlanned:g}");
        }

        return string.Join(" - ", parts);
    }

    private static string SupplyTypeLabel(string itemType)
    {
        return NormalizeSupplyType(itemType) switch
        {
            "tool" => "Tool",
            "notion" => "Notion",
            _ => "Yarn"
        };
    }

    private static string SupplyTypeLabelLower(string itemType)
    {
        return SupplyTypeLabel(itemType).ToLowerInvariant();
    }

    private static string NormalizeSupplyType(string? itemType)
    {
        return itemType?.Trim().ToLowerInvariant() switch
        {
            "tool" => "tool",
            "notion" => "notion",
            _ => "yarn"
        };
    }

    private static string DisplayParts(params string[] parts)
    {
        var display = string.Join(" - ", parts.Where(part => !string.IsNullOrWhiteSpace(part)));
        return string.IsNullOrWhiteSpace(display) ? "Unnamed item" : display;
    }

    private long GetTrackedSeconds()
    {
        if (project == null)
        {
            return 0;
        }

        if (project.Timers.Count == 0)
        {
            return project.TotalTrackedSeconds;
        }

        var total = 0L;
        var now = DateTime.UtcNow;
        foreach (var timer in project.Timers)
        {
            total += timer.ElapsedSeconds;
            if (timer.IsRunning && timer.StartedAt != null)
            {
                total += Math.Max(0, (long)(now - timer.StartedAt.Value).TotalSeconds);
            }
        }

        return total;
    }

    private long GetStepTrackedSeconds(Guid patternStepId)
    {
        var timer = project?.Timers.FirstOrDefault(timer => timer.PatternStepId == patternStepId);
        if (timer == null)
        {
            return 0;
        }

        var total = timer.ElapsedSeconds;
        if (timer.IsRunning && timer.StartedAt != null)
        {
            total += Math.Max(0, (long)(DateTime.UtcNow - timer.StartedAt.Value).TotalSeconds);
        }

        return total;
    }

    private long GetSelectedPieceTrackedSeconds()
    {
        return SelectedPiece?.Steps.Sum(step => GetStepTrackedSeconds(step.Id)) ?? 0;
    }

    private static bool TryParseDurationSeconds(string value, out long seconds)
    {
        seconds = 0;
        var parts = value
            .Split(':', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToArray();

        if (parts.Length is < 1 or > 2 || parts.Any(part => !long.TryParse(part, out _)))
        {
            return false;
        }

        var minutes = long.Parse(parts[0]);
        var remainingSeconds = 0L;

        if (parts.Length == 2)
        {
            remainingSeconds = long.Parse(parts[1]);
            if (parts[1].Length != 2 || remainingSeconds > 59)
            {
                return false;
            }
        }

        seconds = (minutes * 60) + remainingSeconds;
        return true;
    }

    private static long ParseDurationSeconds(string value)
    {
        return TryParseDurationSeconds(value, out var seconds)
            ? seconds
            : 0;
    }

    private static string FormatDuration(long totalSeconds)
    {
        var duration = TimeSpan.FromSeconds(Math.Max(0, totalSeconds));
        return duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours}:{duration.Minutes:00}:{duration.Seconds:00}"
            : $"{duration.Minutes:00}:{duration.Seconds:00}";
    }

    private sealed class ProjectFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Name is required")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Name cannot exceed 200 characters")]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(1000, ErrorMessage = "Description cannot exceed 1000 characters")]
        public string Description { get; set; } = string.Empty;

        public string PatternIdText { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Range(0, 6, ErrorMessage = "Choose a valid difficulty")]
        public int Difficulty { get; set; }

        public void Load(TankerMade.Client.Services.CraftingProjectSummary project)
        {
            Name = project.Name;
            Description = project.Description;
            PatternIdText = project.PatternId?.ToString() ?? string.Empty;
            Difficulty = project.Difficulty;
        }

        public TankerMade.Client.Services.CraftingProjectFormRequest ToRequest()
        {
            return new()
            {
                Name = Name,
                Description = Description,
                PatternId = Guid.TryParse(PatternIdText, out var patternId) ? patternId : null,
                ClearPatternId = string.IsNullOrWhiteSpace(PatternIdText),
                Difficulty = Difficulty
            };
        }
    }

    private sealed class SupplyLinkFormModel
    {
        public string InventoryItemType { get; set; } = "yarn";

        public string InventoryItemIdText { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Range(typeof(decimal), "0.01", "999999", ErrorMessage = "Quantity must be greater than 0")]
        public decimal? QuantityPlanned { get; set; }

        [System.ComponentModel.DataAnnotations.StringLength(1000, ErrorMessage = "Notes cannot exceed 1000 characters")]
        public string Notes { get; set; } = string.Empty;

        public TankerMade.Client.Services.CraftingProjectInventoryLinkFormRequest ToRequest()
        {
            return new()
            {
                InventoryItemType = InventoryItemType,
                InventoryItemId = Guid.Parse(InventoryItemIdText),
                QuantityPlanned = QuantityPlanned,
                Notes = Notes
            };
        }
    }

    private sealed record SupplyOption(Guid Id, string Name);
