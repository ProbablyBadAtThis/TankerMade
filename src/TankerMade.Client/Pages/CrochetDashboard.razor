@page "/modules/crochet"
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession

<PageTitle>Crochet</PageTitle>

<div class="module-shell module-shell-crochet">
    <header class="module-hero">
        <h1>Crochet</h1>
        <p>Module home for crochet projects, patterns, materials, and progress tracking.</p>
    </header>

    @if (!AuthSession.IsSignedIn)
    {
        <section class="module-card">
            <h2>Sign In Required</h2>
            <p>Sign in to open and test this module.</p>
            <a class="btn btn-primary" href="login">Sign in</a>
        </section>
    }
    else if (!ModuleState.IsActive("crochet"))
    {
        <section class="module-card">
            <h2>Module Not Active</h2>
            <p>Activate Crochet from Home to continue.</p>
            <a class="btn btn-outline-primary" href="/home">Go to Home</a>
        </section>
    }
    else
    {
        <section class="module-grid">
            <article class="module-card">
                <h2>Workspace</h2>
                <p>Start and track active crochet pieces with step-by-step progress.</p>
                <span class="module-pill">Projects</span>
            </article>
            <article class="module-card">
                <h2>Pattern Library</h2>
                <p>Store reusable pattern definitions, piece breakdowns, and notes.</p>
                <span class="module-pill">Patterns</span>
            </article>
            <article class="module-card">
                <h2>Materials</h2>
                <p>Organize yarn and tools with stock, lot, and sourcing details.</p>
                <span class="module-pill">Inventory</span>
            </article>
        </section>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthSession.InitializeAsync();
        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
        }
    }
}
