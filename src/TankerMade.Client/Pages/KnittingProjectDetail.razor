@page "/modules/knitting/projects/{ProjectId:guid}"
@implements IDisposable
@using TankerMade.Contracts.DTOs.Assets
@using TankerMade.Contracts.DTOs.ModuleInventory
@using TankerMade.Contracts.DTOs.ModulePatterns
@using TankerMade.Contracts.DTOs.ModuleProjects
@using TankerMade.Contracts.DTOs.Reference
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession
@inject TankerMade.Client.Services.TankerMadeApiClient ApiClient
@inject TankerMade.Client.Services.KnittingRecentActivity RecentActivity
@inject TankerMade.Client.Services.KnittingRowProgress RowProgress
@inject TankerMade.Client.Services.KnittingCardAssetCache CardAssets

<PageTitle>Knitting Project</PageTitle>

<KnittingModuleGate Loading="loading" LoadingMessage="Loading project...">
    @if (project is null)
    {
        <MudStack Spacing="3">
            <KnittingPageHeader Title="Project Not Found"
                                BackHref="/modules/knitting/projects"
                                BackLabel="Projects" />
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/modules/knitting/projects">
                Back to Projects
            </MudButton>
        </MudStack>
    }
    else
    {
        <MudStack Spacing="3" Class="pattern-detail">
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }

            <div class="pattern-header">
                <div class="knitting-hero-card pattern-header-main">
                    <AssetThumbnailImage AssetId="projectAssetId"
                                         AltText="@project.Name"
                                         CssClass="asset-thumbnail-image" />
                    <div>
                        <KnittingPageHeader Title="@project.Name"
                                            Subtitle="@ProjectHeaderMeta"
                                            BackHref="/modules/knitting/projects"
                                            BackLabel="Projects" />
                        <div class="pattern-card-stats mt-1">
                            <KnittingDifficultyBadge Difficulty="project.Difficulty" />
                    @if (!string.IsNullOrWhiteSpace(project.ThemeName))
                    {
                        <span>@project.ThemeName</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(project.ColorName))
                    {
                        <span>@project.ColorName</span>
                    }
                    @if (project.StartedAt.HasValue)
                    {
                        <span>Started @project.StartedAt.Value.ToLocalTime().ToString("MMM d, yyyy")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(project.PatternName))
                    {
                        <span>@project.PatternName</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(project.Description))
                {
                    <p>@project.Description</p>
                }
                @if (project.IsArchived)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">Archived</MudChip>
                }
                </div>
            </div>
            <div class="pattern-stats" aria-label="Project summary">
                <div>
                    <strong>@project.Progress%</strong>
                    <span>Progress</span>
                </div>
                <div>
                    <strong>@(project.TotalStitchCount > 0 ? $"{project.CompletedStitchCount}/{project.TotalStitchCount}" : $"{project.CompletedStepCount}/{project.TotalStepCount}")</strong>
                    <span>@(project.TotalStitchCount > 0 ? "Stitches" : "Steps")</span>
                </div>
                <div>
                    <strong>@KnittingUi.FormatDurationCompact(GetTrackedSeconds())</strong>
                    <span>Tracked</span>
                </div>
            </div>
        </div>

        <MudPaper Class="pa-4 knitting-panel-mud" Elevation="1">
            <MudStack Spacing="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.subtitle1">Workspace Setup</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Href="/modules/knitting/patterns">Patterns</MudButton>
                </MudStack>
                <EditForm Model="form" OnValidSubmit="SaveAsync" class="project-edit-form">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <MudStack Spacing="2">
                        <div class="form-grid">
                            <MudTextField @bind-Value="form.Name" Label="Name" Variant="Variant.Outlined" Required="true" />
                            <MudTextField @bind-Value="form.Description" Label="Description" Variant="Variant.Outlined" Lines="3" />
                            <MudSelect T="string" @bind-Value="form.PatternIdText" Label="Pattern" Variant="Variant.Outlined" Disabled="PatternSelectionLocked">
                                <MudSelectItem T="string" Value="@string.Empty">No pattern linked</MudSelectItem>
                                @foreach (var patternOption in patterns)
                                {
                                    <MudSelectItem T="string" Value="@patternOption.Id.ToString()">@patternOption.Name</MudSelectItem>
                                }
                            </MudSelect>
                            @if (PatternSelectionLocked)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Pattern changes are locked after progress, timer, or supply-link history exists.</MudText>
                            }
                            <MudSelect T="string" @bind-Value="form.ThemeIdText" Label="Theme" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@string.Empty">None</MudSelectItem>
                                @foreach (var theme in themes)
                                {
                                    <MudSelectItem T="string" Value="@theme.Id.ToString()">@theme.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="form.ColorIdText" Label="Main color" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@string.Empty">None</MudSelectItem>
                                @foreach (var color in colors)
                                {
                                    <MudSelectItem T="string" Value="@color.Id.ToString()">@color.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="int" @bind-Value="form.Difficulty" Label="Difficulty" Variant="Variant.Outlined">
                                <MudSelectItem T="int" Value="0">Unspecified</MudSelectItem>
                                <MudSelectItem T="int" Value="1">Beginner</MudSelectItem>
                                <MudSelectItem T="int" Value="2">Beginner+</MudSelectItem>
                                <MudSelectItem T="int" Value="3">Intermediate</MudSelectItem>
                                <MudSelectItem T="int" Value="4">Intermediate+</MudSelectItem>
                                <MudSelectItem T="int" Value="5">Advanced</MudSelectItem>
                                <MudSelectItem T="int" Value="6">Advanced+</MudSelectItem>
                            </MudSelect>
                            <MudDatePicker @bind-Date="form.StartedAtDate" Label="Date started" Variant="Variant.Outlined" />
                        </div>
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" ButtonType="ButtonType.Submit">Save Project</MudButton>
                            @if (project.IsArchived)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="busy" OnClick="ReopenProjectAsync">Reopen Project</MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="busy" OnClick="ArchiveProjectAsync">Archive Project</MudButton>
                            }
                        </MudStack>
                    </MudStack>
                </EditForm>
            </MudStack>
        </MudPaper>

        @if (pattern is null || pattern.Pieces.Count == 0)
        {
            <MudPaper Class="pa-6 knitting-panel-mud" Elevation="1">
                <MudStack Spacing="1" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">No Pattern Steps</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Link a pattern to this project to track steps and timers.</MudText>
                </MudStack>
            </MudPaper>
        }
        else
        {
            <div class="workspace-sticky-chrome" aria-label="Workspace summary">
                <div class="workspace-sticky-stat">
                    <strong>@project.Progress%</strong>
                    <span>Progress</span>
                </div>
                <div class="workspace-sticky-stat">
                    <strong>@KnittingUi.FormatDurationCompact(GetTrackedSeconds())</strong>
                    <span>Tracked</span>
                </div>
                <div class="workspace-sticky-stat">
                    <strong>@(selectedPiece?.Name ?? "No piece")</strong>
                    <span>Current piece</span>
                </div>
            </div>

            <div class="pattern-workspace">
                <aside class="piece-list">
                    @foreach (var piece in pattern.Pieces)
                    {
                        <div class="piece-row">
                            <button class="piece-button @(selectedPieceId == piece.Id ? "active" : string.Empty)" @onclick="() => SelectPiece(piece.Id)">
                                <span>@piece.Name</span>
                                <small>@PieceSidebarMeta(piece)</small>
                            </button>
                        </div>
                    }
                </aside>

                <section class="step-panel">
                    @if (selectedPiece is null)
                    {
                        <p>Select a piece.</p>
                    }
                    else
                    {
                        <div class="step-panel-header">
                            <div>
                                <h2>@selectedPiece.Name</h2>
                                <p>@SelectedPieceMeta</p>
                            </div>
                        </div>
                        <ol class="step-list step-panel-scroll">
                            @foreach (var step in selectedPiece.Steps)
                            {
                                var timer = project.Timers.FirstOrDefault(timer => timer.PatternStepId == step.Id);
                                var stepRows = GetStepRows(step);
                                <li class="step-range-group">
                                    <div class="step-range">@KnittingUi.FormatStepRange(step.StartIndex, step.EndIndex)</div>
                                    <div class="step-row-checks">
                                        @foreach (var row in stepRows)
                                        {
                                            var rowKey = RowKey(step.Id, row);
                                            var rowChecked = rowCheckState.GetValueOrDefault(rowKey);
                                            <label class="step-row-check">
                                                <MudCheckBox T="bool"
                                                             Value="rowChecked"
                                                             ValueChanged="@(async (bool v) => await ToggleRowAsync(step, row, new ChangeEventArgs { Value = v }))"
                                                             Disabled="busy"
                                                             Color="Color.Primary"
                                                             Dense="true" />
                                                <span>@(row >= 0 ? $"Row {row}" : StepLabel(step))</span>
                                            </label>
                                        }
                                    </div>
                                    <div class="step-content">
                                        <div class="step-title-row">
                                            <h3>@StepLabel(step)</h3>
                                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                                @if (timer?.IsRunning == true)
                                                {
                                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Disabled="busy" OnClick="@(() => PauseTimerAsync(step.Id))">Pause</MudButton>
                                                }
                                                else
                                                {
                                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Disabled="busy" OnClick="@(() => StartTimerAsync(step.Id))">Start</MudButton>
                                                }
                                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Disabled="busy" OnClick="@(() => OpenTimerEdit(step))">Edit</MudButton>
                                            </MudStack>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(step.Notes))
                                        {
                                            <p>@step.Notes</p>
                                        }
                                        <small>@StepMeta(step, timer)</small>
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                </section>
            </div>
        }

        <MudPaper Class="pa-4 knitting-panel-mud mt-3" Elevation="1">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1">Linked Supplies</MudText>
                <div class="form-grid">
                    <MudSelect T="string" @bind-Value="selectedInventoryType" @bind-Value:after="OnInventoryTypeChanged" Label="Inventory Type" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("yarn")">Yarn</MudSelectItem>
                        <MudSelectItem T="string" Value="@("tool")">Tool</MudSelectItem>
                        <MudSelectItem T="string" Value="@("notion")">Notion</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="Guid?" @bind-Value="selectedInventoryItemId" Label="Inventory Item" Variant="Variant.Outlined">
                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">Select item</MudSelectItem>
                        @foreach (var option in inventoryOptions)
                        {
                            <MudSelectItem T="Guid?" Value="@option.Id">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField T="decimal?" @bind-Value="supplyQuantity" Label="Quantity Planned" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="supplyNotes" Label="Notes" Variant="Variant.Outlined" />
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="AddSupplyLinkAsync">Add Supply Link</MudButton>

                @if (project.InventoryLinks.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No supply links yet.</MudText>
                }
                else
                {
                    <ul class="project-supply-list mt-3">
                        @foreach (var link in project.InventoryLinks)
                        {
                            <li>
                                <div>
                                    <strong>@link.InventoryItemName</strong>
                                    <span class="text-muted">(@link.InventoryItemType)</span>
                                    <span>@(link.QuantityPlanned?.ToString() ?? "-") planned</span>
                                    @if (!string.IsNullOrWhiteSpace(link.Notes))
                                    {
                                        <small>@link.Notes</small>
                                    }
                                </div>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="busy" OnClick="@(() => RemoveSupplyLinkAsync(link.Id))">
                                    Remove
                                </MudButton>
                            </li>
                        }
                    </ul>
                }
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 knitting-panel-mud mt-3" Elevation="1">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1">Project Assets</MudText>
                <InputFile OnChange="UploadProjectAssetAsync" disabled="@busy" />
                @if (projectAssets.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No assets attached yet.</MudText>
                }
                else
                {
                    <ul class="project-supply-list mt-2">
                        @foreach (var asset in projectAssets)
                        {
                            <li>
                                <div>
                                    <strong>@asset.OriginalFileName</strong>
                                    <span>@AssetMeta(asset)</span>
                                </div>
                                @if (asset.RecordId == project.Id)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="busy" OnClick="@(() => UnassignProjectAssetAsync(asset.Id))">
                                        Unlink
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Disabled="busy" OnClick="@(() => AssignProjectAssetAsync(asset.Id))">
                                        Attach
                                    </MudButton>
                                }
                            </li>
                        }
                    </ul>
                }
            </MudStack>
        </MudPaper>
        </MudStack>
    }
</KnittingModuleGate>

@if (timerEditStep != null)
{
    <div class="modal-backdrop-panel" role="presentation">
        <div class="timer-dialog" role="dialog" aria-modal="true" aria-labelledby="timer-edit-title">
            <div class="timer-dialog-header">
                <MudText Typo="Typo.h6" id="timer-edit-title">Adjust Step Time</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Disabled="busy" OnClick="CloseTimerEdit">Close</MudButton>
            </div>
            <div class="timer-dialog-fields">
                <label>
                    <span>Step</span>
                    <strong>@StepLabel(timerEditStep)</strong>
                </label>
                <div class="timer-edit-grid">
                    <span>Elapsed Time</span>
                    <MudNumericField T="int" @bind-Value="timerEditDays" Label="D" Variant="Variant.Outlined" Min="0" />
                    <MudNumericField T="int" @bind-Value="timerEditHours" Label="H" Variant="Variant.Outlined" Min="0" />
                    <MudNumericField T="int" @bind-Value="timerEditMinutes" Label="M" Variant="Variant.Outlined" Min="0" />
                    <MudNumericField T="int" @bind-Value="timerEditSeconds" Label="S" Variant="Variant.Outlined" Min="0" />
                </div>
            </div>
            @if (!IsTimerEditValid)
            {
                <MudAlert Severity="Severity.Error" Dense="true">Use non-negative values for days, hours, minutes, and seconds.</MudAlert>
            }
            <div class="timer-dialog-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || !IsTimerEditValid)" OnClick="SaveTimerEditAsync">Save</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="busy" OnClick="ResetTimerFromDialogAsync">Reset</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="busy" OnClick="CloseTimerEdit">Cancel</MudButton>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private const string ModuleKey = "knitting";
    private const string ProjectRecordType = "project";
    private const string WorkspaceDefaultSupplyQuantityKey = "workspace.defaultSupplyPlannedQuantity";
    private const string TimersDefaultEditMinutesKey = "timers.defaultEditMinutes";
    private const string TimersAutoPauseOnCompleteKey = "timers.autoPauseOnComplete";
    private ModuleProjectDto? project;
    private Guid? projectAssetId;
    private ModulePatternDto? pattern;
    private ModulePatternPieceDto? selectedPiece;
    private Guid? selectedPieceId;
    private readonly List<ModulePatternDto> patterns = [];
    private readonly List<CoreReferenceItemDto> themes = [];
    private readonly List<CoreReferenceItemDto> colors = [];
    private readonly List<InventoryOption> inventoryOptions = [];
    private readonly List<AssetRecordDto> projectAssets = [];
    private ProjectFormModel form = new();
    private HashSet<Guid> completedStepIds = [];
    private Dictionary<string, bool> rowCheckState = [];
    private string selectedInventoryType = "yarn";
    private Guid? selectedInventoryItemId;
    private decimal? supplyQuantity;
    private string supplyNotes = string.Empty;
    private bool loading = true;
    private bool settingsInitialized;
    private bool busy;
    private string errorMessage = string.Empty;
    private readonly System.Timers.Timer clock = new(1000);
    private ModulePatternStepDto? timerEditStep;
    private int timerEditDays;
    private int timerEditHours;
    private int timerEditMinutes;
    private int timerEditSeconds;
    private int defaultTimerEditMinutes;
    private bool autoPauseOnComplete;
    private string ProjectMeta
    {
        get
        {
            if (project == null)
            {
                return string.Empty;
            }

            var parts = new[]
            {
                string.IsNullOrWhiteSpace(project.PatternName) ? "No pattern linked" : project.PatternName,
                DifficultyLabel(project.Difficulty)
            }.Where(value => !string.IsNullOrWhiteSpace(value));

            return string.Join(" - ", parts);
        }
    }

    private string ProjectHeaderMeta => ProjectMeta;
    private bool IsTimerEditValid =>
        timerEditDays >= 0
        && timerEditHours >= 0
        && timerEditMinutes >= 0
        && timerEditSeconds >= 0;

    private string SelectedPieceMeta => selectedPiece == null ? string.Empty : PieceSidebarMeta(selectedPiece);

    private string PieceSidebarMeta(ModulePatternPieceDto piece)
    {
        var completedSteps = piece.Steps.Count(step => completedStepIds.Contains(step.Id));
        var totalSteps = piece.StepCount;
        var percent = totalSteps == 0 ? 0 : (int)Math.Round(completedSteps * 100.0 / totalSteps, MidpointRounding.AwayFromZero);

        var totalStitches = piece.Steps.Sum(step => step.StitchCount ?? 0);
        var completedStitches = piece.Steps
            .Where(step => completedStepIds.Contains(step.Id))
            .Sum(step => step.StitchCount ?? 0);

        var trackedSeconds = piece.Steps.Sum(step => GetStepTrackedSeconds(step.Id));
        var stitchSummary = totalStitches > 0
            ? $"{completedStitches}/{totalStitches} stitches"
            : $"{completedSteps}/{totalSteps} steps";

        return $"{percent}% · {stitchSummary} · {KnittingUi.FormatDurationCompact(trackedSeconds)}";
    }

    protected override async Task OnInitializedAsync()
    {
        clock.Elapsed += (_, _) => InvokeAsync(StateHasChanged);
        clock.Start();

        await AuthSession.InitializeAsync();
        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
        }

        await LoadAsync();
    }

    public void Dispose()
    {
        clock.Dispose();
    }

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = string.Empty;

        try
        {
            if (!AuthSession.IsSignedIn || !ModuleState.IsActive(ModuleKey))
            {
                return;
            }

            if (!settingsInitialized)
            {
                var settings = await ApiClient.GetModuleSettingsAsync(ModuleKey);
                supplyQuantity = GetDecimalSetting(settings, WorkspaceDefaultSupplyQuantityKey);
                defaultTimerEditMinutes = GetIntSetting(settings, TimersDefaultEditMinutesKey, 0, 0, 1440);
                autoPauseOnComplete = GetBoolSetting(settings, TimersAutoPauseOnCompleteKey, false);
                settingsInitialized = true;
            }

            patterns.Clear();
            patterns.AddRange(await ApiClient.GetModulePatternsAsync(ModuleKey));
            themes.Clear();
            themes.AddRange(await ApiClient.GetCoreReferenceItemsAsync("themes"));
            colors.Clear();
            colors.AddRange(await ApiClient.GetCoreReferenceItemsAsync("colors"));
            project = await ApiClient.GetModuleProjectAsync(ModuleKey, ProjectId);
            projectAssetId = null;
            if (project != null)
            {
                await RecentActivity.RecordProjectOpenedAsync(project.Id);
                var projectAssets = await CardAssets.GetAssetsAsync(ModuleKey, "project");
                projectAssetId = projectAssets.FirstOrDefault(asset => asset.RecordId == project.Id)?.Id;
                if (!projectAssetId.HasValue && project.PatternId.HasValue)
                {
                    var patternAssets = await CardAssets.GetAssetsAsync(ModuleKey, "pattern");
                    projectAssetId = patternAssets.FirstOrDefault(asset => asset.RecordId == project.PatternId.Value)?.Id;
                }
            }

            if (project?.PatternId != null)
            {
                pattern = await ApiClient.GetModulePatternAsync(ModuleKey, project.PatternId.Value);
                if (pattern == null)
                {
                    selectedPiece = null;
                    selectedPieceId = null;
                }
            }
            else
            {
                pattern = null;
                selectedPiece = null;
                selectedPieceId = null;
            }

            completedStepIds = project?.StepProgress
                .Where(progress => progress.IsComplete)
                .Select(progress => progress.PatternStepId)
                .ToHashSet() ?? [];

            await LoadRowCheckStateAsync();
            await LoadInventoryOptionsAsync();
            EnsureSelectedInventoryItem();
            await LoadProjectAssetsAsync();

            if (pattern != null)
            {
                selectedPieceId ??= pattern.Pieces.FirstOrDefault()?.Id;
                selectedPiece = pattern.Pieces.FirstOrDefault(piece => piece.Id == selectedPieceId)
                    ?? pattern.Pieces.FirstOrDefault();
                selectedPieceId = selectedPiece?.Id;
            }

            if (project != null)
            {
                form.Load(project);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private bool PatternSelectionLocked =>
        project?.StepProgress.Any() == true
        || project?.Timers.Any() == true
        || project?.InventoryLinks.Any() == true;

    private async Task SaveAsync()
    {
        await RunBusyAsync(async () =>
        {
            if (project == null)
            {
                return;
            }

            var updated = await ApiClient.UpdateModuleProjectAsync(ModuleKey, project.Id, form.ToRequest(project.Id));
            if (updated == null)
            {
                return;
            }

            project = updated;
            form.Load(project);
            completedStepIds = project.StepProgress
                .Where(progress => progress.IsComplete)
                .Select(progress => progress.PatternStepId)
                .ToHashSet();
            pattern = project.PatternId == null
                ? null
                : await ApiClient.GetModulePatternAsync(ModuleKey, project.PatternId.Value);

            if (pattern != null)
            {
                selectedPieceId = pattern.Pieces.FirstOrDefault(piece => piece.Id == selectedPieceId)?.Id
                    ?? pattern.Pieces.FirstOrDefault()?.Id;
                selectedPiece = pattern.Pieces.FirstOrDefault(piece => piece.Id == selectedPieceId)
                    ?? pattern.Pieces.FirstOrDefault();
                selectedPieceId = selectedPiece?.Id;
            }
            else
            {
                selectedPiece = null;
                selectedPieceId = null;
            }
        });
    }

    private async Task ArchiveProjectAsync()
    {
        await RunBusyAsync(async () =>
        {
            if (project == null)
            {
                return;
            }

            var updated = await ApiClient.ArchiveModuleProjectAsync(ModuleKey, project.Id);
            if (updated != null)
            {
                project = updated;
                form.Load(project);
            }
        });
    }

    private async Task ReopenProjectAsync()
    {
        await RunBusyAsync(async () =>
        {
            if (project == null)
            {
                return;
            }

            var updated = await ApiClient.ReopenModuleProjectAsync(ModuleKey, project.Id);
            if (updated != null)
            {
                project = updated;
                form.Load(project);
            }
        });
    }

