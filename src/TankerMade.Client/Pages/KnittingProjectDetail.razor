    private static string AssetMeta(AssetRecordDto asset)
    {
        var size = asset.FileSizeBytes > 0 ? $"{asset.FileSizeBytes / 1024} KB" : "unknown size";
        return $"{asset.ContentType} - {size}";
    }

    private long GetTrackedSeconds()
    {
        if (project == null || project.Timers.Count == 0)
        {
            return project?.TotalTrackedSeconds ?? 0;
        }

        return project.Timers.Sum(timer => GetStepTrackedSeconds(timer.PatternStepId));
    }

    private long GetStepTrackedSeconds(Guid patternStepId)
    {
        var timer = project?.Timers.FirstOrDefault(existing => existing.PatternStepId == patternStepId);
        if (timer == null)
        {
            return 0;
        }

        var total = timer.ElapsedSeconds;
        if (timer.IsRunning && timer.StartedAt != null)
        {
            total += Math.Max(0, (long)(DateTime.UtcNow - timer.StartedAt.Value).TotalSeconds);
        }

        return total;
    }

    private static string DifficultyLabel(int difficulty)
    {
        return difficulty switch
        {
            1 => "Beginner",
            2 => "Beginner+",
            3 => "Intermediate",
            4 => "Intermediate+",
            5 => "Advanced",
            6 => "Advanced+",
            _ => "Difficulty unset"
        };
    }

    private string StepMeta(ModulePatternStepDto step, ModuleProjectTimerDto? timer)
    {
        var parts = new List<string>
        {
            FormatDurationCompact(GetStepTrackedSeconds(step.Id))
        };

        if (step.StitchCount is > 0)
        {
            parts.Add($"{step.StitchCount} stitches");
        }

        if (timer?.IsRunning == true)
        {
            parts.Add("Running");
        }

        return string.Join(" - ", parts);
    }

    private static string StepLabel(ModulePatternStepDto step)
    {
        if (!string.IsNullOrWhiteSpace(step.Label))
        {
            return step.Label;
        }

        return step.StitchCount is > 0
            ? $"Step ({step.StitchCount} stitches)"
            : "Step";
    }

    private static string StepRange(ModulePatternStepDto step)
    {
        if (step.StartIndex == null && step.EndIndex == null)
        {
            return "-";
        }

        if (step.StartIndex == step.EndIndex || step.EndIndex == null)
        {
            return step.StartIndex?.ToString() ?? step.EndIndex?.ToString() ?? "-";
        }

        if (step.StartIndex == null)
        {
            return step.EndIndex?.ToString() ?? "-";
        }

        return $"{step.StartIndex}-{step.EndIndex}";
    }

    private static string FormatDurationCompact(long totalSeconds)
    {
        var safeTotal = Math.Max(0, totalSeconds);
        if (safeTotal == 0)
        {
            return "0s";
        }

        var span = TimeSpan.FromSeconds(safeTotal);
        var parts = new List<string>();

        if (span.Days > 0)
        {
            parts.Add($"{span.Days}d");
        }

        if (span.Hours > 0)
        {
            parts.Add($"{span.Hours}h");
        }

        if (span.Minutes > 0)
        {
            parts.Add($"{span.Minutes}m");
        }

        if (span.Seconds > 0)
        {
            parts.Add($"{span.Seconds}s");
        }

        return parts.Count == 0 ? "0s" : string.Join(string.Empty, parts);
    }

    private bool TryGetTimerEditSeconds(out long seconds)
    {
        seconds = 0;
        if (!IsTimerEditValid)
        {
            return false;
        }

        try
        {
            checked
            {
                seconds =
                    ((long)timerEditDays * 24 * 60 * 60)
                    + ((long)timerEditHours * 60 * 60)
                    + ((long)timerEditMinutes * 60)
                    + timerEditSeconds;
            }

            return true;
        }
        catch (OverflowException)
        {
            return false;
        }
    }

    private void SetTimerEditParts(long totalSeconds)
    {
        var span = TimeSpan.FromSeconds(Math.Max(0, totalSeconds));
        timerEditDays = span.Days;
        timerEditHours = span.Hours;
        timerEditMinutes = span.Minutes;
        timerEditSeconds = span.Seconds;
    }

    private static bool GetBoolSetting(IReadOnlyList<TankerMade.Contracts.DTOs.ModuleSettings.ModuleSettingItemDto> settings, string key, bool fallback)
    {
        var value = settings.FirstOrDefault(setting => setting.Key.Equals(key, StringComparison.OrdinalIgnoreCase))?.Value;
        return bool.TryParse(value, out var parsed) ? parsed : fallback;
    }

    private static int GetIntSetting(
        IReadOnlyList<TankerMade.Contracts.DTOs.ModuleSettings.ModuleSettingItemDto> settings,
        string key,
        int fallback,
        int min,
        int max)
    {
        var value = settings.FirstOrDefault(setting => setting.Key.Equals(key, StringComparison.OrdinalIgnoreCase))?.Value;
        if (!int.TryParse(value, out var parsed))
        {
            return Math.Clamp(fallback, min, max);
        }

        return Math.Clamp(parsed, min, max);
    }

    private static decimal? GetDecimalSetting(
        IReadOnlyList<TankerMade.Contracts.DTOs.ModuleSettings.ModuleSettingItemDto> settings,
        string key)
    {
        var value = settings.FirstOrDefault(setting => setting.Key.Equals(key, StringComparison.OrdinalIgnoreCase))?.Value;
        if (!decimal.TryParse(value, out var parsed) || parsed <= 0)
        {
            return null;
        }

        return parsed;
    }

    private sealed class ProjectFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Name is required")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Name cannot exceed 200 characters")]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(1000, ErrorMessage = "Description cannot exceed 1000 characters")]
        public string Description { get; set; } = string.Empty;
        public string PatternIdText { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Range(0, 6, ErrorMessage = "Choose a valid difficulty")]
        public int Difficulty { get; set; }

        public void Load(ModuleProjectDto project)
        {
            Name = project.Name;
            Description = project.Description;
            PatternIdText = project.PatternId?.ToString() ?? string.Empty;
            Difficulty = project.Difficulty;
        }

        public UpdateModuleProjectRequest ToRequest(Guid projectId)
        {
            return new UpdateModuleProjectRequest
            {
                Id = projectId,
                Name = Name,
                Description = Description,
                PatternId = Guid.TryParse(PatternIdText, out var patternId) ? patternId : null,
                ClearPatternId = string.IsNullOrWhiteSpace(PatternIdText),
                Difficulty = Difficulty
            };
        }
    }
