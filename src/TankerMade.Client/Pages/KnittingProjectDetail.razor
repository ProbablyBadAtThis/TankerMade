    private static List<int> GetStepRows(ModulePatternStepDto step)
    {
        var rows = KnittingUi.ExpandStepRange(step.StartIndex, step.EndIndex).ToList();
        return rows.Count > 0 ? rows : [-1];
    }

    private static string RowKey(Guid stepId, int row) => $"{stepId:N}:{row}";

    private async Task LoadRowCheckStateAsync()
    {
        rowCheckState.Clear();
        if (project == null || pattern == null)
        {
            return;
        }

        foreach (var piece in pattern.Pieces)
        {
            foreach (var step in piece.Steps)
            {
                var rows = GetStepRows(step);
                var serverComplete = completedStepIds.Contains(step.Id);
                if (serverComplete)
                {
                    await RowProgress.SyncStepCompletionAsync(project.Id, step.Id, rows.Where(row => row >= 0), true);
                }

                foreach (var row in rows)
                {
                    var key = RowKey(step.Id, row);
                    rowCheckState[key] = serverComplete
                        || await RowProgress.IsRowCheckedAsync(project.Id, step.Id, row);
                }
            }
        }
    }

    private async Task ToggleRowAsync(ModulePatternStepDto step, int row, ChangeEventArgs args)
    {
        if (project == null)
        {
            return;
        }

        var isChecked = args.Value is bool value && value;
        rowCheckState[RowKey(step.Id, row)] = isChecked;
        await RowProgress.SetRowCheckedAsync(project.Id, step.Id, row, isChecked);

        var rows = GetStepRows(step);
        var allChecked = rows.All(entry => rowCheckState.GetValueOrDefault(RowKey(step.Id, entry)));
        var shouldComplete = allChecked;
        var currentlyComplete = completedStepIds.Contains(step.Id);

        if (shouldComplete == currentlyComplete)
        {
            await RecentActivity.RecordProjectWorkedOnAsync(project.Id);
            return;
        }

        await SetStepCompleteAsync(step.Id, shouldComplete);
    }

    private async Task SetStepCompleteAsync(Guid stepId, bool isComplete)
    {
        await RunBusyAsync(async () =>
        {
            if (project == null)
            {
                return;
            }

            var updated = await ApiClient.SetModuleProjectStepProgressAsync(ModuleKey, project.Id, stepId, isComplete);
            if (updated == null)
            {
                return;
            }

            project = updated;
            if (autoPauseOnComplete && isComplete)
            {
                var timer = project.Timers.FirstOrDefault(existing => existing.PatternStepId == stepId);
                if (timer?.IsRunning == true)
                {
                    var paused = await ApiClient.PauseModuleProjectTimerAsync(ModuleKey, project.Id, stepId);
                    if (paused != null)
                    {
                        project = paused;
                    }
                }
            }

            completedStepIds = project.StepProgress
                .Where(progress => progress.IsComplete)
                .Select(progress => progress.PatternStepId)
                .ToHashSet();

            var step = pattern?.Pieces.SelectMany(piece => piece.Steps).FirstOrDefault(entry => entry.Id == stepId);
            if (step != null)
            {
                var rows = GetStepRows(step).Where(entry => entry >= 0);
                await RowProgress.SyncStepCompletionAsync(project.Id, stepId, rows, isComplete);
                await LoadRowCheckStateAsync();
            }

            await RecentActivity.RecordProjectWorkedOnAsync(project.Id);
        });
    }

