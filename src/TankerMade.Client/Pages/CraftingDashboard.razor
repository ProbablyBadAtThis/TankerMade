@page "/modules/crafting"
@inject TankerMade.Client.Services.ClientModuleState ModuleState

<PageTitle>Crafting</PageTitle>

<h1>Crafting</h1>

@if (!ModuleState.IsActive("crafting"))
{
    <p>Activate the Crafting module from Home to load its tools.</p>
}
else
{
    <p>The Crafting module is active. Project and pattern workflows are supplied by this reference module.</p>

    <div class="crafting-dashboard">
        <div class="crafting-panel">
            <div>
                <h2>Patterns</h2>
                <p>Reference pattern workspace with pieces, ordered steps, and compact ranges.</p>
            </div>
            <a class="btn btn-primary" href="modules/crafting/patterns">Open</a>
        </div>
        <div class="crafting-panel">
            <div>
                <h2>Projects</h2>
                <p>Project workspaces will build on pattern pieces and steps in the next slice.</p>
            </div>
            <button class="btn btn-outline-secondary" disabled>Pending</button>
        </div>
    </div>
}
