@page "/modules/knitting"
@using TankerMade.Contracts.DTOs.Dashboard
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession
@inject TankerMade.Client.Services.TankerMadeApiClient ApiClient

<PageTitle>Knitting</PageTitle>

<KnittingModuleGate Loading="loading" LoadingMessage="Loading recent activity...">
    <div class="core-dashboard-page knitting-studio-page">
        <header class="core-dashboard-header">
            <div class="core-dashboard-header-bar">
                <div class="core-dashboard-header-lead"></div>

                <MudStack Spacing="1" Class="core-dashboard-header-center">
                    <MudText Typo="Typo.h4" Align="Align.Center">Knitting Studio</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">
                        Plan projects, track stitch progress, manage your stash, and keep kits ready for your next cast-on.
                    </MudText>
                </MudStack>

                <div class="core-dashboard-header-trail"></div>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
        }

        <div class="core-dashboard-columns has-sidebar">
            <MudStack Spacing="3" Class="core-dashboard-main">
                <MudPaper Class="pa-4 core-panel-mud core-dashboard-recent-panel core-dashboard-section" Elevation="1">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Recent projects</MudText>

                        @if (featuredRecentWork != null)
                        {
                            <div class="core-dashboard-recent-layout">
                                <MudPaper Class="pa-3 core-dashboard-recent-featured"
                                          Elevation="0"
                                          Outlined="true">
                                    <MudLink Href="@featuredRecentWork.NavigationPath"
                                             Underline="Underline.None"
                                             Class="core-dashboard-recent-link">
                                        <div class="core-dashboard-recent-featured-inner">
                                            <AssetThumbnailImage AssetId="featuredRecentWork.ThumbnailAssetId"
                                                                 FallbackSrc="@GetThumbnailFallback(featuredRecentWork)"
                                                                 AltText="@featuredRecentWork.Title"
                                                                 SizeKey="medium"
                                                                 CssClass="core-dashboard-recent-thumb core-dashboard-recent-thumb-featured"
                                                                 ShowPlaceholder="false" />
                                            <MudStack Spacing="1" Class="core-dashboard-recent-copy">
                                                <MudText Typo="Typo.subtitle1">@featuredRecentWork.Title</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @FormatLastActive(featuredRecentWork.LastAccessedAtUtc)
                                                </MudText>
                                                <MudProgressLinear Value="@GetProgress(featuredRecentWork)"
                                                                   Color="Color.Primary"
                                                                   Rounded="true"
                                                                   Class="knitting-studio-recent-progress" />
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @GetProgress(featuredRecentWork)% complete
                                                </MudText>
                                            </MudStack>
                                        </div>
                                    </MudLink>
                                </MudPaper>

                                @if (sidebarRecentWork.Count > 0)
                                {
                                    <MudStack Spacing="1" Class="core-dashboard-recent-sidebar">
                                        @foreach (var item in sidebarRecentWork)
                                        {
                                            <MudPaper Class="pa-2 core-dashboard-recent-sidebar-item"
                                                      Elevation="0"
                                                      Outlined="true">
                                                <MudLink Href="@item.NavigationPath"
                                                         Underline="Underline.None"
                                                         Class="core-dashboard-recent-link">
                                                    <div class="core-dashboard-recent-sidebar-inner">
                                                        <AssetThumbnailImage AssetId="item.ThumbnailAssetId"
                                                                             FallbackSrc="@GetThumbnailFallback(item)"
                                                                             AltText="@item.Title"
                                                                             SizeKey="small"
                                                                             CssClass="core-dashboard-recent-thumb core-dashboard-recent-thumb-sidebar"
                                                                             ShowPlaceholder="false" />
                                                        <MudStack Spacing="0" Class="core-dashboard-recent-copy">
                                                            <MudText Typo="Typo.body2">@item.Title</MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                @FormatLastActive(item.LastAccessedAtUtc)
                                                            </MudText>
                                                            <MudProgressLinear Value="@GetProgress(item)"
                                                                               Color="Color.Primary"
                                                                               Rounded="true"
                                                                               Size="Size.Small"
                                                                               Class="knitting-studio-recent-progress knitting-studio-recent-progress-sidebar" />
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                @GetProgress(item)%
                                                            </MudText>
                                                        </MudStack>
                                                    </div>
                                                </MudLink>
                                            </MudPaper>
                                        }
                                    </MudStack>
                                }
                            </div>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    No recent projects yet. Open a project to see it here.
                                </MudText>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Href="/modules/knitting/projects">
                                    Browse projects
                                </MudButton>
                            </MudStack>
                        }
                    </MudStack>
                </MudPaper>
            </MudStack>

            @if (overview != null)
            {
                <aside class="core-dashboard-sidebar">
                    <MudPaper Class="pa-4 core-panel-mud core-dashboard-section core-dashboard-engagement-panel" Elevation="1">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Engagement</MudText>
                            <MudText Typo="Typo.body2">@GetEngagementCopy()</MudText>
                            <DashboardActivityCalendar ActiveLocalDates="overview.Activity.ActiveLocalDates" />
                        </MudStack>
                    </MudPaper>
                </aside>
            }
        </div>
    </div>
</KnittingModuleGate>

@code {
    private const string ModuleKey = "knitting";
    private bool loading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.InitializeAsync();
        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
            await LoadDashboardAsync();
        }

        loading = false;
    }

    private async Task LoadDashboardAsync()
    {
        errorMessage = string.Empty;
        featuredRecentWork = null;
        sidebarRecentWork = [];
        overview = null;

        if (!ModuleState.IsActive(ModuleKey))
        {
            return;
        }

        try
        {
            var recentWorkTask = ApiClient.GetRecentWorkAsync(limit: 5, moduleKey: ModuleKey);
            var overviewTask = ApiClient.GetDashboardOverviewAsync(moduleKey: ModuleKey);
            await Task.WhenAll(recentWorkTask, overviewTask);

            var recentWork = await recentWorkTask;
            overview = await overviewTask;
            featuredRecentWork = recentWork.FirstOrDefault();
            sidebarRecentWork = recentWork.Skip(1).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
