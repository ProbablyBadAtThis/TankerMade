@page "/modules/knitting/patterns/{PatternId:guid}"
@using TankerMade.Contracts.DTOs.Assets
@using TankerMade.Contracts.DTOs.ModuleInventory
@using TankerMade.Contracts.DTOs.ModulePatterns
@using TankerMade.Contracts.DTOs.Reference
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession
@inject TankerMade.Client.Services.TankerMadeApiClient ApiClient

<PageTitle>Knitting Pattern</PageTitle>

<KnittingModuleGate Loading="loading" LoadingMessage="Loading pattern...">
    @if (pattern is null)
    {
        <MudStack Spacing="3">
            <KnittingPageHeader Title="Pattern Not Found"
                                BackHref="/modules/knitting/patterns"
                                BackLabel="Patterns" />
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/modules/knitting/patterns">
                Back to Patterns
            </MudButton>
        </MudStack>
    }
    else
    {
        <MudStack Spacing="3" Class="pattern-detail">
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }

            <div class="pattern-header">
                <div class="knitting-hero-card pattern-header-main">
                    <AssetThumbnailImage AssetId="headerAssetId"
                                         AltText="@pattern.Name"
                                         CssClass="asset-thumbnail-image" />
                    <div>
                        <KnittingPageHeader Title="@pattern.Name"
                                            Subtitle="@DisplayMetadata(pattern)"
                                            BackHref="/modules/knitting/patterns"
                                            BackLabel="Patterns" />
                        <div class="pattern-card-stats mt-2">
                            <KnittingDifficultyBadge DifficultyText="@(string.IsNullOrWhiteSpace(pattern.Difficulty) ? "Unspecified" : pattern.Difficulty)" />
                            <span>@(string.IsNullOrWhiteSpace(pattern.ThemeName) ? "No theme" : pattern.ThemeName)</span>
                            <span>@(string.IsNullOrWhiteSpace(pattern.ColorName) ? "No color" : pattern.ColorName)</span>
                            <span>@(string.IsNullOrWhiteSpace(pattern.SourceName) ? "No source" : pattern.SourceName)</span>
                        </div>
                    </div>
                </div>
            <div class="pattern-stats" aria-label="Pattern summary">
                <div>
                    <strong>@pattern.PieceCount</strong>
                    <span>Pieces</span>
                </div>
                <div>
                    <strong>@pattern.StepCount</strong>
                    <span>Steps</span>
                </div>
            </div>
        </div>

        <MudPaper Class="pa-4 knitting-panel-mud mb-3" Elevation="1">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1">Supply Metadata</MudText>
                <EditForm Model="metadataForm" OnValidSubmit="SaveMetadataAsync" class="project-edit-form">
                    <MudStack Spacing="2">
                        <div class="form-grid">
                            <MudSelect T="string" @bind-Value="metadataForm.ThemeIdText" Label="Theme" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@string.Empty">No theme</MudSelectItem>
                                @foreach (var theme in themes)
                                {
                                    <MudSelectItem T="string" Value="@theme.Id.ToString()">@theme.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="metadataForm.ColorIdText" Label="Main color" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@string.Empty">No color</MudSelectItem>
                                @foreach (var color in colors)
                                {
                                    <MudSelectItem T="string" Value="@color.Id.ToString()">@color.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="metadataForm.SourceIdText" Label="Source" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@string.Empty">No source</MudSelectItem>
                                @foreach (var source in sources)
                                {
                                    <MudSelectItem T="string" Value="@source.Id.ToString()">@source.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField @bind-Value="metadataForm.SuggestedYarnWeight" Label="Suggested yarn weight" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="metadataForm.SuggestedNeedleSizes" Label="Suggested needle sizes" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="metadataForm.RequiredNotions" Label="Required notions" Variant="Variant.Outlined" />
                        </div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="busy" ButtonType="ButtonType.Submit">
                            Save Metadata
                        </MudButton>
                    </MudStack>
                </EditForm>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 knitting-panel-mud mb-3" Elevation="1">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1">Pattern Supplies</MudText>
                <div class="form-grid">
                    <MudSelect T="string" @bind-Value="supplyForm.SupplyType" @bind-Value:after="OnSupplyTypeChanged" Label="Supply type" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("yarn")">Yarn</MudSelectItem>
                        <MudSelectItem T="string" Value="@("tool")">Tool</MudSelectItem>
                        <MudSelectItem T="string" Value="@("notion")">Notion</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="Guid?" @bind-Value="selectedSupplyInventoryId" @bind-Value:after="OnSupplyInventoryChanged" Label="Inventory item (optional)" Variant="Variant.Outlined">
                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">Manual name</MudSelectItem>
                        @foreach (var option in supplyInventoryOptions)
                        {
                            <MudSelectItem T="Guid?" Value="@option.Id">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="supplyForm.Name" Label="Name" Variant="Variant.Outlined" />
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="busy" OnClick="AddPatternSupplyAsync">
                    Add Supply
                </MudButton>

                @if (pattern.Supplies.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No supplies listed yet.</MudText>
                }
                else
                {
                    <ul class="project-supply-list mt-3">
                        @foreach (var supply in pattern.Supplies.OrderBy(item => item.SortOrder))
                        {
                            <li>
                                <div>
                                    <strong>@supply.Name</strong>
                                    <span class="text-muted">(@supply.SupplyType)</span>
                                </div>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="busy" OnClick="@(() => DeletePatternSupplyAsync(supply.Id))">
                                    Remove
                                </MudButton>
                            </li>
                        }
                    </ul>
                }
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 knitting-panel-mud mb-3" Elevation="1">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1">Pattern Assets</MudText>
                <InputFile OnChange="UploadPatternAssetAsync" disabled="@busy" />
                @if (patternAssets.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No assets attached yet.</MudText>
                }
                else
                {
                    <ul class="project-supply-list mt-2">
                        @foreach (var asset in patternAssets)
                        {
                            <li>
                                <div>
                                    <strong>@asset.OriginalFileName</strong>
                                    <span>@AssetMeta(asset)</span>
                                </div>
                                @if (asset.RecordId == pattern.Id)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="busy" OnClick="@(() => UnassignPatternAssetAsync(asset.Id))">
                                        Unlink
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Disabled="busy" OnClick="@(() => AssignPatternAssetAsync(asset.Id))">
                                        Attach
                                    </MudButton>
                                }
                            </li>
                        }
                    </ul>
                }
            </MudStack>
        </MudPaper>

        <div class="pattern-workspace">
            <aside class="piece-list" aria-label="Pieces">
                @if (pattern.Pieces.Count > 0 && selectedPiece != null)
                {
                    <p class="muted-copy mb-2">Piece @SelectedPieceIndex of @pattern.Pieces.Count</p>
                }
                <EditForm Model="pieceForm" OnValidSubmit="AddPieceAsync" class="piece-create-form">
                    <DataAnnotationsValidator />
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="pieceForm.Name" Label="New Piece" Variant="Variant.Outlined" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" ButtonType="ButtonType.Submit">
                            Add Piece
                        </MudButton>
                    </MudStack>
                </EditForm>

                @if (pattern.Pieces.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No pieces yet.</MudText>
                }
                else
                {
                    @foreach (var piece in pattern.Pieces)
                    {
                        <div class="piece-row">
                            <button class="piece-button @(selectedPieceId == piece.Id ? "active" : string.Empty)" @onclick="() => SelectPiece(piece.Id)">
                                <span>@piece.Name</span>
                                <small>@piece.StepCount steps</small>
                            </button>
                            <div class="piece-order-actions">
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Disabled="@(busy || IsFirstPiece(piece.Id))" OnClick="@(() => MovePieceAsync(piece.Id, -1))">Up</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Disabled="@(busy || IsLastPiece(piece.Id))" OnClick="@(() => MovePieceAsync(piece.Id, 1))">Down</MudButton>
                            </div>
                        </div>
                    }
                }
            </aside>

            <section class="step-panel" aria-label="Selected piece">
                @if (selectedPiece is null)
                {
                    <p>Select a piece.</p>
                }
                else
                {
                    <div class="step-panel-header">
                        <div>
                            <h2>@selectedPiece.Name</h2>
                            <p>@selectedPiece.StepCount steps</p>
                        </div>
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Disabled="busy" OnClick="StartPieceRename">Rename</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="busy" OnClick="DeletePieceAsync">Delete</MudButton>
                        </MudStack>
                    </div>

                    @if (editingPiece)
                    {
                        <EditForm Model="renamePieceForm" OnValidSubmit="RenamePieceAsync" class="piece-edit-form">
                            <DataAnnotationsValidator />
                            <MudStack Spacing="2">
                                <MudTextField @bind-Value="renamePieceForm.Name" Label="Piece Name" Variant="Variant.Outlined" />
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="busy" ButtonType="ButtonType.Submit">Save</MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Disabled="busy" OnClick="CancelPieceRename">Cancel</MudButton>
                                </MudStack>
                            </MudStack>
                        </EditForm>
                    }

                    <EditForm Model="stepForm" OnValidSubmit="AddStepAsync" class="step-form">
                        <DataAnnotationsValidator />
                        <MudStack Spacing="2">
                            <div class="form-grid">
                                <MudNumericField T="int?" @bind-Value="stepForm.StartIndex" Label="Range Start" Variant="Variant.Outlined" />
                                <MudNumericField T="int?" @bind-Value="stepForm.EndIndex" Label="Range End" Variant="Variant.Outlined" />
                                <MudTextField @bind-Value="stepForm.Label" Label="Label" Variant="Variant.Outlined" />
                                <MudNumericField T="int?" @bind-Value="stepForm.StitchCount" Label="Stitch Count" Variant="Variant.Outlined" />
                            </div>
                            <MudTextField @bind-Value="stepForm.Notes" Label="Notes" Variant="Variant.Outlined" Lines="3" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" ButtonType="ButtonType.Submit">Add Step</MudButton>
                        </MudStack>
                    </EditForm>

                    @if (selectedPiece.Steps.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No steps yet.</MudText>
                    }
                    else
                    {
                        <ol class="step-list">
                            @foreach (var step in selectedPiece.Steps)
                            {
                                <li>
                                    <div class="step-range">@StepRange(step)</div>
                                    <div class="step-content">
                                        <div class="step-title-row">
                                            <h3>@step.Label</h3>
                                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Disabled="@(busy || IsFirstStep(step.Id))" OnClick="@(() => MoveStepAsync(step.Id, -1))">Up</MudButton>
                                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Disabled="@(busy || IsLastStep(step.Id))" OnClick="@(() => MoveStepAsync(step.Id, 1))">Down</MudButton>
                                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Disabled="busy" OnClick="@(() => StartStepEdit(step))">Edit</MudButton>
                                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="busy" OnClick="@(() => DeleteStepAsync(step.Id))">Delete</MudButton>
                                            </MudStack>
                                        </div>
                                        <p>@step.Notes</p>

                                        @if (editingStepId == step.Id)
                                        {
                                            <EditForm Model="editStepForm" OnValidSubmit="SaveStepEditAsync" class="step-form">
                                                <DataAnnotationsValidator />
                                                <MudStack Spacing="2">
                                                    <div class="form-grid">
                                                        <MudNumericField T="int?" @bind-Value="editStepForm.StartIndex" Label="Range Start" Variant="Variant.Outlined" />
                                                        <MudNumericField T="int?" @bind-Value="editStepForm.EndIndex" Label="Range End" Variant="Variant.Outlined" />
                                                        <MudTextField @bind-Value="editStepForm.Label" Label="Label" Variant="Variant.Outlined" />
                                                        <MudNumericField T="int?" @bind-Value="editStepForm.StitchCount" Label="Stitch Count" Variant="Variant.Outlined" />
                                                    </div>
                                                    <MudTextField @bind-Value="editStepForm.Notes" Label="Notes" Variant="Variant.Outlined" Lines="3" />
                                                    <MudStack Row="true" Spacing="1">
                                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="busy" ButtonType="ButtonType.Submit">Save</MudButton>
                                                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Disabled="busy" OnClick="CancelStepEdit">Cancel</MudButton>
                                                    </MudStack>
                                                </MudStack>
                                            </EditForm>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                }
            </section>
        </div>
        </MudStack>
    }
</KnittingModuleGate>

@code {
    [Parameter] public Guid PatternId { get; set; }

    private const string ModuleKey = "knitting";
    private const string PatternRecordType = "pattern";
    private ModulePatternDto? pattern;
    private Guid? headerAssetId;
    private ModulePatternPieceDto? selectedPiece;
    private Guid? selectedPieceId;
    private bool loading = true;
    private bool busy;
    private bool editingPiece;
    private Guid? editingStepId;
    private string errorMessage = string.Empty;

    private PieceFormModel pieceForm = new();
    private PieceFormModel renamePieceForm = new();
    private StepFormModel stepForm = new();
    private StepFormModel editStepForm = new();
    private MetadataFormModel metadataForm = new();
    private readonly List<CoreReferenceItemDto> themes = [];
    private readonly List<CoreReferenceItemDto> colors = [];
    private readonly List<CoreReferenceItemDto> sources = [];
    private int SelectedPieceIndex => pattern == null || selectedPiece == null
        ? 0
        : pattern.Pieces.ToList().FindIndex(piece => piece.Id == selectedPiece.Id) + 1;
    private PatternSupplyFormModel supplyForm = new() { SupplyType = "yarn" };
    private readonly List<InventoryOption> supplyInventoryOptions = [];
    private Guid? selectedSupplyInventoryId;
    private readonly List<AssetRecordDto> patternAssets = [];

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.InitializeAsync();
        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
        }

        await LoadPatternAsync();
    }

    private async Task LoadPatternAsync()
    {
        loading = true;
        errorMessage = string.Empty;

        try
        {
            if (!AuthSession.IsSignedIn || !ModuleState.IsActive(ModuleKey))
            {
                return;
            }

            themes.Clear();
            themes.AddRange(await ApiClient.GetCoreReferenceItemsAsync("themes"));
            colors.Clear();
            colors.AddRange(await ApiClient.GetCoreReferenceItemsAsync("colors"));
            sources.Clear();
            sources.AddRange(await ApiClient.GetCoreReferenceItemsAsync("sources"));
            pattern = await ApiClient.GetModulePatternAsync(ModuleKey, PatternId);
            if (pattern != null)
            {
                metadataForm = new MetadataFormModel
                {
                    ThemeIdText = pattern.ThemeId?.ToString() ?? string.Empty,
                    ColorIdText = pattern.ColorId?.ToString() ?? string.Empty,
                    SourceIdText = pattern.SourceId?.ToString() ?? string.Empty,
                    SuggestedYarnWeight = pattern.SuggestedYarnWeight,
                    SuggestedNeedleSizes = pattern.SuggestedNeedleSizes,
                    RequiredNotions = pattern.RequiredNotions
                };
                selectedPieceId ??= pattern.Pieces.FirstOrDefault()?.Id;
                selectedPiece = pattern.Pieces.FirstOrDefault(piece => piece.Id == selectedPieceId)
                    ?? pattern.Pieces.FirstOrDefault();
                selectedPieceId = selectedPiece?.Id;
                await LoadSupplyInventoryOptionsAsync();
                await LoadPatternAssetsAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task AddPieceAsync()
    {
        if (pattern == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.AddModulePatternPieceAsync(ModuleKey, pattern.Id, new CreateModulePatternPieceRequest
            {
                Name = pieceForm.Name
            });
            pieceForm = new();
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeletePieceAsync()
    {
        if (pattern == null || selectedPiece == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.DeleteModulePatternPieceAsync(ModuleKey, pattern.Id, selectedPiece.Id);
            selectedPieceId = null;
            editingPiece = false;
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void SelectPiece(Guid pieceId)
    {
        if (pattern == null)
        {
            return;
        }

        selectedPieceId = pieceId;
        selectedPiece = pattern.Pieces.FirstOrDefault(piece => piece.Id == pieceId);
        editingPiece = false;
        editingStepId = null;
    }

    private void StartPieceRename()
    {
        if (selectedPiece == null)
        {
            return;
        }

        renamePieceForm = new PieceFormModel { Name = selectedPiece.Name };
        editingPiece = true;
    }

    private async Task RenamePieceAsync()
    {
        if (pattern == null || selectedPiece == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.UpdateModulePatternPieceAsync(
                ModuleKey,
                pattern.Id,
                selectedPiece.Id,
                new UpdateModulePatternPieceRequest { Name = renamePieceForm.Name });
            editingPiece = false;
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void CancelPieceRename() => editingPiece = false;

    private async Task AddStepAsync()
    {
        if (pattern == null || selectedPiece == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.AddModulePatternStepAsync(
                ModuleKey,
                pattern.Id,
                selectedPiece.Id,
                new CreateModulePatternStepRequest
                {
                    StartIndex = stepForm.StartIndex,
                    EndIndex = stepForm.EndIndex,
                    Label = stepForm.Label,
                    StitchCount = stepForm.StitchCount,
                    Notes = stepForm.Notes
                });

            stepForm = new();
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void StartStepEdit(ModulePatternStepDto step)
    {
        editingStepId = step.Id;
        editStepForm = new StepFormModel
        {
            StartIndex = step.StartIndex,
            EndIndex = step.EndIndex,
            Label = step.Label,
            StitchCount = step.StitchCount,
            Notes = step.Notes
        };
    }

    private async Task SaveStepEditAsync()
    {
        if (pattern == null || selectedPiece == null || editingStepId == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.UpdateModulePatternStepAsync(
                ModuleKey,
                pattern.Id,
                selectedPiece.Id,
                editingStepId.Value,
                new UpdateModulePatternStepRequest
                {
                    StartIndex = editStepForm.StartIndex,
                    EndIndex = editStepForm.EndIndex,
                    Label = editStepForm.Label,
                    StitchCount = editStepForm.StitchCount,
                    Notes = editStepForm.Notes
                });

            editingStepId = null;
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void CancelStepEdit() => editingStepId = null;

    private async Task DeleteStepAsync(Guid stepId)
    {
        if (pattern == null || selectedPiece == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.DeleteModulePatternStepAsync(ModuleKey, pattern.Id, selectedPiece.Id, stepId);
            editingStepId = null;
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private bool IsFirstPiece(Guid pieceId)
        => pattern?.Pieces.FirstOrDefault()?.Id == pieceId;

    private bool IsLastPiece(Guid pieceId)
        => pattern?.Pieces.LastOrDefault()?.Id == pieceId;

    private bool IsFirstStep(Guid stepId)
        => selectedPiece?.Steps.FirstOrDefault()?.Id == stepId;

    private bool IsLastStep(Guid stepId)
        => selectedPiece?.Steps.LastOrDefault()?.Id == stepId;

    private async Task MovePieceAsync(Guid pieceId, int direction)
    {
        if (pattern == null)
        {
            return;
        }

        var orderedIds = pattern.Pieces.Select(piece => piece.Id).ToList();
        var index = orderedIds.IndexOf(pieceId);
        if (index < 0)
        {
            return;
        }

        var target = index + direction;
        if (target < 0 || target >= orderedIds.Count)
        {
            return;
        }

        (orderedIds[index], orderedIds[target]) = (orderedIds[target], orderedIds[index]);

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.ReorderModulePatternPiecesAsync(ModuleKey, pattern.Id, orderedIds);
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task MoveStepAsync(Guid stepId, int direction)
    {
        if (pattern == null || selectedPiece == null)
        {
            return;
        }

        var orderedIds = selectedPiece.Steps.Select(step => step.Id).ToList();
        var index = orderedIds.IndexOf(stepId);
        if (index < 0)
        {
            return;
        }

        var target = index + direction;
        if (target < 0 || target >= orderedIds.Count)
        {
            return;
        }

        (orderedIds[index], orderedIds[target]) = (orderedIds[target], orderedIds[index]);

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.ReorderModulePatternStepsAsync(ModuleKey, pattern.Id, selectedPiece.Id, orderedIds);
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

