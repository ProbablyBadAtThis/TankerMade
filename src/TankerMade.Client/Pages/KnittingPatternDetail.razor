    private async Task AssignPatternAssetAsync(Guid assetId)
    {
        if (pattern == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.AssignAssetAsync(assetId, new AssetAssignmentRequest
            {
                ModuleKey = ModuleKey,
                RecordType = PatternRecordType,
                RecordId = pattern.Id
            });
            await LoadPatternAssetsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
