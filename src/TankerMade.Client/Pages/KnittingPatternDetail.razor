@page "/modules/knitting/patterns/{PatternId:guid}"
@using TankerMade.Contracts.DTOs.Assets
@using TankerMade.Contracts.DTOs.ModuleInventory
@using TankerMade.Contracts.DTOs.ModulePatterns
@using TankerMade.Contracts.DTOs.Reference
@inject TankerMade.Client.Services.ClientModuleState ModuleState
@inject TankerMade.Client.Services.AuthSession AuthSession
@inject TankerMade.Client.Services.TankerMadeApiClient ApiClient

<PageTitle>Knitting Pattern</PageTitle>

@if (!AuthSession.IsSignedIn)
{
    <h1>Knitting Pattern</h1>
    <p>Sign in to use this module section.</p>
    <a class="btn btn-primary" href="/login">Sign in</a>
}
else if (!ModuleState.IsActive("knitting"))
{
    <h1>Knitting Pattern</h1>
    <p>Activate Knitting from Home to continue.</p>
    <a class="btn btn-outline-primary" href="/">Go to Home</a>
}
else if (loading)
{
    <h1>Knitting Pattern</h1>
    <p>Loading...</p>
}
else if (pattern is null)
{
    <h1>Pattern Not Found</h1>
    <a class="btn btn-outline-secondary" href="/modules/knitting/patterns">Back to Patterns</a>
}
else
{
    <div class="pattern-detail">
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="pattern-header">
            <div class="knitting-hero-card pattern-header-main">
                <AssetThumbnailImage AssetId="headerAssetId"
                                     AltText="@pattern.Name"
                                     CssClass="asset-thumbnail-image" />
                <div>
                <a class="pattern-back-link" href="/modules/knitting/patterns">Patterns</a>
                <h1>@pattern.Name</h1>
                <p>@DisplayMetadata(pattern)</p>
                <div class="pattern-card-stats mt-2">
                    <span class="@KnittingUi.DifficultyCssClass(pattern.Difficulty)">@(string.IsNullOrWhiteSpace(pattern.Difficulty) ? "Unspecified" : pattern.Difficulty)</span>
                    <span>@(string.IsNullOrWhiteSpace(pattern.ThemeName) ? "No theme" : pattern.ThemeName)</span>
                    <span>@(string.IsNullOrWhiteSpace(pattern.ColorName) ? "No color" : pattern.ColorName)</span>
                    <span>@(string.IsNullOrWhiteSpace(pattern.SourceName) ? "No source" : pattern.SourceName)</span>
                </div>
                </div>
            </div>
            <div class="pattern-stats" aria-label="Pattern summary">
                <div>
                    <strong>@pattern.PieceCount</strong>
                    <span>Pieces</span>
                </div>
                <div>
                    <strong>@pattern.StepCount</strong>
                    <span>Steps</span>
                </div>
            </div>
        </div>

        <section class="project-panel mb-3">
            <h2>Supply Metadata</h2>
            <EditForm Model="metadataForm" OnValidSubmit="SaveMetadataAsync" class="project-edit-form">
                <div class="form-grid">
                    <label>
                        <span>Theme</span>
                        <select class="form-control" @bind="metadataForm.ThemeIdText">
                            <option value="">No theme</option>
                            @foreach (var theme in themes)
                            {
                                <option value="@theme.Id">@theme.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Main color</span>
                        <select class="form-control" @bind="metadataForm.ColorIdText">
                            <option value="">No color</option>
                            @foreach (var color in colors)
                            {
                                <option value="@color.Id">@color.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Source</span>
                        <select class="form-control" @bind="metadataForm.SourceIdText">
                            <option value="">No source</option>
                            @foreach (var source in sources)
                            {
                                <option value="@source.Id">@source.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Suggested yarn weight</span>
                        <InputText class="form-control" @bind-Value="metadataForm.SuggestedYarnWeight" />
                    </label>
                    <label>
                        <span>Suggested needle sizes</span>
                        <InputText class="form-control" @bind-Value="metadataForm.SuggestedNeedleSizes" />
                    </label>
                    <label>
                        <span>Required notions</span>
                        <InputText class="form-control" @bind-Value="metadataForm.RequiredNotions" />
                    </label>
                </div>
                <button class="btn btn-primary btn-sm" disabled="@busy" type="submit">Save Metadata</button>
            </EditForm>
        </section>

        <section class="project-panel mb-3">
            <h2>Pattern Supplies</h2>
            <div class="form-grid">
                <label>
                    <span>Supply type</span>
                    <select class="form-control" @bind="supplyForm.SupplyType" @bind:after="OnSupplyTypeChanged">
                        <option value="yarn">Yarn</option>
                        <option value="tool">Tool</option>
                        <option value="notion">Notion</option>
                    </select>
                </label>
                <label>
                    <span>Inventory item (optional)</span>
                    <select class="form-control" @bind="selectedSupplyInventoryId" @bind:after="OnSupplyInventoryChanged">
                        <option value="">Manual name</option>
                        @foreach (var option in supplyInventoryOptions)
                        {
                            <option value="@option.Id">@option.Label</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Name</span>
                    <InputText class="form-control" @bind-Value="supplyForm.Name" />
                </label>
            </div>
            <button class="btn btn-primary btn-sm" disabled="@busy" @onclick="AddPatternSupplyAsync">Add Supply</button>

            @if (pattern.Supplies.Count == 0)
            {
                <p class="mt-3 mb-0">No supplies listed yet.</p>
            }
            else
            {
                <ul class="project-supply-list mt-3">
                    @foreach (var supply in pattern.Supplies.OrderBy(item => item.SortOrder))
                    {
                        <li>
                            <div>
                                <strong>@supply.Name</strong>
                                <span class="text-muted">(@supply.SupplyType)</span>
                            </div>
                            <button class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => DeletePatternSupplyAsync(supply.Id)">Remove</button>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="project-panel mb-3">
            <h2>Pattern Assets</h2>
            <InputFile OnChange="UploadPatternAssetAsync" disabled="@busy" />
            @if (patternAssets.Count == 0)
            {
                <p class="mt-2 mb-0 muted-copy">No assets attached yet.</p>
            }
            else
            {
                <ul class="project-supply-list mt-2">
                    @foreach (var asset in patternAssets)
                    {
                        <li>
                            <div>
                                <strong>@asset.OriginalFileName</strong>
                                <span>@AssetMeta(asset)</span>
                            </div>
                            @if (asset.RecordId == pattern.Id)
                            {
                                <button class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => UnassignPatternAssetAsync(asset.Id)">Unlink</button>
                            }
                            else
                            {
                                <button class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="() => AssignPatternAssetAsync(asset.Id)">Attach</button>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        <div class="pattern-workspace">
            <aside class="piece-list" aria-label="Pieces">
                @if (pattern.Pieces.Count > 0 && selectedPiece != null)
                {
                    <p class="muted-copy mb-2">Piece @SelectedPieceIndex of @pattern.Pieces.Count</p>
                }
                <EditForm Model="pieceForm" OnValidSubmit="AddPieceAsync" class="piece-create-form">
                    <DataAnnotationsValidator />
                    <label>
                        <span>New Piece</span>
                        <InputText class="form-control" @bind-Value="pieceForm.Name" />
                    </label>
                    <button class="btn btn-primary" disabled="@busy" type="submit">Add Piece</button>
                </EditForm>

                @if (pattern.Pieces.Count == 0)
                {
                    <p class="muted-copy">No pieces yet.</p>
                }
                else
                {
                    @foreach (var piece in pattern.Pieces)
                    {
                        <div class="piece-row">
                            <button class="piece-button @(selectedPieceId == piece.Id ? "active" : string.Empty)" @onclick="() => SelectPiece(piece.Id)">
                                <span>@piece.Name</span>
                                <small>@piece.StepCount steps</small>
                            </button>
                            <div class="piece-order-actions">
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(busy || IsFirstPiece(piece.Id))" @onclick="() => MovePieceAsync(piece.Id, -1)">Up</button>
                                <button class="btn btn-outline-secondary btn-sm" disabled="@(busy || IsLastPiece(piece.Id))" @onclick="() => MovePieceAsync(piece.Id, 1)">Down</button>
                            </div>
                        </div>
                    }
                }
            </aside>

            <section class="step-panel" aria-label="Selected piece">
                @if (selectedPiece is null)
                {
                    <p>Select a piece.</p>
                }
                else
                {
                    <div class="step-panel-header">
                        <div>
                            <h2>@selectedPiece.Name</h2>
                            <p>@selectedPiece.StepCount steps</p>
                        </div>
                        <div class="auth-actions">
                            <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="StartPieceRename">Rename</button>
                            <button class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="DeletePieceAsync">Delete</button>
                        </div>
                    </div>

                    @if (editingPiece)
                    {
                        <EditForm Model="renamePieceForm" OnValidSubmit="RenamePieceAsync" class="piece-edit-form">
                            <DataAnnotationsValidator />
                            <label>
                                <span>Piece Name</span>
                                <InputText class="form-control" @bind-Value="renamePieceForm.Name" />
                            </label>
                            <div class="auth-actions">
                                <button class="btn btn-primary btn-sm" disabled="@busy" type="submit">Save</button>
                                <button class="btn btn-outline-secondary btn-sm" disabled="@busy" type="button" @onclick="CancelPieceRename">Cancel</button>
                            </div>
                        </EditForm>
                    }

                    <EditForm Model="stepForm" OnValidSubmit="AddStepAsync" class="step-form">
                        <DataAnnotationsValidator />
                        <div class="form-grid">
                            <label>
                                <span>Range Start</span>
                                <InputNumber class="form-control" @bind-Value="stepForm.StartIndex" />
                            </label>
                            <label>
                                <span>Range End</span>
                                <InputNumber class="form-control" @bind-Value="stepForm.EndIndex" />
                            </label>
                            <label>
                                <span>Label</span>
                                <InputText class="form-control" @bind-Value="stepForm.Label" />
                            </label>
                            <label>
                                <span>Stitch Count</span>
                                <InputNumber class="form-control" @bind-Value="stepForm.StitchCount" />
                            </label>
                        </div>
                        <label>
                            <span>Notes</span>
                            <InputTextArea class="form-control" @bind-Value="stepForm.Notes" />
                        </label>
                        <button class="btn btn-primary" disabled="@busy" type="submit">Add Step</button>
                    </EditForm>

                    @if (selectedPiece.Steps.Count == 0)
                    {
                        <p class="muted-copy">No steps yet.</p>
                    }
                    else
                    {
                        <ol class="step-list">
                            @foreach (var step in selectedPiece.Steps)
                            {
                                <li>
                                    <div class="step-range">@StepRange(step)</div>
                                    <div class="step-content">
                                        <div class="step-title-row">
                                            <h3>@step.Label</h3>
                                            <div class="auth-actions">
                                                <button class="btn btn-outline-secondary btn-sm" disabled="@(busy || IsFirstStep(step.Id))" @onclick="() => MoveStepAsync(step.Id, -1)">Up</button>
                                                <button class="btn btn-outline-secondary btn-sm" disabled="@(busy || IsLastStep(step.Id))" @onclick="() => MoveStepAsync(step.Id, 1)">Down</button>
                                                <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => StartStepEdit(step)">Edit</button>
                                                <button class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => DeleteStepAsync(step.Id)">Delete</button>
                                            </div>
                                        </div>
                                        <p>@step.Notes</p>

                                        @if (editingStepId == step.Id)
                                        {
                                            <EditForm Model="editStepForm" OnValidSubmit="SaveStepEditAsync" class="step-form">
                                                <DataAnnotationsValidator />
                                                <div class="form-grid">
                                                    <label>
                                                        <span>Range Start</span>
                                                        <InputNumber class="form-control" @bind-Value="editStepForm.StartIndex" />
                                                    </label>
                                                    <label>
                                                        <span>Range End</span>
                                                        <InputNumber class="form-control" @bind-Value="editStepForm.EndIndex" />
                                                    </label>
                                                    <label>
                                                        <span>Label</span>
                                                        <InputText class="form-control" @bind-Value="editStepForm.Label" />
                                                    </label>
                                                    <label>
                                                        <span>Stitch Count</span>
                                                        <InputNumber class="form-control" @bind-Value="editStepForm.StitchCount" />
                                                    </label>
                                                </div>
                                                <label>
                                                    <span>Notes</span>
                                                    <InputTextArea class="form-control" @bind-Value="editStepForm.Notes" />
                                                </label>
                                                <div class="auth-actions">
                                                    <button class="btn btn-primary btn-sm" disabled="@busy" type="submit">Save</button>
                                                    <button class="btn btn-outline-secondary btn-sm" disabled="@busy" type="button" @onclick="CancelStepEdit">Cancel</button>
                                                </div>
                                            </EditForm>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                }
            </section>
        </div>
    </div>
}

@code {
    [Parameter] public Guid PatternId { get; set; }

    private const string ModuleKey = "knitting";
    private const string PatternRecordType = "pattern";
    private ModulePatternDto? pattern;
    private Guid? headerAssetId;
    private ModulePatternPieceDto? selectedPiece;
    private Guid? selectedPieceId;
    private bool loading = true;
    private bool busy;
    private bool editingPiece;
    private Guid? editingStepId;
    private string errorMessage = string.Empty;

    private PieceFormModel pieceForm = new();
    private PieceFormModel renamePieceForm = new();
    private StepFormModel stepForm = new();
    private StepFormModel editStepForm = new();
    private MetadataFormModel metadataForm = new();
    private readonly List<CoreReferenceItemDto> themes = [];
    private readonly List<CoreReferenceItemDto> colors = [];
    private readonly List<CoreReferenceItemDto> sources = [];
    private int SelectedPieceIndex => pattern == null || selectedPiece == null
        ? 0
        : pattern.Pieces.ToList().FindIndex(piece => piece.Id == selectedPiece.Id) + 1;
    private PatternSupplyFormModel supplyForm = new() { SupplyType = "yarn" };
    private readonly List<InventoryOption> supplyInventoryOptions = [];
    private Guid? selectedSupplyInventoryId;
    private readonly List<AssetRecordDto> patternAssets = [];

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.InitializeAsync();
        if (AuthSession.IsSignedIn)
        {
            await ModuleState.RefreshAsync();
        }

        await LoadPatternAsync();
    }

    private async Task LoadPatternAsync()
    {
        loading = true;
        errorMessage = string.Empty;

        try
        {
            if (!AuthSession.IsSignedIn || !ModuleState.IsActive(ModuleKey))
            {
                return;
            }

            themes.Clear();
            themes.AddRange(await ApiClient.GetCoreReferenceItemsAsync("themes"));
            colors.Clear();
            colors.AddRange(await ApiClient.GetCoreReferenceItemsAsync("colors"));
            sources.Clear();
            sources.AddRange(await ApiClient.GetCoreReferenceItemsAsync("sources"));
            pattern = await ApiClient.GetModulePatternAsync(ModuleKey, PatternId);
            if (pattern != null)
            {
                metadataForm = new MetadataFormModel
                {
                    ThemeIdText = pattern.ThemeId?.ToString() ?? string.Empty,
                    ColorIdText = pattern.ColorId?.ToString() ?? string.Empty,
                    SourceIdText = pattern.SourceId?.ToString() ?? string.Empty,
                    SuggestedYarnWeight = pattern.SuggestedYarnWeight,
                    SuggestedNeedleSizes = pattern.SuggestedNeedleSizes,
                    RequiredNotions = pattern.RequiredNotions
                };
                selectedPieceId ??= pattern.Pieces.FirstOrDefault()?.Id;
                selectedPiece = pattern.Pieces.FirstOrDefault(piece => piece.Id == selectedPieceId)
                    ?? pattern.Pieces.FirstOrDefault();
                selectedPieceId = selectedPiece?.Id;
                await LoadSupplyInventoryOptionsAsync();
                await LoadPatternAssetsAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task AddPieceAsync()
    {
        if (pattern == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.AddModulePatternPieceAsync(ModuleKey, pattern.Id, new CreateModulePatternPieceRequest
            {
                Name = pieceForm.Name
            });
            pieceForm = new();
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeletePieceAsync()
    {
        if (pattern == null || selectedPiece == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.DeleteModulePatternPieceAsync(ModuleKey, pattern.Id, selectedPiece.Id);
            selectedPieceId = null;
            editingPiece = false;
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void SelectPiece(Guid pieceId)
    {
        if (pattern == null)
        {
            return;
        }

        selectedPieceId = pieceId;
        selectedPiece = pattern.Pieces.FirstOrDefault(piece => piece.Id == pieceId);
        editingPiece = false;
        editingStepId = null;
    }

    private void StartPieceRename()
    {
        if (selectedPiece == null)
        {
            return;
        }

        renamePieceForm = new PieceFormModel { Name = selectedPiece.Name };
        editingPiece = true;
    }

    private async Task RenamePieceAsync()
    {
        if (pattern == null || selectedPiece == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.UpdateModulePatternPieceAsync(
                ModuleKey,
                pattern.Id,
                selectedPiece.Id,
                new UpdateModulePatternPieceRequest { Name = renamePieceForm.Name });
            editingPiece = false;
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void CancelPieceRename() => editingPiece = false;

    private async Task AddStepAsync()
    {
        if (pattern == null || selectedPiece == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.AddModulePatternStepAsync(
                ModuleKey,
                pattern.Id,
                selectedPiece.Id,
                new CreateModulePatternStepRequest
                {
                    StartIndex = stepForm.StartIndex,
                    EndIndex = stepForm.EndIndex,
                    Label = stepForm.Label,
                    StitchCount = stepForm.StitchCount,
                    Notes = stepForm.Notes
                });

            stepForm = new();
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void StartStepEdit(ModulePatternStepDto step)
    {
        editingStepId = step.Id;
        editStepForm = new StepFormModel
        {
            StartIndex = step.StartIndex,
            EndIndex = step.EndIndex,
            Label = step.Label,
            StitchCount = step.StitchCount,
            Notes = step.Notes
        };
    }

    private async Task SaveStepEditAsync()
    {
        if (pattern == null || selectedPiece == null || editingStepId == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.UpdateModulePatternStepAsync(
                ModuleKey,
                pattern.Id,
                selectedPiece.Id,
                editingStepId.Value,
                new UpdateModulePatternStepRequest
                {
                    StartIndex = editStepForm.StartIndex,
                    EndIndex = editStepForm.EndIndex,
                    Label = editStepForm.Label,
                    StitchCount = editStepForm.StitchCount,
                    Notes = editStepForm.Notes
                });

            editingStepId = null;
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void CancelStepEdit() => editingStepId = null;

    private async Task DeleteStepAsync(Guid stepId)
    {
        if (pattern == null || selectedPiece == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.DeleteModulePatternStepAsync(ModuleKey, pattern.Id, selectedPiece.Id, stepId);
            editingStepId = null;
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private bool IsFirstPiece(Guid pieceId)
        => pattern?.Pieces.FirstOrDefault()?.Id == pieceId;

    private bool IsLastPiece(Guid pieceId)
        => pattern?.Pieces.LastOrDefault()?.Id == pieceId;

    private bool IsFirstStep(Guid stepId)
        => selectedPiece?.Steps.FirstOrDefault()?.Id == stepId;

    private bool IsLastStep(Guid stepId)
        => selectedPiece?.Steps.LastOrDefault()?.Id == stepId;

    private async Task MovePieceAsync(Guid pieceId, int direction)
    {
        if (pattern == null)
        {
            return;
        }

        var orderedIds = pattern.Pieces.Select(piece => piece.Id).ToList();
        var index = orderedIds.IndexOf(pieceId);
        if (index < 0)
        {
            return;
        }

        var target = index + direction;
        if (target < 0 || target >= orderedIds.Count)
        {
            return;
        }

        (orderedIds[index], orderedIds[target]) = (orderedIds[target], orderedIds[index]);

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.ReorderModulePatternPiecesAsync(ModuleKey, pattern.Id, orderedIds);
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task MoveStepAsync(Guid stepId, int direction)
    {
        if (pattern == null || selectedPiece == null)
        {
            return;
        }

        var orderedIds = selectedPiece.Steps.Select(step => step.Id).ToList();
        var index = orderedIds.IndexOf(stepId);
        if (index < 0)
        {
            return;
        }

        var target = index + direction;
        if (target < 0 || target >= orderedIds.Count)
        {
            return;
        }

        (orderedIds[index], orderedIds[target]) = (orderedIds[target], orderedIds[index]);

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.ReorderModulePatternStepsAsync(ModuleKey, pattern.Id, selectedPiece.Id, orderedIds);
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SaveMetadataAsync()
    {
        if (pattern == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.UpdateModulePatternAsync(ModuleKey, pattern.Id, new UpdateModulePatternRequest
            {
                ThemeId = ParseOptionalGuid(metadataForm.ThemeIdText),
                ColorId = ParseOptionalGuid(metadataForm.ColorIdText),
                SourceId = ParseOptionalGuid(metadataForm.SourceIdText),
                SuggestedYarnWeight = metadataForm.SuggestedYarnWeight,
                SuggestedNeedleSizes = metadataForm.SuggestedNeedleSizes,
                RequiredNotions = metadataForm.RequiredNotions
            });
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task AddPatternSupplyAsync()
    {
        if (pattern == null || string.IsNullOrWhiteSpace(supplyForm.Name))
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.AddModulePatternSupplyAsync(ModuleKey, pattern.Id, new CreateModulePatternSupplyRequest
            {
                SupplyType = supplyForm.SupplyType,
                Name = supplyForm.Name.Trim(),
                InventoryItemId = selectedSupplyInventoryId
            });
            var supplyType = supplyForm.SupplyType;
            supplyForm = new PatternSupplyFormModel { SupplyType = supplyType };
            selectedSupplyInventoryId = null;
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeletePatternSupplyAsync(Guid supplyId)
    {
        if (pattern == null)
        {
            return;
        }

        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.DeleteModulePatternSupplyAsync(ModuleKey, pattern.Id, supplyId);
            await LoadPatternAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnSupplyTypeChanged()
    {
        selectedSupplyInventoryId = null;
        await LoadSupplyInventoryOptionsAsync();
    }

    private void OnSupplyInventoryChanged()
    {
        if (!selectedSupplyInventoryId.HasValue)
        {
            return;
        }

        var selected = supplyInventoryOptions.FirstOrDefault(option => option.Id == selectedSupplyInventoryId.Value);
        if (selected != null)
        {
            supplyForm.Name = selected.Label;
        }
    }

    private async Task LoadSupplyInventoryOptionsAsync()
    {
        supplyInventoryOptions.Clear();

        switch (supplyForm.SupplyType)
        {
            case "tool":
                foreach (var tool in await ApiClient.GetModuleToolsAsync(ModuleKey))
                {
                    supplyInventoryOptions.Add(new InventoryOption(tool.Id, $"{tool.BrandName} - {tool.TypeName}"));
                }

                break;
            case "notion":
                foreach (var notion in await ApiClient.GetModuleNotionsAsync(ModuleKey))
                {
                    supplyInventoryOptions.Add(new InventoryOption(notion.Id, $"{notion.BrandName} - {notion.TypeName}"));
                }

                break;
            default:
                foreach (var yarn in await ApiClient.GetModuleYarnsAsync(ModuleKey))
                {
                    supplyInventoryOptions.Add(new InventoryOption(yarn.Id, $"{yarn.BrandName} - {yarn.ColorName}"));
                }

                break;
        }
    }

    private async Task LoadPatternAssetsAsync()
    {
        patternAssets.Clear();
        headerAssetId = null;
        if (pattern == null)
        {
            return;
        }

        patternAssets.AddRange(await ApiClient.GetAssetsForPickerAsync(
            ModuleKey,
            PatternRecordType,
            pattern.Id,
            includeUnassigned: true));
        headerAssetId = patternAssets.FirstOrDefault()?.Id;
    }

    private async Task UploadPatternAssetAsync(InputFileChangeEventArgs args)
    {
        busy = true;
        errorMessage = string.Empty;

        try
        {
            await ApiClient.UploadAssetAsync(ModuleKey, args.File);
            await LoadPatternAssetsAsync();
