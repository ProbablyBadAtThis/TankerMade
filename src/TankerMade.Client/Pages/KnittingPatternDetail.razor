    private async Task OnSupplyTypeChanged()
    {
        selectedSupplyInventoryId = null;
        await LoadSupplyInventoryOptionsAsync();
    }

    private void OnSupplyInventoryChanged()
    {
        if (!selectedSupplyInventoryId.HasValue)
        {
            return;
        }

        var selected = supplyInventoryOptions.FirstOrDefault(option => option.Id == selectedSupplyInventoryId.Value);
        if (selected != null)
        {
            supplyForm.Name = selected.Label;
        }
    }

    private async Task LoadSupplyInventoryOptionsAsync()
    {
        supplyInventoryOptions.Clear();

        switch (supplyForm.SupplyType)
        {
            case "tool":
                foreach (var tool in await ApiClient.GetModuleToolsAsync(ModuleKey))
                {
                    supplyInventoryOptions.Add(new InventoryOption(tool.Id, $"{tool.BrandName} - {tool.TypeName}"));
                }

                break;
            case "notion":
                foreach (var notion in await ApiClient.GetModuleNotionsAsync(ModuleKey))
                {
                    supplyInventoryOptions.Add(new InventoryOption(notion.Id, $"{notion.BrandName} - {notion.TypeName}"));
                }

                break;
            default:
                foreach (var yarn in await ApiClient.GetModuleYarnsAsync(ModuleKey))
                {
                    supplyInventoryOptions.Add(new InventoryOption(yarn.Id, $"{yarn.BrandName} - {yarn.ColorName}"));
                }

                break;
        }
    }

    private async Task LoadPatternAssetsAsync()
    {
        patternAssets.Clear();
        headerAssetId = null;
        if (pattern == null)
        {
            return;
        }

        patternAssets.AddRange(await ApiClient.GetAssetsForPickerAsync(
            ModuleKey,
            PatternRecordType,
            pattern.Id,
            includeUnassigned: true));
        headerAssetId = patternAssets.FirstOrDefault()?.Id;
    }

