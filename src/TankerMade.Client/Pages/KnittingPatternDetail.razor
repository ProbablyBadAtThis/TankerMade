    private static string AssetMeta(AssetRecordDto asset)
    {
        var size = asset.FileSizeBytes > 0 ? $"{asset.FileSizeBytes / 1024} KB" : "unknown size";
        return $"{asset.ContentType} - {size}";
    }

    private static string DisplayMetadata(ModulePatternDto value)
    {
        var parts = new[] { value.Type, value.Form, value.Difficulty, value.SuggestedYarnWeight }
            .Where(part => !string.IsNullOrWhiteSpace(part));

        return string.Join(" - ", parts);
    }

    private static string StepRange(ModulePatternStepDto step)
    {
        if (step.StartIndex == null && step.EndIndex == null)
        {
            return "-";
        }

        if (step.StartIndex == step.EndIndex || step.EndIndex == null)
        {
            return step.StartIndex?.ToString() ?? step.EndIndex?.ToString() ?? "-";
        }

        if (step.StartIndex == null)
        {
            return step.EndIndex?.ToString() ?? "-";
        }

        return $"{step.StartIndex}-{step.EndIndex}";
    }

