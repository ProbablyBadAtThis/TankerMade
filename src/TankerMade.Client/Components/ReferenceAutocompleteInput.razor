<MudAutocomplete T="string"
                 Label="@Label"
                 Placeholder="@Placeholder"
                 Text="@Value"
                 TextChanged="OnTextChanged"
                 SearchFunc="SearchAsync"
                 Variant="Variant.Outlined"
                 Disabled="@Disabled"
                 Strict="false"
                 CoerceText="true"
                 ResetValueOnEmptyText="true"
                 MaxItems="12" />

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<string> Options { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }

    private Task OnTextChanged(string value)
    {
        Value = value ?? string.Empty;
        return ValueChanged.InvokeAsync(Value);
    }

    private Task<IEnumerable<string>> SearchAsync(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult(Options.AsEnumerable());
        }

        return Task.FromResult(Options.Where(option =>
            option.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }
}
